{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "yourdomain.com",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=YOUR_SERVER;initial catalog=YOUR_DATABASE;persist security info=true;user id=YOUR_USER;password=YOUR_PASSWORD;multipleactiveresultsets=true;Encrypt=true;TrustServerCertificate=false"
  },
  "EmailSettings": {
    "SmtpServer": "smtp.yourdomain.com",
    "SmtpPort": 587,
    "SmtpUsername": "noreply@yourdomain.com",
    "SmtpPassword": "YOUR_EMAIL_PASSWORD",
    "EnableSsl": true,
    "FromEmail": "noreply@yourdomain.com",
    "FromName": "Bidding System"
  },
  "Security": {
    "PasswordRequirements": {
      "RequiredLength": 12,
      "RequireUppercase": true,
      "RequireLowercase": true,
      "RequireDigit": true,
      "RequireNonAlphanumeric": true
    },
    "Lockout": {
      "DefaultLockoutTimeSpan": "00:15:00",
      "MaxFailedAccessAttempts": 3,
      "AllowedForNewUsers": true
    },
    "RateLimiting": {
      "MaxRequestsPerMinute": 60,
      "MaxLoginAttemptsPerMinute": 5,
      "MaxFileUploadsPerHour": 10
    }
  }
}
