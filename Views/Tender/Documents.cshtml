@model BiddingSystem.ViewModels.TenderDocumentViewModel
@using BiddingSystem.Models
@{
    ViewData["Title"] = "Tender Documents";
    var tender = ViewBag.Tender as Tender;
    var documents = ViewBag.Documents as List<TenderDocument>;
    var documentTypes = ViewBag.DocumentTypes as List<SelectListItem>;
}

<div class="flex justify-between items-center mb-6">
    <div>
        <h1 class="text-2xl font-bold text-gray-800">Tender Documents</h1>
        <p class="text-gray-600 mt-1">Manage documents for tender: <span class="font-medium">@tender?.TenderId</span></p>
        <p class="text-sm text-gray-500">@tender?.TenderTitle</p>
    </div>
    <a asp-action="Details" asp-route-id="@tender?.Id" class="bg-gray-500 text-white px-4 py-2 rounded-lg hover:bg-gray-600 transition-colors flex items-center">
        <i class="ri-arrow-left-line mr-2"></i>
        Back to Tender
    </a>
</div>

<!-- Upload New Document Form -->
<div class="bg-white rounded-lg shadow p-6 mb-6">
    <h2 class="text-lg font-semibold text-gray-800 mb-4">Upload New Document</h2>
    
    <form asp-action="UploadDocument" method="post" enctype="multipart/form-data" class="space-y-4">
        <input type="hidden" asp-for="TenderId" value="@tender?.Id" />
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label asp-for="DocumentName" class="block text-sm font-medium text-gray-700 mb-2">
                    Document Name <span class="text-red-500">*</span>
                </label>
                <input asp-for="DocumentName" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary" placeholder="Enter document name" />
                <span asp-validation-for="DocumentName" class="text-red-500 text-sm"></span>
            </div>
            
            <div>
                <label asp-for="DocumentType" class="block text-sm font-medium text-gray-700 mb-2">
                    Document Type <span class="text-red-500">*</span>
                </label>
                <select asp-for="DocumentType" asp-items="documentTypes" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary">
                    <option value="">Select document type</option>
                </select>
                <span asp-validation-for="DocumentType" class="text-red-500 text-sm"></span>
            </div>
        </div>
        
        <div>
            <label asp-for="File" class="block text-sm font-medium text-gray-700 mb-2">
                File <span class="text-red-500">*</span>
            </label>
            <input asp-for="File" type="file" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary" accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.jpg,.jpeg,.png,.gif,.bmp" />
            <span asp-validation-for="File" class="text-red-500 text-sm"></span>
            <p class="text-sm text-gray-500 mt-1">Supported formats: PDF, DOC, DOCX, XLS, XLSX, PPT, PPTX, JPG, JPEG, PNG, GIF, BMP (Max 10MB)</p>
        </div>
        
        <div class="flex items-center">
            <input asp-for="IsRequired" type="checkbox" class="h-4 w-4 text-primary focus:ring-primary border-gray-300 rounded" />
            <label asp-for="IsRequired" class="ml-2 block text-sm text-gray-700">
                This document is required for bidding
            </label>
        </div>
        
        <div class="flex justify-end">
            <button type="submit" class="bg-primary text-white px-6 py-2 rounded-lg hover:bg-primary/90 transition-colors flex items-center">
                <i class="ri-upload-line mr-2"></i>
                Upload Document
            </button>
        </div>
    </form>
</div>

<!-- Existing Documents -->
<div class="bg-white rounded-lg shadow overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-200">
        <h2 class="text-lg font-semibold text-gray-800">Existing Documents (@documents?.Count)</h2>
    </div>
    
    @if (documents?.Any() == true)
    {
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Document</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Size</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Uploaded</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    @foreach (var document in documents)
                    {
                        <tr class="hover:bg-gray-50">
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="flex items-center">
                                    <div class="flex-shrink-0 h-10 w-10">
                                        @if (document.IsPdf)
                                        {
                                            <div class="h-10 w-10 bg-red-100 rounded-lg flex items-center justify-center">
                                                <i class="ri-file-pdf-line text-red-600 text-xl"></i>
                                            </div>
                                        }
                                        else if (document.IsImage)
                                        {
                                            <div class="h-10 w-10 bg-green-100 rounded-lg flex items-center justify-center">
                                                <i class="ri-image-line text-green-600 text-xl"></i>
                                            </div>
                                        }
                                        else if (document.IsDocument)
                                        {
                                            <div class="h-10 w-10 bg-blue-100 rounded-lg flex items-center justify-center">
                                                <i class="ri-file-text-line text-blue-600 text-xl"></i>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="h-10 w-10 bg-gray-100 rounded-lg flex items-center justify-center">
                                                <i class="ri-file-line text-gray-600 text-xl"></i>
                                            </div>
                                        }
                                    </div>
                                    <div class="ml-4">
                                        <div class="text-sm font-medium text-gray-900">@document.DocumentName</div>
                                        <div class="text-sm text-gray-500">@document.FileName</div>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                    @document.DocumentTypeDisplayName
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                @document.FileSizeDisplay
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                <div>@document.UploadedAt.ToString("dd MMM yyyy")</div>
                                <div class="text-xs text-gray-500">by @document.UploadedByUser?.Username</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                @if (document.IsRequired)
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                        <i class="ri-star-fill mr-1"></i>
                                        Required
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                                        Optional
                                    </span>
                                }
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                <div class="flex space-x-2">
                                    <a href="/uploads/tenders/@document.FileName" target="_blank" 
                                       class="text-primary hover:text-primary/80" title="Download">
                                        <i class="ri-download-line"></i>
                                    </a>
                                    
                                    <a href="/uploads/tenders/@document.FileName" target="_blank" 
                                       class="text-blue-600 hover:text-blue-800" title="View">
                                        <i class="ri-eye-line"></i>
                                    </a>
                                    
                                    <form asp-action="DeleteDocument" method="post" class="inline" 
                                          onsubmit="return confirm('Are you sure you want to delete this document?')">
                                        <input type="hidden" name="id" value="@document.Id" />
                                        <input type="hidden" name="tenderId" value="@document.TenderId" />
                                        <button type="submit" class="text-red-600 hover:text-red-800" title="Delete">
                                            <i class="ri-delete-bin-line"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="px-6 py-12 text-center">
            <div class="text-gray-500">
                <i class="ri-file-list-line text-4xl mb-4"></i>
                <p class="text-lg font-medium">No documents uploaded</p>
                <p class="text-sm">Upload your first document to get started</p>
            </div>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
