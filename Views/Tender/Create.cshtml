@model BiddingSystem.ViewModels.TenderViewModel
@{
    ViewData["Title"] = "Add New Tender";
}

<div class="flex justify-between items-center mb-6">
    <div>
        <h1 class="text-2xl font-bold text-gray-800">Add New Tender</h1>
        <p class="text-gray-600 mt-1">Create a new tender for bidding</p>
    </div>
    <a asp-action="Index" class="bg-gray-500 text-white px-4 py-2 rounded-lg hover:bg-gray-600 transition-colors flex items-center">
        <i class="ri-arrow-left-line mr-2"></i>
        Back to List
    </a>
</div>

@if (User.IsInRole("Admin") || User.IsInRole("Maker"))
{
<form asp-action="Create" method="post" class="space-y-8">
    @Html.AntiForgeryToken()
    <div class="bg-white rounded-lg shadow p-8">
        <div class="flex items-center mb-8">
            <div class="w-12 h-12 flex items-center justify-center rounded-full bg-blue-100 text-primary mr-5">
                <i class="ri-file-info-line text-xl"></i>
            </div>
            <div>
                <h2 class="text-xl font-semibold text-gray-800">Tender Details</h2>
                <p class="text-sm text-gray-500 mt-1">Enter the details of the tender</p>
            </div>
        </div>
        <div class="mb-6" style="display:none;">
            <div asp-validation-summary="All" class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded" role="alert"></div>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
@* 
            <div asp-validation-summary="All" class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-6" role="alert"></div>
          *@   <div>
                <label asp-for="TenderId" class="block text-sm font-medium text-gray-700 mb-2">
                    Tender ID <span class="text-red-500">*</span>
                </label>
                <input asp-for="TenderId" type="text" 
                       placeholder="Enter tender ID" 
                       class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-base">
                <span asp-validation-for="TenderId" class="text-red-500 text-sm"></span>
            </div>
            
            <div>
                <label asp-for="TenderTitle" class="block text-sm font-medium text-gray-700 mb-2">
                    Tender Title <span class="text-red-500">*</span>
                </label>
                <input asp-for="TenderTitle" type="text" 
                       placeholder="Enter tender title" 
                       class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-base">
                <span asp-validation-for="TenderTitle" class="text-red-500 text-sm"></span>
            </div>
            
            <div class="md:col-span-2">
                <label asp-for="Description" class="block text-sm font-medium text-gray-700 mb-2">
                    Description <span class="text-red-500">*</span>
                </label>
                <textarea asp-for="Description" maxlength="1000" rows="4" 
                          placeholder="Enter tender details (maximum 1000 characters)" 
                          class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-base"></textarea>
                <span asp-validation-for="Description" class="text-red-500 text-sm"></span>
                <div class="text-sm text-gray-500 mt-1">
                    <span id="descriptionCount">0</span>/1000 characters
                </div>
            </div>
            
            <div>
                <label asp-for="Department" class="block text-sm font-medium text-gray-700 mb-2">
                    Department <span class="text-red-500">*</span>
                </label>
                <select asp-for="Department" asp-items="@ViewBag.Departments" 
                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-base">
                    <option value="">Select Department</option>
                </select>
                <span asp-validation-for="Department" class="text-red-500 text-sm"></span>
            </div>
            
            <div>
                <label asp-for="PublishDate" class="block text-sm font-medium text-gray-700 mb-2">
                    Tender Publish Date <span class="text-red-500">*</span>
                </label>
                <input asp-for="PublishDate" type="date" required
                       class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-base">
                <span asp-validation-for="PublishDate" class="text-red-500 text-sm"></span>
            </div>
            
            <div>
                <label asp-for="EmdAmount" class="block text-sm font-medium text-gray-700 mb-2">
                    EMD Amount <span class="text-red-500">*</span>
                </label>
                <input asp-for="EmdAmount" type="number" step="0.01" min="0.01" required
                       placeholder="Enter EMD amount" 
                       class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-base">
                <span asp-validation-for="EmdAmount" class="text-red-500 text-sm"></span>
            </div>
            
            <div>
                <label asp-for="SdAmount" class="block text-sm font-medium text-gray-700 mb-2">
                    SD Amount <span class="text-red-500">*</span>
                </label>
                <input asp-for="SdAmount" type="number" step="0.01" min="0.01" required
                       placeholder="Enter SD amount" 
                       class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-base">
                <span asp-validation-for="SdAmount" class="text-red-500 text-sm"></span>
            </div>
            
            <div>
                <label asp-for="ProcessingFee" class="block text-sm font-medium text-gray-700 mb-2">
                    Processing Fee <span class="text-red-500">*</span>
                </label>
                <input asp-for="ProcessingFee" type="number" step="0.01" min="0.01" required
                       placeholder="Enter processing fee" 
                       class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-base">
                <span asp-validation-for="ProcessingFee" class="text-red-500 text-sm"></span>
            </div>
            
            <div>
                <label asp-for="EstimatedValue" class="block text-sm font-medium text-gray-700 mb-2">
                    Estimated Value <span class="text-red-500">*</span>
                </label>
                <input asp-for="EstimatedValue" type="number" step="0.01" min="0.01" required
                       placeholder="Enter estimated value" 
                       class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-base">
                <span asp-validation-for="EstimatedValue" class="text-red-500 text-sm"></span>
            </div>
            
            <div>
                <label asp-for="LastDateEmd" class="block text-sm font-medium text-gray-700 mb-2">
                    Last Date to Pay EMD <span class="text-red-500">*</span>
                </label>
                <input asp-for="LastDateEmd" type="date" required
                       class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-base">
                <span asp-validation-for="LastDateEmd" class="text-red-500 text-sm"></span>
            </div>
            
            <div>
                <label asp-for="TenderClosingDate" class="block text-sm font-medium text-gray-700 mb-2">
                    Tender Closing Date
                </label>
                <input asp-for="TenderClosingDate" type="date" 
                       class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-base">
                <span asp-validation-for="TenderClosingDate" class="text-red-500 text-sm"></span>
            </div>
            
            <div>
                <label asp-for="TenderOpeningDate" class="block text-sm font-medium text-gray-700 mb-2">
                    Tender Opening Date
                </label>
                <input asp-for="TenderOpeningDate" type="date" 
                       class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-base">
                <span asp-validation-for="TenderOpeningDate" class="text-red-500 text-sm"></span>
            </div>
        </div>
        
        <div class="flex justify-end gap-4 mt-8">
            <a asp-action="Index" class="px-6 py-3 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors">
                Cancel
            </a>
            <button type="submit" id="saveButton" class="px-6 py-3 bg-primary text-white rounded-lg hover:bg-primary/90 transition-colors">
                <i class="ri-save-line mr-2"></i>Save Tender
            </button>
        </div>
    </div>
</form>
}
else
{
    <div class="bg-red-50 border border-red-200 rounded-lg p-6 text-center">
        <div class="w-16 h-16 mx-auto mb-4 flex items-center justify-center rounded-full bg-red-100 text-red-600">
            <i class="ri-error-warning-line text-2xl"></i>
        </div>
        <h3 class="text-lg font-semibold text-red-800 mb-2">Access Denied</h3>
        <p class="text-red-600 mb-4">You don't have permission to create tenders. Only Admin and Maker roles can create new tenders.</p>
        <a asp-action="Index" class="bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700 transition-colors">
            <i class="ri-arrow-left-line mr-2"></i>Back to Tender List
        </a>
    </div>
}

<!-- Information Footer -->
<div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mt-6">
    <div class="flex items-start">
        <div class="w-5 h-5 flex items-center justify-center rounded-full bg-blue-100 text-blue-600 mr-3 mt-0.5">
            <i class="ri-information-line text-sm"></i>
        </div>
        <div>
            <h4 class="text-sm font-medium text-blue-800 mb-1">Important Information</h4>
            <ul class="text-sm text-blue-700 space-y-1">
                <li>• All fields marked with <span class="text-red-500">*</span> are required</li>
                <li>• Tender ID must be unique across the system</li>
                <li>• Last date to pay EMD must be after the publish date</li>
                <li>• Tender will be saved as draft and can be published later</li>
                <li>• You can upload documents after creating the tender</li>
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    
    
    <!-- Enhanced Validation Styles -->
    <style>
        .field-validation-error {
            display: block;
            margin-top: 4px;
            font-size: 0.875rem;
            color: #dc2626;
        }
        
        .border-red-500 {
            border-color: #dc2626 !important;
            box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.1);
        }
        
        .border-gray-300 {
            border-color: #d1d5db;
        }
        
        .validation-summary-errors,
        .form-validation-error {
            background-color: #fef2f2;
            border: 1px solid #fecaca;
            color: #dc2626;
            padding: 12px 16px;
            border-radius: 8px;
            margin-bottom: 24px;
        }
        
        .validation-summary-errors ul,
        .form-validation-error ul {
            margin: 0;
            padding-left: 20px;
        }
        
        .validation-summary-errors li,
        .form-validation-error li {
            margin-bottom: 4px;
        }
        
        /* Loading animation */
        @@keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
        
        .animate-spin {
            animation: spin 1s linear infinite;
        }
        
        /* Button transitions */
        button {
            transition: all 0.3s ease;
        }
        
        /* Success state */
        .bg-green-500 {
            background-color: #10b981;
        }
        
        .hover\:bg-green-600:hover {
            background-color: #059669;
        }
        
        /* Field focus improvements */
        .border-red-500:focus {
            outline: none;
            border-color: #dc2626;
            box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.1);
        }
    </style>
    
    <script>
        // Enhanced Save Tender Validation Script
        document.addEventListener('DOMContentLoaded', function() {
            // Configuration
            const requiredFields = [
                'TenderId', 'TenderTitle', 'Description', 'Department', 
                'PublishDate', 'EmdAmount', 'SdAmount', 'ProcessingFee', 
                'EstimatedValue', 'LastDateEmd'
            ];
            
            const saveButton = document.getElementById('saveButton');
            const form = document.querySelector('form[action*="Create"]');
            
            // Enhanced Save Button Click Handler
            if (saveButton) {
                saveButton.addEventListener('click', function(e) {
                    e.preventDefault(); // Prevent default form submission
                    
                    // Clear any existing form-level errors
                    clearFormErrors();
                    
                    // Show loading state
                    showLoadingState();
                    
                    // Small delay for better UX
                    setTimeout(() => {
                        // Perform comprehensive validation
                        const validationResult = performComprehensiveValidation();
                        
                        if (validationResult.isValid) {
                            // All validation passed - submit the form
                            showSuccessState();
                            setTimeout(() => {
                                form.submit();
                            }, 500);
                        } else {
                            // Validation failed - show errors
                            showErrorState(validationResult.errors);
                            focusFirstErrorField();
                        }
                    }, 300);
                });
            }
            
            // Comprehensive Validation Function
            function performComprehensiveValidation() {
                let isValid = true;
                let errors = [];
                let firstErrorField = null;
                
                // 1. Required Field Validation
                requiredFields.forEach(function(fieldId) {
                    const field = document.getElementById(fieldId);
                    if (field) {
                        const fieldResult = validateRequiredField(field);
                        if (!fieldResult.isValid) {
                            isValid = false;
                            errors.push(fieldResult.error);
                            if (!firstErrorField) {
                                firstErrorField = field;
                            }
                        }
                    }
                });
                
                // 2. Business Logic Validation
                const businessValidation = validateBusinessRules();
                if (!businessValidation.isValid) {
                    isValid = false;
                    errors = errors.concat(businessValidation.errors);
                }
                
                // 3. Data Type Validation
                const dataValidation = validateDataTypes();
                if (!dataValidation.isValid) {
                    isValid = false;
                    errors = errors.concat(dataValidation.errors);
                }
                
                return {
                    isValid: isValid,
                    errors: errors,
                    firstErrorField: firstErrorField
                };
            }
            
            // Required Field Validation
            function validateRequiredField(field) {
                const value = field.value.trim();
                const fieldName = getFieldDisplayName(field.getAttribute('name'));
                
                if (!value) {
                    showFieldError(field, `${fieldName} is required`);
                    return {
                        isValid: false,
                        error: `${fieldName} is required`
                    };
                } else {
                    clearFieldError(field);
                    return {
                        isValid: true,
                        error: null
                    };
                }
            }
            
            // Business Rules Validation
            function validateBusinessRules() {
                let errors = [];
                
                // Date validation: Last Date EMD must be after Publish Date
                const publishDate = document.getElementById('PublishDate').value;
                const lastDateEmd = document.getElementById('LastDateEmd').value;
                
                if (publishDate && lastDateEmd) {
                    const pubDate = new Date(publishDate);
                    const emdDate = new Date(lastDateEmd);
                    
                    if (emdDate <= pubDate) {
                        errors.push('Last date to pay EMD must be after the publish date');
                        showFieldError(document.getElementById('LastDateEmd'), 'Must be after publish date');
                    }
                }
                
                // Tender Closing Date validation (if provided)
                const tenderClosingDate = document.getElementById('TenderClosingDate').value;
                if (tenderClosingDate && lastDateEmd) {
                    const closingDate = new Date(tenderClosingDate);
                    const emdDate = new Date(lastDateEmd);
                    
                    if (closingDate <= emdDate) {
                        errors.push('Tender closing date should be after EMD payment deadline');
                        showFieldError(document.getElementById('TenderClosingDate'), 'Should be after EMD deadline');
                    }
                }
                
                // Tender Opening Date validation (if provided)
                const tenderOpeningDate = document.getElementById('TenderOpeningDate').value;
                if (tenderOpeningDate && tenderClosingDate) {
                    const openingDate = new Date(tenderOpeningDate);
                    const closingDate = new Date(tenderClosingDate);
                    
                    if (openingDate <= closingDate) {
                        errors.push('Tender opening date should be after closing date');
                        showFieldError(document.getElementById('TenderOpeningDate'), 'Should be after closing date');
                    }
                }
                
                return {
                    isValid: errors.length === 0,
                    errors: errors
                };
            }
            
            // Data Types Validation
            function validateDataTypes() {
                let errors = [];
                
                // Number field validation
                const numberFields = ['EmdAmount', 'SdAmount', 'ProcessingFee', 'EstimatedValue'];
                
                numberFields.forEach(function(fieldId) {
                    const field = document.getElementById(fieldId);
                    if (field && field.value.trim()) {
                        const value = parseFloat(field.value);
                        const fieldName = getFieldDisplayName(fieldId);
                        
                        if (isNaN(value) || value <= 0) {
                            errors.push(`${fieldName} must be a valid number greater than 0`);
                            showFieldError(field, 'Must be greater than 0');
                        } else {
                            clearFieldError(field);
                        }
                    }
                });
                
                // Description length validation
                const description = document.getElementById('Description');
                if (description && description.value.length > 1000) {
                    errors.push('Description cannot exceed 1000 characters');
                    showFieldError(description, 'Maximum 1000 characters allowed');
                }
                
                return {
                    isValid: errors.length === 0,
                    errors: errors
                };
            }
            
            // Helper Functions
            function getFieldDisplayName(fieldName) {
                const displayNames = {
                    'TenderId': 'Tender ID',
                    'TenderTitle': 'Tender Title',
                    'Description': 'Description',
                    'Department': 'Department',
                    'PublishDate': 'Publish Date',
                    'EmdAmount': 'EMD Amount',
                    'SdAmount': 'SD Amount',
                    'ProcessingFee': 'Processing Fee',
                    'EstimatedValue': 'Estimated Value',
                    'LastDateEmd': 'Last Date to Pay EMD',
                    'TenderClosingDate': 'Tender Closing Date',
                    'TenderOpeningDate': 'Tender Opening Date'
                };
                return displayNames[fieldName] || fieldName;
            }
            
            function showFieldError(field, message) {
                // Remove existing error
                clearFieldError(field);
                
                // Add error styling
                field.classList.remove('border-gray-300');
                field.classList.add('border-red-500');
                
                // Create error message
                const errorSpan = document.createElement('span');
                errorSpan.className = 'field-validation-error text-red-500 text-sm mt-1 block';
                errorSpan.textContent = message;
                
                // Insert after the field
                field.parentNode.insertBefore(errorSpan, field.nextSibling);
            }
            
            function clearFieldError(field) {
                // Remove error styling
                field.classList.remove('border-red-500');
                field.classList.add('border-gray-300');
                
                // Remove error message
                const errorSpan = field.parentNode.querySelector('.field-validation-error');
                if (errorSpan) {
                    errorSpan.remove();
                }
            }
            
            function clearFormErrors() {
                // Clear all field errors
                requiredFields.forEach(function(fieldId) {
                    const field = document.getElementById(fieldId);
                    if (field) {
                        clearFieldError(field);
                    }
                });
                
                // Clear additional fields
                const additionalFields = ['TenderClosingDate', 'TenderOpeningDate'];
                additionalFields.forEach(function(fieldId) {
                    const field = document.getElementById(fieldId);
                    if (field) {
                        clearFieldError(field);
                    }
                });
                
                // Remove form-level error
                const formError = document.querySelector('.form-validation-error');
                if (formError) {
                    formError.remove();
                }
            }
            
            function showFormError(errors) {
                // Create form-level error display
                const errorDiv = document.createElement('div');
                errorDiv.className = 'form-validation-error bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-6';
                
                const errorTitle = document.createElement('h4');
                errorTitle.className = 'font-medium mb-2';
                errorTitle.textContent = 'Please fix the following errors:';
               // errorDiv.appendChild(errorTitle);
                
                const errorList = document.createElement('ul');
                errorList.className = 'list-disc list-inside space-y-1';
                
                // errors.forEach(function(error) {
                //     const listItem = document.createElement('li');
                //     listItem.textContent = error;
                //     errorList.appendChild(listItem);
                // });
                
                // errorDiv.appendChild(errorList);
                
                // Insert at the top of the form
                form.insertBefore(errorDiv, form.firstChild);
                
                // Scroll to show error
                errorDiv.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
            
            function focusFirstErrorField() {
                const firstErrorField = document.querySelector('.border-red-500');
                if (firstErrorField) {
                    firstErrorField.focus();
                    firstErrorField.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
            }
            
            // Button State Management
            function showLoadingState() {
                saveButton.disabled = true;
                saveButton.innerHTML = '<i class="ri-loader-line mr-2 animate-spin"></i>Validating...';
                saveButton.classList.add('opacity-75');
            }
            
            function showSuccessState() {
                saveButton.innerHTML = '<i class="ri-check-line mr-2"></i>Saving...';
                saveButton.classList.remove('bg-primary', 'hover:bg-primary/90');
                saveButton.classList.add('bg-green-500', 'hover:bg-green-600');
            }
            
            function showErrorState(errors) {
                saveButton.disabled = false;
                saveButton.innerHTML = '<i class="ri-error-warning-line mr-2"></i>Fix Errors';
                saveButton.classList.remove('bg-primary', 'hover:bg-primary/90', 'opacity-75');
                saveButton.classList.add('bg-red-500', 'hover:bg-red-600');
                
                // Show form errors
                showFormError(errors);
                
                // Reset button after 3 seconds
                setTimeout(function() {
                    resetButtonState();
                }, 3000);
            }
            
            function resetButtonState() {
                saveButton.disabled = false;
                saveButton.innerHTML = '<i class="ri-save-line mr-2"></i>Save Tender';
                saveButton.classList.remove('bg-red-500', 'hover:bg-red-600', 'bg-green-500', 'hover:bg-green-600', 'opacity-75');
                saveButton.classList.add('bg-primary', 'hover:bg-primary/90');
            }
            
            // Real-time validation for number fields
            const numberFields = ['EmdAmount', 'SdAmount', 'ProcessingFee', 'EstimatedValue'];
            numberFields.forEach(function(fieldId) {
                const field = document.getElementById(fieldId);
                if (field) {
                    field.addEventListener('input', function() {
                        const value = parseFloat(this.value);
                        if (this.value && (isNaN(value) || value <= 0)) {
                            showFieldError(this, 'Must be greater than 0');
                        } else {
                            clearFieldError(this);
                        }
                    });
                }
            });
            
            // Character counter for description
            const descriptionField = document.getElementById('Description');
            if (descriptionField) {
                descriptionField.addEventListener('input', function() {
                    const count = this.value.length;
                    const counter = document.getElementById('descriptionCount');
                    if (counter) {
                        counter.textContent = count;
                        
                        if (count > 1000) {
                            this.value = this.value.substring(0, 1000);
                            counter.textContent = 1000;
                            showFieldError(this, 'Maximum 1000 characters allowed');
                        } else if (count < 1000) {
                            clearFieldError(this);
                        }
                    }
                });
            }
            
            // Date validation helpers
            const publishDateField = document.getElementById('PublishDate');
            if (publishDateField) {
                publishDateField.addEventListener('change', function() {
                    const publishDate = new Date(this.value);
                    const lastDateEmdField = document.getElementById('LastDateEmd');
                    
                    if (publishDate && lastDateEmdField) {
                        const minDate = new Date(publishDate);
                        minDate.setDate(minDate.getDate() + 1);
                        lastDateEmdField.min = minDate.toISOString().split('T')[0];
                        
                        // Clear any existing date if it's now invalid
                        if (lastDateEmdField.value && new Date(lastDateEmdField.value) <= publishDate) {
                            lastDateEmdField.value = '';
                            showFieldError(lastDateEmdField, 'Must be after publish date');
                        }
                    }
                });
            }
            
            // Additional real-time validations
            const lastDateEmdField = document.getElementById('LastDateEmd');
            if (lastDateEmdField) {
                lastDateEmdField.addEventListener('change', function() {
                    const publishDate = document.getElementById('PublishDate').value;
                    if (publishDate && this.value) {
                        const pubDate = new Date(publishDate);
                        const emdDate = new Date(this.value);
                        
                        if (emdDate <= pubDate) {
                            showFieldError(this, 'Must be after publish date');
                        } else {
                            clearFieldError(this);
                        }
                    }
                });
            }
            
            // Tender ID uniqueness check (if you have an API endpoint)
            const tenderIdField = document.getElementById('TenderId');
            if (tenderIdField) {
