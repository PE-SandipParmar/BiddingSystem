                    }
                }, 30000); // Auto-save after 30 seconds of inactivity
            }
            
            // Listen for input changes for auto-save
            requiredFields.forEach(function(fieldId) {
                const field = document.getElementById(fieldId);
                if (field) {
                    field.addEventListener('input', autoSaveDraft);
                    field.addEventListener('change', autoSaveDraft);
                }
            });
            
            // Initialize form state
            function initializeForm() {
                // Set today as minimum date for publish date
                const today = new Date().toISOString().split('T')[0];
                const publishDateField = document.getElementById('PublishDate');
                if (publishDateField && !publishDateField.value) {
                    publishDateField.min = today;
                }
                
                // Focus on first field
                const firstField = document.getElementById('TenderId');
                if (firstField) {
                    firstField.focus();
                }
            }
            
            // Call initialization
            initializeForm();
            
            console.log('Enhanced tender validation system loaded successfully');
