@model BiddingSystem.ViewModels.TenderDashboardViewModel
@using BiddingSystem.Models
@{
    ViewData["Title"] = "Tender Dashboard";
}

<div class="flex justify-between items-center mb-6">
    <div>
        <h1 class="text-2xl font-bold text-gray-800">Tender Dashboard</h1>
        <p class="text-gray-600 mt-1">Overview of tender management system</p>
    </div>
    <a asp-action="Create" class="bg-primary text-white px-4 py-2 rounded-lg hover:bg-primary/90 transition-colors flex items-center">
        <i class="ri-add-line mr-2"></i>
        Add New Tender
    </a>
</div>

<!-- Statistics Cards -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <div class="bg-white rounded-lg shadow p-6">
        <div class="flex items-center">
            <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mr-4">
                <i class="ri-file-list-line text-blue-600 text-xl"></i>
            </div>
            <div>
                <p class="text-sm text-gray-600">Total Tenders</p>
                <p class="text-2xl font-bold text-gray-800">@Model.TotalTenders</p>
            </div>
        </div>
    </div>
    
    <div class="bg-white rounded-lg shadow p-6">
        <div class="flex items-center">
            <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center mr-4">
                <i class="ri-eye-line text-green-600 text-xl"></i>
            </div>
            <div>
                <p class="text-sm text-gray-600">Published</p>
                <p class="text-2xl font-bold text-gray-800">@Model.PublishedTenders</p>
            </div>
        </div>
    </div>
    
    <div class="bg-white rounded-lg shadow p-6">
        <div class="flex items-center">
            <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center mr-4">
                <i class="ri-auction-line text-purple-600 text-xl"></i>
            </div>
            <div>
                <p class="text-sm text-gray-600">Total Bids</p>
                <p class="text-2xl font-bold text-gray-800">@Model.TotalBids</p>
            </div>
        </div>
    </div>
    
    <div class="bg-white rounded-lg shadow p-6">
        <div class="flex items-center">
            <div class="w-12 h-12 bg-yellow-100 rounded-lg flex items-center justify-center mr-4">
                <i class="ri-money-dollar-circle-line text-yellow-600 text-xl"></i>
            </div>
            <div>
                <p class="text-sm text-gray-600">EMD Collected</p>
                <p class="text-2xl font-bold text-gray-800">₹@Model.TotalEmdCollected.ToString("N0")</p>
            </div>
        </div>
    </div>
</div>

<!-- Additional Statistics -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <div class="bg-white rounded-lg shadow p-6">
        <div class="flex items-center">
            <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center mr-4">
                <i class="ri-check-circle-line text-green-600 text-xl"></i>
            </div>
            <div>
                <p class="text-sm text-gray-600">Paid Bids</p>
                <p class="text-2xl font-bold text-gray-800">@Model.PaidBids</p>
            </div>
        </div>
    </div>
    
    <div class="bg-white rounded-lg shadow p-6">
        <div class="flex items-center">
            <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mr-4">
                <i class="ri-bank-card-line text-blue-600 text-xl"></i>
            </div>
            <div>
                <p class="text-sm text-gray-600">Processing Fees</p>
                <p class="text-2xl font-bold text-gray-800">₹@Model.TotalProcessingFeesCollected.ToString("N0")</p>
            </div>
        </div>
    </div>
    
    <div class="bg-white rounded-lg shadow p-6">
        <div class="flex items-center">
            <div class="w-12 h-12 bg-red-100 rounded-lg flex items-center justify-center mr-4">
                <i class="ri-time-line text-red-600 text-xl"></i>
            </div>
            <div>
                <p class="text-sm text-gray-600">Expiring Soon</p>
                <p class="text-2xl font-bold text-gray-800">@Model.ExpiringTenders.Count</p>
            </div>
        </div>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Recent Tenders -->
    <div class="lg:col-span-2">
        <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-lg font-semibold text-gray-800">Recent Tenders</h2>
                <a asp-action="Index" class="text-primary hover:text-primary/80 text-sm">View All</a>
            </div>
            
            @if (Model.RecentTenders.Any())
            {
                <div class="space-y-4">
                    @foreach (var tender in Model.RecentTenders.Take(5))
                    {
                        <div class="flex items-center justify-between p-4 border border-gray-200 rounded-lg hover:bg-gray-50">
                            <div class="flex items-center">
                                <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center mr-4">
                                    <i class="ri-file-list-line text-blue-600"></i>
                                </div>
                                <div>
                                    <p class="text-sm font-medium text-gray-900">@tender.TenderId</p>
                                    <p class="text-xs text-gray-500">@tender.TenderTitle</p>
                                </div>
                            </div>
                            <div class="flex items-center space-x-3">
                                <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium @tender.StatusBadgeClass">
                                    @tender.StatusDisplayName
                                </span>
                                <a asp-action="Details" asp-route-id="@tender.Id" class="text-primary hover:text-primary/80">
                                    <i class="ri-eye-line"></i>
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-8 text-gray-500">
                    <i class="ri-file-list-line text-4xl mb-2"></i>
                    <p>No tenders found</p>
                </div>
            }
        </div>
    </div>
    
    <!-- Sidebar -->
    <div class="space-y-6">
        <!-- Tender Status Chart -->
        <div class="bg-white rounded-lg shadow p-6">
            <h3 class="text-lg font-semibold text-gray-800 mb-4">Tender Status</h3>
            
            <div class="space-y-3">
                @foreach (var status in Model.TenderCountByStatus)
                {
                    var percentage = Model.TotalTenders > 0 ? (status.Value * 100.0 / Model.TotalTenders) : 0;
                    var statusName = status.Key switch
                    {
                        TenderStatus.Draft => "Draft",
                        TenderStatus.Published => "Published",
                        TenderStatus.Closed => "Closed",
                        TenderStatus.Cancelled => "Cancelled",
                        _ => "Unknown"
                    };
                    var statusColor = status.Key switch
                    {
                        TenderStatus.Draft => "bg-gray-500",
                        TenderStatus.Published => "bg-green-500",
                        TenderStatus.Closed => "bg-red-500",
                        TenderStatus.Cancelled => "bg-yellow-500",
                        _ => "bg-gray-500"
                    };
                    
                    <div>
                        <div class="flex items-center justify-between mb-1">
                            <span class="text-sm text-gray-600">@statusName</span>
                            <span class="text-sm font-medium text-gray-900">@status.Value</span>
                        </div>
                        <div class="w-full bg-gray-200 rounded-full h-2">
                            <div class="@statusColor h-2 rounded-full" style="width: @percentage%"></div>
                        </div>
                    </div>
                }
            </div>
        </div>
        
        <!-- Expiring Tenders -->
        <div class="bg-white rounded-lg shadow p-6">
            <h3 class="text-lg font-semibold text-gray-800 mb-4">Expiring Soon</h3>
            
            @if (Model.ExpiringTenders.Any())
            {
                <div class="space-y-3">
                    @foreach (var tender in Model.ExpiringTenders.Take(3))
                    {
                        var daysLeft = (tender.LastDateEmd - DateTime.Now).Days;
                        <div class="p-3 border border-red-200 rounded-lg bg-red-50">
                            <div class="flex items-center justify-between">
                                <div>
                                    <p class="text-sm font-medium text-gray-900">@tender.TenderId</p>
                                    <p class="text-xs text-gray-500">@tender.TenderTitle</p>
                                </div>
                                <span class="text-xs font-medium text-red-600">@daysLeft days</span>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-4 text-gray-500">
                    <i class="ri-check-circle-line text-2xl mb-2"></i>
                    <p class="text-sm">No expiring tenders</p>
                </div>
            }
        </div>
        
        <!-- Upcoming Tenders -->
        <div class="bg-white rounded-lg shadow p-6">
            <h3 class="text-lg font-semibold text-gray-800 mb-4">Upcoming</h3>
            
            @if (Model.UpcomingTenders.Any())
            {
                <div class="space-y-3">
                    @foreach (var tender in Model.UpcomingTenders.Take(3))
                    {
                        <div class="p-3 border border-blue-200 rounded-lg bg-blue-50">
                            <div class="flex items-center justify-between">
                                <div>
                                    <p class="text-sm font-medium text-gray-900">@tender.TenderId</p>
                                    <p class="text-xs text-gray-500">@tender.TenderTitle</p>
                                </div>
                                <span class="text-xs font-medium text-blue-600">@tender.PublishDate.ToString("dd MMM")</span>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-4 text-gray-500">
                    <i class="ri-calendar-line text-2xl mb-2"></i>
                    <p class="text-sm">No upcoming tenders</p>
                </div>
            }
        </div>
        
        <!-- Quick Actions -->
        <div class="bg-white rounded-lg shadow p-6">
            <h3 class="text-lg font-semibold text-gray-800 mb-4">Quick Actions</h3>
            
            <div class="space-y-3">
                <a asp-action="Create" class="w-full flex items-center justify-center px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary/90 transition-colors">
                    <i class="ri-add-line mr-2"></i>
                    Create Tender
                </a>
                
                <a asp-action="Index" class="w-full flex items-center justify-center px-4 py-2 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-50">
                    <i class="ri-file-list-line mr-2"></i>
                    Manage Tenders
                </a>
                
                <a asp-controller="TenderBid" asp-action="Index" class="w-full flex items-center justify-center px-4 py-2 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-50">
                    <i class="ri-auction-line mr-2"></i>
                    View Bids
                </a>
            </div>
        </div>
    </div>
</div>
