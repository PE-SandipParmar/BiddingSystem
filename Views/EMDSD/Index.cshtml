@model BiddingSystem.ViewModels.EMDSDDepositListViewModel
@{
    ViewData["Title"] = "EMD/SD Management";
}

<div class="flex justify-between items-center mb-6">
    <div>
        <h1 class="text-2xl font-bold text-gray-800">All EMD/SD Payment Transaction</h1>
        <p class="text-gray-600 mt-1">View and manage all tenders in the system</p>
    </div>
    <a asp-action="Create" class="bg-primary text-white px-4 py-2 rounded-lg hover:bg-primary/90 transition-colors flex items-center">
        <i class="ri-add-line mr-2"></i>
        New Deposit
    </a>
</div>

<!-- Action Bar -->
<div class="bg-white rounded shadow mb-6">
    <div class="p-4">
        <form asp-action="Search" method="get" class="flex flex-row items-center gap-4">
            <input type="number" name="depositId" placeholder="Deposit ID" value="@Model.SearchTerm" class="px-4 py-2 border border-gray-300 rounded bg-white text-gray-500 text-base outline-none" style="min-width: 160px;">
            <input type="text" name="tenderName" placeholder="Tender Name" class="px-4 py-2 border border-gray-300 rounded bg-white text-gray-500 text-base outline-none" style="min-width: 160px;">
            <select name="status" class="px-4 py-2 border border-gray-300 rounded bg-white text-gray-500 text-base outline-none" style="min-width: 120px;">
                <option value="">All Status</option>
                @foreach (var status in Model.StatusOptions)
                {
                    @if (Model.Status == status)
                    {
                        <option value="@status" selected>@status</option>
                    }
                    else
                    {
                        <option value="@status">@status</option>
                    }
                }
            </select>
            <select name="type" class="px-4 py-2 border border-gray-300 rounded bg-white text-gray-500 text-base outline-none" style="min-width: 100px;">
                <option value="">All Types</option>
                @foreach (var type in Model.TypeOptions)
                {
                    @if (Model.Type == type)
                    {
                        <option value="@type" selected>@type</option>
                    }
                    else
                    {
                        <option value="@type">@type</option>
                    }
                }
            </select>
            <button type="submit" class="flex items-center px-6 py-2 bg-primary text-white rounded-lg hover:bg-primary/90 text-base font-medium">
                <i class="ri-search-line mr-2"></i> Search
            </button>

        </form>
    </div>
</div>

<!-- Success/Error Messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
        @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
        @TempData["ErrorMessage"]
    </div>
}

<!-- Main Content Grid -->
<div>
    <div class="bg-white rounded shadow overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead>
                    <tr class="bg-gray-50">
                        <th class="px-6 py-3 text-left text-sm font-semibold text-gray-500 tracking-wider">Deposit ID</th>
                        <th class="px-6 py-3 text-left text-sm font-semibold text-gray-500 tracking-wider">Tender Name</th>
                        <th class="px-6 py-3 text-left text-sm font-semibold text-gray-500 tracking-wider">Amount</th>
                        <th class="px-6 py-3 text-left text-sm font-semibold text-gray-500 tracking-wider">Bidder Name</th>
                        <th class="px-6 py-3 text-left text-sm font-semibold text-gray-500 tracking-wider">Company Name</th>
                        <th class="px-6 py-3 text-left text-sm font-semibold text-gray-500 tracking-wider">Transaction Date</th>
                        <th class="px-6 py-3 text-left text-sm font-semibold text-gray-500 tracking-wider">Bank Name</th>
                        <th class="px-6 py-3 text-left text-sm font-semibold text-gray-500 tracking-wider">FSSAI Branch Name</th>
                        <th class="px-6 py-3 text-left text-sm font-semibold text-gray-500 tracking-wider">Transaction ID</th>
                        <th class="px-6 py-3 text-left text-sm font-semibold text-gray-500 tracking-wider">Status</th>
                        <th class="px-6 py-3 text-left text-sm font-semibold text-gray-500 tracking-wider">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    @if (Model.Deposits.Any())
                    {
                        @foreach (var deposit in Model.Deposits)
                        {
                            <tr class="table-row">
                                <td class="px-6 py-4 text-sm font-medium text-gray-800">@deposit.DepositId</td>
                                <td class="px-6 py-4 text-sm text-gray-800">@deposit.TenderName</td>
                                <td class="px-6 py-4 text-sm text-gray-800">₹ @deposit.Amount.ToString("N0")</td>
                                <td class="px-6 py-4 text-sm text-gray-800">@deposit.BidderName</td>
                                <td class="px-6 py-4 text-sm text-gray-800">@deposit.CompanyName</td>
                                <td class="px-6 py-4 text-sm text-gray-800">@deposit.TransactionDate.ToString("yyyy-MM-dd")</td>
                                <td class="px-6 py-4 text-sm text-gray-800">@deposit.BankName</td>
                                <td class="px-6 py-4 text-sm text-gray-800">@deposit.FSSAIBranchName</td>
                                <td class="px-6 py-4 text-sm text-gray-800">@deposit.TransactionId</td>
                                <td class="px-6 py-4 text-sm">
                                    @switch (deposit.Status)
                                    {
                                        case "Paid":
                                            <span class="text-green-700">@deposit.Status</span>
                                            break;
                                        case "Failed":
                                            <span class="text-yellow-700">@deposit.Status</span>
                                            break;
                                        case "Refunded":
                                            <span class="text-red-700">@deposit.Status</span>
                                            break;
                                        default:
                                            <span class="text-gray-700">@deposit.Status</span>
                                            break;
                                    }
                                </td>
                                <td class="px-6 py-4">
                                    <div class="flex space-x-2">
                                        <a href="@Url.Action("Details", new { id = deposit.Id })" class="action-button text-gray-500 hover:text-primary" title="View Details">
                                            <i class="ri-eye-line"></i>
                                        </a>
                                        @if (deposit.Status != "Paid")
                                        {
                                            <a href="@Url.Action("Edit", new { id = deposit.Id })" class="action-button text-gray-500 hover:text-blue-600" title="Edit">
                                                <i class="ri-edit-line"></i>
                                            </a>
                                            <a href="@Url.Action("Delete", new { id = deposit.Id })" class="action-button text-gray-500 hover:text-red-600" title="Delete">
                                                <i class="ri-delete-bin-line"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="11" class="px-6 py-4 text-center text-gray-500">No deposits found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <div class="px-6 py-4 border-t border-gray-200">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between">
                    <div class="flex items-center space-x-4 mb-4 sm:mb-0">
                        <span class="text-sm text-gray-700">
                            Showing @((Model.CurrentPage - 1) * Model.PageSize + 1) to @Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount) of @Model.TotalCount results
                        </span>
                        <div class="flex items-center space-x-2">
                            <label class="text-sm text-gray-700">Items per page:</label>
                            <select class="px-2 py-1 border border-gray-300 rounded text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary">
                                @if (Model.PageSize == 10)
                                {
                                    <option value="10" selected>10</option>
                                }
                                else
                                {
                                    <option value="10">10</option>
                                }
                                @if (Model.PageSize == 25)
                                {
                                    <option value="25" selected>25</option>
                                }
                                else
                                {
                                    <option value="25">25</option>
                                }
                                @if (Model.PageSize == 50)
                                {
                                    <option value="50" selected>50</option>
                                }
                                else
                                {
                                    <option value="50">50</option>
                                }
                                @if (Model.PageSize == 100)
                                {
                                    <option value="100" selected>100</option>
                                }
                                else
                                {
                                    <option value="100">100</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="flex items-center space-x-2">
                        @if (Model.CurrentPage > 1)
                        {
                            <a href="@Url.Action("Index", new { page = Model.CurrentPage - 1, pageSize = Model.PageSize, searchTerm = Model.SearchTerm, status = Model.Status, type = Model.Type })"
                               class="px-3 py-1 border border-gray-300 rounded text-sm text-gray-500 hover:bg-gray-50">
                                Previous
                            </a>
                        }
                        else
                        {
                            <span class="px-3 py-1 border border-gray-300 rounded text-sm text-gray-400 opacity-50 cursor-not-allowed">Previous</span>
                        }

                        @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                        {
                            if (i == Model.CurrentPage)
                            {
                                <span class="px-3 py-1 bg-primary text-white rounded text-sm">@i</span>
                            }
                            else
                            {
                                <a href="@Url.Action("Index", new { page = i, pageSize = Model.PageSize, searchTerm = Model.SearchTerm, status = Model.Status, type = Model.Type })"
                                   class="px-3 py-1 border border-gray-300 rounded text-sm text-gray-700 hover:bg-gray-50">@i</a>
                            }
                        }

                        @if (Model.CurrentPage < Model.TotalPages)
                        {
                            <a href="@Url.Action("Index", new { page = Model.CurrentPage + 1, pageSize = Model.PageSize, searchTerm = Model.SearchTerm, status = Model.Status, type = Model.Type })"
                               class="px-3 py-1 border border-gray-300 rounded text-sm text-gray-700 hover:bg-gray-50">
                                Next
                            </a>
                        }
                        else
                        {
                            <span class="px-3 py-1 border border-gray-300 rounded text-sm text-gray-400 opacity-50 cursor-not-allowed">Next</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .metric-card {
        transition: all 0.3s ease;
    }

        .metric-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        }

    .table-row {
        transition: all 0.2s ease;
    }

        .table-row:hover {
            background-color: #f8fafc;
        }

    .action-button {
        transition: all 0.2s ease;
    }

        .action-button:hover {
            transform: translateY(-1px);
        }
</style>
