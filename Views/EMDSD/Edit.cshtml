@model BiddingSystem.ViewModels.EMDSDDepositEditViewModel
@{
    ViewData["Title"] = "Edit EMD/SD Deposit";
}

<div class="flex justify-between items-center mb-6">
    <div>
        <h1 class="text-2xl font-bold text-gray-800">Edit EMD/SD Deposit</h1>
        <p class="text-gray-600 mt-1">Update deposit information - ID: @Model.DepositId</p>
    </div>
    <a href="@Url.Action("Index")" class="bg-gray-500 text-white px-4 py-2 rounded-lg hover:bg-gray-600 transition-colors flex items-center">
        <i class="ri-arrow-left-line mr-2"></i>
        Back to List
    </a>
</div>

<form asp-action="Edit" method="post" class="space-y-8" id="editDepositForm" novalidate>
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="DepositId" />
    <input type="hidden" asp-for="TenderBidId" id="hdnTenderBidId" />
    
    <div class="bg-white rounded-lg shadow p-8">
        <div class="flex items-center mb-8">
            <div class="w-12 h-12 flex items-center justify-center rounded-full bg-blue-100 text-primary mr-5">
                <i class="ri-bank-card-line text-xl"></i>
            </div>
            <div>
                <h2 class="text-xl font-semibold text-gray-800">Deposit Information</h2>
                <p class="text-sm text-gray-500 mt-1">Update EMD/SD deposit details and transaction information</p>
            </div>
        </div>
        
        @* <div asp-validation-summary="ModelOnly" class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-6" role="alert"></div> *@
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <!-- Deposit ID (Read-only) -->
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Deposit ID</label>
                <input type="text" value="@Model.DepositId" disabled 
                       class="w-full px-4 py-3 border border-gray-300 rounded-lg bg-gray-50 text-gray-500 cursor-not-allowed text-base">
                <p class="text-xs text-gray-500 mt-1">Deposit ID cannot be changed</p>
            </div>

            <!-- Tender Selection -->
            <div>
                <label asp-for="TenderId" class="block text-sm font-medium text-gray-700 mb-2">
                    Tender <span class="text-red-500">*</span>
                </label>
                <select asp-for="TenderId" asp-items="@(new SelectList(Model.AvailableTenders, "Id", "TenderTitle"))" 
                        id="tenderSelect" 
                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-base">
                    <option value="">Select Tender</option>
                </select>
                <span asp-validation-for="TenderId" class="text-red-500 text-sm validation-message"></span>
            </div>

            <!-- Tender Bid Selection -->
            <div>
                <label asp-for="TenderBidId" class="block text-sm font-medium text-gray-700 mb-2">
                    Tender Bid <span class="text-red-500">*</span>
                </label>
                <select asp-for="TenderBidId" id="tenderBidSelect" 
                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-base">
                    <option value="">Select Tender First</option>
                </select>
                <span asp-validation-for="TenderBidId" class="text-red-500 text-sm validation-message"></span>
            </div>

            <!-- Type -->
            <div>
                <label asp-for="Type" class="block text-sm font-medium text-gray-700 mb-2">
                    Type <span class="text-red-500">*</span>
                </label>
                <select asp-for="Type" asp-items="@(new SelectList(Model.TypeOptions))" 
                        id="typeSelect" 
                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-base">
                    <option value="">Select Type</option>
                </select>
                <span asp-validation-for="Type" class="text-red-500 text-sm validation-message"></span>
            </div>

            <!-- Status -->
            <div>
                <label asp-for="Status" class="block text-sm font-medium text-gray-700 mb-2">
                    Status <span class="text-red-500">*</span>
                </label>
                <select asp-for="Status" asp-items="@(new SelectList(Model.StatusOptions))" 
                        id="statusSelect" 
                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-base">
                    <option value="">Select Status</option>
                </select>
                <span asp-validation-for="Status" class="text-red-500 text-sm validation-message"></span>
            </div>

            <!-- Amount -->
            <div>
                <label asp-for="Amount" class="block text-sm font-medium text-gray-700 mb-2">
                    Amount <span class="text-red-500">*</span>
                </label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                        <span class="text-gray-500 text-base">₹</span>
                    </div>
                    <input asp-for="Amount" type="number" step="0.01" min="0" 
                           id="amountInput" placeholder="0.00"
                           class="w-full pl-8 pr-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-base">
                </div>
                <span asp-validation-for="Amount" class="text-red-500 text-sm validation-message"></span>
            </div>

            <!-- Transaction Date -->
            <div>
                <label asp-for="TransactionDate" class="block text-sm font-medium text-gray-700 mb-2">
                    Transaction Date <span class="text-red-500">*</span>
                </label>
                <input asp-for="TransactionDate" type="date" 
                       id="transactionDateInput" 
                       class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-base">
                <span asp-validation-for="TransactionDate" class="text-red-500 text-sm validation-message"></span>
            </div>

            <!-- Bidder Name -->
            <div>
                <label asp-for="BidderName" class="block text-sm font-medium text-gray-700 mb-2">
                    Bidder Name <span class="text-red-500">*</span>
                </label>
                <input asp-for="BidderName" id="bidderNameInput" 
                       placeholder="Enter bidder name"
                       class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-base">
                <span asp-validation-for="BidderName" class="text-red-500 text-sm validation-message"></span>
            </div>

            <!-- Company Name -->
            <div>
                <label asp-for="CompanyName" class="block text-sm font-medium text-gray-700 mb-2">
                    Company Name <span class="text-red-500">*</span>
                </label>
                <input asp-for="CompanyName" id="companyNameInput" 
                       placeholder="Enter company name"
                       class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-base">
                <span asp-validation-for="CompanyName" class="text-red-500 text-sm validation-message"></span>
            </div>

            <!-- Bank Name -->
            <div>
                <label asp-for="BankName" class="block text-sm font-medium text-gray-700 mb-2">
                    Bank Name <span class="text-red-500">*</span>
                </label>
                <input asp-for="BankName" id="bankNameInput" 
                       placeholder="Enter bank name"
                       class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-base">
                <span asp-validation-for="BankName" class="text-red-500 text-sm validation-message"></span>
            </div>

            <!-- FSSAI Branch Name -->
            <div>
                <label asp-for="FSSAIBranchName" class="block text-sm font-medium text-gray-700 mb-2">
                    FSSAI Branch Name <span class="text-red-500">*</span>
                </label>
                <input asp-for="FSSAIBranchName" id="fssaiBranchNameInput" 
                       placeholder="Enter FSSAI branch name"
                       class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-base">
                <span asp-validation-for="FSSAIBranchName" class="text-red-500 text-sm validation-message"></span>
            </div>

            <!-- Transaction ID -->
            <div>
                <label asp-for="TransactionId" class="block text-sm font-medium text-gray-700 mb-2">
                    Transaction ID <span class="text-red-500">*</span>
                </label>
                <input asp-for="TransactionId" id="transactionIdInput" 
                       placeholder="Enter transaction ID"
                       class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-base">
                <span asp-validation-for="TransactionId" class="text-red-500 text-sm validation-message"></span>
            </div>

            <!-- Remarks -->
            <div class="md:col-span-2">
                <label asp-for="Remarks" class="block text-sm font-medium text-gray-700 mb-2">Remarks</label>
                <textarea asp-for="Remarks" id="remarksInput" rows="3" 
                          placeholder="Enter any remarks (optional)"
                          class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-base"></textarea>
                <span asp-validation-for="Remarks" class="text-red-500 text-sm validation-message"></span>
            </div>
        </div>
        
        <div class="flex justify-end gap-4 mt-8">
            <a href="@Url.Action("Index")" class="px-6 py-3 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors">
                Cancel
            </a>
            <button type="submit" id="updateBtn" class="px-6 py-3 bg-primary text-white rounded-lg hover:bg-primary/90 transition-colors">
                <i class="ri-save-line mr-2"></i>Update Deposit
            </button>
        </div>
    </div>
</form>

<!-- Information Footer -->
<div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mt-6">
    <div class="flex items-start">
        <div class="w-5 h-5 flex items-center justify-center rounded-full bg-blue-100 text-blue-600 mr-3 mt-0.5">
            <i class="ri-information-line text-sm"></i>
        </div>
        <div>
            <h4 class="text-sm font-medium text-blue-800 mb-1">Important Information</h4>
            <ul class="text-sm text-blue-700 space-y-1">
                <li>• All fields marked with <span class="text-red-500">*</span> are required</li>
                <li>• Selecting a tender will load available bids for that tender</li>
                <li>• Amount will be auto-filled based on tender and deposit type (EMD/SD)</li>
                <li>• Bidder information will be auto-filled when selecting a tender bid</li>
                <li>• Transaction date cannot be in the future</li>
                <li>• Changes will be validated before saving</li>
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('editDepositForm');
            const tenderSelect = document.getElementById('tenderSelect');
            const tenderBidSelect = document.getElementById('tenderBidSelect');
            const typeSelect = document.getElementById('typeSelect');
            const statusSelect = document.getElementById('statusSelect');
            const amountInput = document.getElementById('amountInput');
            const bidderNameInput = document.getElementById('bidderNameInput');
            const companyNameInput = document.getElementById('companyNameInput');
            const transactionDateInput = document.getElementById('transactionDateInput');
            const bankNameInput = document.getElementById('bankNameInput');
            const fssaiBranchNameInput = document.getElementById('fssaiBranchNameInput');
            const transactionIdInput = document.getElementById('transactionIdInput');
            const remarksInput = document.getElementById('remarksInput');
            const updateBtn = document.getElementById('updateBtn');

            // Store tender data for amount calculation
            let tenderData = {};
            let tenderBidsData = {};

            // Validation functions
            function showError(input, message) {
                const errorElement = input.parentNode.querySelector('.validation-message') || 
                                  input.parentNode.parentNode.querySelector('.validation-message');
                if (errorElement) {
                    errorElement.textContent = message;
                    errorElement.style.display = 'block';
                }
                input.classList.add('border-red-500');
                input.classList.remove('border-gray-300');
            }

            function clearError(input) {
                const errorElement = input.parentNode.querySelector('.validation-message') || 
                                  input.parentNode.parentNode.querySelector('.validation-message');
                if (errorElement) {
                    errorElement.textContent = '';
                    errorElement.style.display = 'none';
                }
                input.classList.remove('border-red-500');
                input.classList.add('border-gray-300');
            }

            function validateField(input, fieldName, customValidator = null) {
                const value = input.value.trim();
                
                if (!value) {
                    showError(input, `${fieldName} is required.`);
                    return false;
                }

                if (customValidator && !customValidator(value)) {
                    return false;
                }

                clearError(input);
                return true;
            }

            function validateAmount(value) {
                const amount = parseFloat(value);
                if (isNaN(amount) || amount <= 0) {
                    showError(amountInput, 'Amount must be a positive number.');
                    return false;
                }
                return true;
            }

            function validateTransactionDate(value) {
                const selectedDate = new Date(value);
                const today = new Date();
                today.setHours(0, 0, 0, 0);
                
                if (selectedDate > today) {
                    showError(transactionDateInput, 'Transaction date cannot be in the future.');
                    return false;
                }
                return true;
            }

            function validateForm() {
                let isValid = true;

                // Validate all required fields
                if (!validateField(tenderSelect, 'Tender')) isValid = false;
                if (!validateField(tenderBidSelect, 'Tender Bid')) isValid = false;
                if (!validateField(typeSelect, 'Type')) isValid = false;
                if (!validateField(statusSelect, 'Status')) isValid = false;
                if (!validateField(amountInput, 'Amount', validateAmount)) isValid = false;
                if (!validateField(bidderNameInput, 'Bidder Name')) isValid = false;
                if (!validateField(companyNameInput, 'Company Name')) isValid = false;
                if (!validateField(transactionDateInput, 'Transaction Date', validateTransactionDate)) isValid = false;
                if (!validateField(bankNameInput, 'Bank Name')) isValid = false;
                if (!validateField(fssaiBranchNameInput, 'FSSAI Branch Name')) isValid = false;
                if (!validateField(transactionIdInput, 'Transaction ID')) isValid = false;

                return isValid;
            }

            // Real-time validation on input change
            function addRealTimeValidation(input, fieldName, customValidator = null) {
                input.addEventListener('blur', function() {
                    validateField(input, fieldName, customValidator);
                });

                input.addEventListener('input', function() {
                    if (input.value.trim()) {
                        clearError(input);
                    }
                });
            }

            // Add real-time validation to all fields
            addRealTimeValidation(tenderSelect, 'Tender');
            addRealTimeValidation(tenderBidSelect, 'Tender Bid');
            addRealTimeValidation(typeSelect, 'Type');
            addRealTimeValidation(statusSelect, 'Status');
            addRealTimeValidation(amountInput, 'Amount', validateAmount);
            addRealTimeValidation(bidderNameInput, 'Bidder Name');
            addRealTimeValidation(companyNameInput, 'Company Name');
            addRealTimeValidation(transactionDateInput, 'Transaction Date', validateTransactionDate);
            addRealTimeValidation(bankNameInput, 'Bank Name');
            addRealTimeValidation(fssaiBranchNameInput, 'FSSAI Branch Name');
            addRealTimeValidation(transactionIdInput, 'Transaction ID');

            // Form submission validation
            form.addEventListener('submit', function (e) {
                e.preventDefault();
                
                // Show loading state
                updateBtn.disabled = true;
                updateBtn.innerHTML = '<i class="ri-loader-4-line mr-2 animate-spin"></i>Validating...';

                // Validate form
                setTimeout(() => {
                    if (validateForm()) {
                        // If validation passes, submit the form
                        updateBtn.innerHTML = '<i class="ri-loader-4-line mr-2 animate-spin"></i>Updating...';
                        form.submit();
                    } else {
                        // Reset button state if validation fails
                        updateBtn.disabled = false;
                        updateBtn.innerHTML = '<i class="ri-save-line mr-2"></i>Update Deposit';
                        
                        // Scroll to first error field
                        const firstErrorField = form.querySelector('.border-red-500');
                        if (firstErrorField) {
                            firstErrorField.scrollIntoView({ behavior: 'smooth', block: 'center' });
                            firstErrorField.focus();
                        }
                    }
                }, 100);
            });

            // Function to auto-fill amount based on tender and type
            function autoFillAmount() {
                const tenderId = tenderSelect.value;
                const type = typeSelect.value;
                
                if (tenderId && type && tenderData[tenderId]) {
                    const tender = tenderData[tenderId];
                    let amount = 0;
                    
                    if (type === 'EMD') {
                        amount = tender.emdAmount || 0;
                    } else if (type === 'SD') {
                        amount = tender.sdAmount || 0;
                    }
                    
                    if (amount > 0) {
                        amountInput.value = amount;
                        clearError(amountInput);
                    }
                }
            }
            
            // Function to auto-fill bidder information based on selected tender bid
            function autoFillBidderInfo() {
                const tenderBidId = tenderBidSelect.value;
                
                if (tenderBidId && tenderBidsData[tenderBidId]) {
                    const tenderBid = tenderBidsData[tenderBidId];
                    bidderNameInput.value = tenderBid.bidderName || '';
                    companyNameInput.value = tenderBid.companyName || '';
                    
                    // Clear validation errors for auto-filled fields
                    if (tenderBid.bidderName) clearError(bidderNameInput);
                    if (tenderBid.companyName) clearError(companyNameInput);
                } else {
                    // Clear bidder info if no tender bid selected
                    bidderNameInput.value = '';
                    companyNameInput.value = '';
                }
            }
            
            // Load tender bids when tender is selected
            function loadTenderBids(tenderId, selectedTenderBidId = null) {
                if (tenderId) {
                    // Show loading state
                    tenderBidSelect.innerHTML = '<option value="">Loading bids...</option>';
                    tenderBidSelect.disabled = true;
                    
                    // Fetch tender details for amount calculation
                    fetch(`/EMDSD/GetTenderDetails?tenderId=${tenderId}`)
                        .then(response => response.json())
                        .then(tender => {
                            tenderData[tenderId] = tender;
                            // Auto-fill amount after tender data is loaded
                            setTimeout(() => {
                                autoFillAmount();
                            }, 100);
                        })
                        .catch(error => {
                            console.error('Error loading tender details:', error);
                        });
                    
                    fetch(`/EMDSD/GetTenderBids?tenderId=${tenderId}`)
                        .then(response => response.json())
                        .then(data => {
                            tenderBidSelect.innerHTML = '<option value="">Select Tender Bid</option>';
                            
                            if (data && data.length > 0) {
                                data.forEach(bid => {
                                    // Store bid data for auto-fill
                                    tenderBidsData[bid.id] = bid;
                                    
                                    const option = document.createElement('option');
                                    option.value = bid.id;
                                    option.textContent = `${bid.bidderName} - ${bid.companyName} (₹${bid.bidAmount})`;
                                    tenderBidSelect.appendChild(option);
                                });
                                
                                // Set the selected value if provided (for edit mode)
                                selectedTenderBidId = document.getElementById('hdnTenderBidId').value;
                                if (selectedTenderBidId) {
                                    tenderBidSelect.value = selectedTenderBidId;
                                    // Auto-fill bidder info for the selected bid
                                    setTimeout(() => {
                                        autoFillBidderInfo();
                                    }, 100);
                                }
                                
                                tenderBidSelect.disabled = false;
                                clearError(tenderBidSelect);
                            } else {
                                tenderBidSelect.innerHTML = '<option value="">No bids found for this tender</option>';
                            }
                        })
                        .catch(error => {
                            console.error('Error loading tender bids:', error);
                            tenderBidSelect.innerHTML = '<option value="">Error loading bids</option>';
                        });
                } else {
                    tenderBidSelect.innerHTML = '<option value="">Select Tender First</option>';
                    tenderBidSelect.disabled = true;
                }
            }
            
            // Initialize form on page load
            function initializeForm() {                
                if (tenderSelect && tenderSelect.value) {
                    const tenderId = tenderSelect.value;
                    const tenderBidId = tenderBidSelect?.value;
                    
                    // Load tender bids and set selection
                    loadTenderBids(tenderId, tenderBidId);
                    
                    // Auto-fill amount on page load
                    setTimeout(() => {
                        autoFillAmount();
                    }, 500);
                }
            }
            
            // Initialize form on page load with delay to ensure DOM is ready
            setTimeout(() => {
                initializeForm();
            }, 100);
            
            // Load tender bids when tender selection changes
            tenderSelect.addEventListener('change', function() {
                // Clear validation error for tender select
                if (this.value) clearError(this);
                
                // Clear bidder info when tender changes
                bidderNameInput.value = '';
                companyNameInput.value = '';
                clearError(tenderBidSelect);
                loadTenderBids(this.value);
            });
            
            // Auto-fill amount when type changes
            typeSelect.addEventListener('change', function() {
                if (this.value) clearError(this);
                autoFillAmount();
            });

            // Clear status validation error when changed
            statusSelect.addEventListener('change', function() {
                if (this.value) clearError(this);
            });
            
            // Auto-fill bidder info when tender bid changes
            tenderBidSelect.addEventListener('change', function() {
                if (this.value) clearError(this);
                autoFillBidderInfo();
            });
        });
    </script>

    <style>
        .animate-spin {
            animation: spin 1s linear infinite;
        }
        
        @@keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
        
        .validation-message {
            display: block;
            margin-top: 0.25rem;
        }
    </style>
}