@model BiddingSystem.Controllers.PaymentViewModel
@{
    ViewData["Title"] = "Secure Payment";
    Layout = "~/Views/Shared/_PaymentLayout.cshtml";
}

<div class="min-h-screen bg-gray-50 flex flex-col justify-center py-12 sm:px-6 lg:px-8">
    <div class="sm:mx-auto sm:w-full sm:max-w-md">
        <div class="text-center">
            <img src="~/assets/img/FSSAI_Logo.png" alt="FSSAI Logo" class="mx-auto h-16 w-auto">
            <h2 class="mt-6 text-3xl font-bold text-gray-900">Secure Payment Portal</h2>
            <p class="mt-2 text-sm text-gray-600">Complete your payment for tender submission</p>
        </div>
    </div>

    <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-2xl">
        <div class="bg-white py-8 px-4 shadow sm:rounded-lg sm:px-10">
            <!-- Payment Information -->
            <div class="space-y-6">
                <!-- Tender Information -->
                <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
                    <h3 class="text-lg font-medium text-blue-900 mb-3">Tender Information</h3>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <span class="text-sm text-blue-700">Tender ID:</span>
                            <p class="text-sm font-medium text-blue-900">@Model.TenderId</p>
                        </div>
                        <div>
                            <span class="text-sm text-blue-700">Payment Type:</span>
                            <p class="text-sm font-medium text-blue-900">@Model.PaymentTypeDisplay</p>
                        </div>
                        <div class="col-span-2">
                            <span class="text-sm text-blue-700">Title:</span>
                            <p class="text-sm font-medium text-blue-900">@Model.TenderTitle</p>
                        </div>
                    </div>
                </div>

                <!-- Bidder Information -->
                <div class="bg-gray-50 border border-gray-200 rounded-lg p-4">
                    <h3 class="text-lg font-medium text-gray-900 mb-3">Bidder Information</h3>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <span class="text-sm text-gray-600">Name:</span>
                            <p class="text-sm font-medium text-gray-900" id="bidderName">@Model.BidderName</p>
                        </div>
                        <div>
                            <span class="text-sm text-gray-600">Email:</span>
                            <p class="text-sm font-medium text-gray-900" id="bidderEmail">@Model.BidderEmail</p>
                        </div>
                        <div>
                            <span class="text-sm text-gray-600">Phone:</span>
                            <p class="text-sm font-medium text-gray-900" id="bidderPhone">@Model.BidderPhone</p>
                        </div>
                        <div>
                            <span class="text-sm text-gray-600">Company:</span>
                            <p class="text-sm font-medium text-gray-900">@(string.IsNullOrEmpty(Model.CompanyName) ? "N/A" : Model.CompanyName)</p>
                        </div>
                    </div>
                </div>

                <!-- Payment Amount -->
                <div class="bg-green-50 border border-green-200 rounded-lg p-4">
                    <div class="flex justify-between items-center">
                        <div>
                            <h3 class="text-lg font-medium text-green-900">Amount to Pay</h3>
                            <p class="text-sm text-green-700 mt-1">Payment Link ID: @Model.LinkId</p>
                        </div>
                        <div class="text-right">
                            <p class="text-3xl font-bold text-green-900">@Model.AmountDisplay</p>
                            <p class="text-xs text-green-700 mt-1">Including all fees</p>
                        </div>
                    </div>
                </div>

                <!-- Payment Methods Available -->
                <div class="bg-white border border-gray-200 rounded-lg p-4">
                    <h4 class="text-sm font-medium text-gray-900 mb-3">Available Payment Methods</h4>
                    <div class="flex flex-wrap gap-2">
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                            <i class="ri-bank-card-line mr-1"></i> Credit/Debit Cards
                        </span>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800">
                            <i class="ri-smartphone-line mr-1"></i> UPI
                        </span>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                            <i class="ri-bank-line mr-1"></i> Net Banking
                        </span>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-800">
                            <i class="ri-wallet-line mr-1"></i> Wallets
                        </span>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-indigo-100 text-indigo-800">
                            <i class="ri-calendar-line mr-1"></i> EMI
                        </span>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-pink-100 text-pink-800">
                            <i class="ri-time-line mr-1"></i> Pay Later
                        </span>
                    </div>
                </div>

                <!-- Pay Button -->
                <div class="mt-6">
                    <button type="button" id="pay-button"
                            class="w-full flex justify-center items-center py-3 px-4 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition-all duration-200">
                        <i class="ri-secure-payment-line mr-2 text-lg"></i>
                        <span>Pay Now @Model.AmountDisplay</span>
                    </button>
                    <p class="text-center text-xs text-gray-500 mt-3">
                        <i class="ri-shield-check-line"></i> Secure payment powered by Razorpay
                    </p>
                </div>

                <!-- Important Notes -->
                <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4">
                    <div class="flex">
                        <div class="flex-shrink-0">
                            <i class="ri-information-line text-yellow-400 text-lg"></i>
                        </div>
                        <div class="ml-3">
                            <h3 class="text-sm font-medium text-yellow-800">Important Information</h3>
                            <div class="mt-2 text-sm text-yellow-700">
                                <ul class="list-disc list-inside space-y-1">
                                    <li>This payment link expires on @Model.ExpiryDate.ToString("dd MMM yyyy HH:mm")</li>
                                    <li>Keep your payment receipt for future reference</li>
                                    <li>Payment is non-refundable once processed</li>
                                    <li>For assistance, contact support with Link ID: @Model.LinkId</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- Razorpay Checkout Script -->
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
    // Payment configuration
    var paymentLinkId = @Model.PaymentLinkId;
    var customerEmail = "@Model.BidderEmail";
    var customerPhone = "@Model.BidderPhone";

    var options = {
        "key": "@Model.RazorpayKey",
        "amount": "@Model.RazorpayAmount",
        "currency": "INR",
        "name": "FSSAI Tender Payment",
        "description": "@Model.PaymentTypeDisplay - @Model.TenderTitle",
        "image": "/assets/img/FSSAI_Logo.png",
        "order_id": "@Model.RazorpayOrderId",

        // Handler for successful payment
        "handler": function (response) {
            // Get payment details from Razorpay
            fetchPaymentDetails(response);
        },

        // Prefill customer information
        "prefill": {
            "name": "@Model.BidderName",
            "email": "@Model.BidderEmail",
            "contact": "@Model.BidderPhone"
        },

        // Additional notes
        "notes": {
            "payment_link_id": "@Model.LinkId",
            "tender_id": "@Model.TenderId",
            "tender_bid_id": "@(Model.TenderBidId?.ToString() ?? "")",
            "payment_type": "@Model.PaymentType.ToString()"
        },

        // Theme customization
        "theme": {
            "color": "#059669"
        },

        // Modal configuration
        "modal": {
            "ondismiss": function () {
                showNotification('Payment cancelled', 'warning');
            }
        },

        // Enable method tracking
        "remember_customer": false
    };

    // Initialize Razorpay
    var rzp = new Razorpay(options);

    // Handle payment failures
    rzp.on('payment.failed', function (response) {
        console.error('Payment failed:', response.error);

        // Store failed transaction
        storeFailedTransaction(response);

        showNotification('Payment failed: ' + response.error.description, 'error');
        setTimeout(function () {
            window.location.href = '/Payment/Failed';
        }, 3000);
    });

    // Open payment on button click
    document.getElementById('pay-button').onclick = function (e) {
        e.preventDefault();

        this.disabled = true;
        this.innerHTML = '<i class="ri-loader-4-line animate-spin mr-2"></i> Opening Payment Gateway...';

        rzp.open();

        setTimeout(() => {
            this.disabled = false;
            this.innerHTML = '<i class="ri-secure-payment-line mr-2"></i> Pay Now @Model.AmountDisplay';
        }, 2000);
    }

    // Function to fetch payment details from Razorpay and verify
    async function fetchPaymentDetails(paymentResponse) {
        showNotification('Processing payment...', 'info');

        try {
            // Prepare verification data with all details
            const verificationData = {
                paymentLinkId: paymentLinkId,
                razorpayPaymentId: paymentResponse.razorpay_payment_id,
                razorpayOrderId: paymentResponse.razorpay_order_id,
                razorpaySignature: paymentResponse.razorpay_signature,

                // Customer details
                customerEmail: customerEmail,
                customerPhone: customerPhone,

                // Payment method will be populated by backend from Razorpay API
                paymentMethod: null
            };

            // Send verification request
            const response = await fetch('/Payment/VerifyPayment', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify(verificationData)
            });

            const data = await response.json();

            if (data.success) {
                showNotification('Payment successful! Redirecting...', 'success');

                // Store success in session storage for the success page
                sessionStorage.setItem('paymentSuccess', JSON.stringify({
                    paymentId: paymentResponse.razorpay_payment_id,
                    orderId: paymentResponse.razorpay_order_id,
                    linkId: '@Model.LinkId',
                    amount: '@Model.AmountDisplay',
                    timestamp: new Date().toISOString()
                }));

                // Redirect to success page
                window.location.href = '/Payment/Success?paymentId=' + paymentResponse.razorpay_payment_id + '&linkId=@Model.LinkId';
            } else {
                showNotification('Payment verification failed: ' + data.message, 'error');
                setTimeout(function () {
                    window.location.href = '/Payment/Failed';
                }, 3000);
            }
        } catch (error) {
            console.error('Error verifying payment:', error);
            showNotification('An error occurred during payment verification', 'error');

            // Still try to redirect to success if we have payment ID
            // Backend webhook will handle the actual verification
            if (paymentResponse.razorpay_payment_id) {
                setTimeout(function () {
                    window.location.href = '/Payment/Success?paymentId=' + paymentResponse.razorpay_payment_id + '&linkId=@Model.LinkId';
                }, 3000);
            }
        }
    }

    // Function to store failed transaction
    async function storeFailedTransaction(failedResponse) {
        try {
            const failedData = {
                paymentLinkId: paymentLinkId,
                errorCode: failedResponse.error.code,
                errorDescription: failedResponse.error.description,
                errorSource: failedResponse.error.source,
                errorStep: failedResponse.error.step,
                errorReason: failedResponse.error.reason,
                customerEmail: customerEmail,
                customerPhone: customerPhone
            };

            // Send failed transaction data to backend
            await fetch('/Payment/LogFailedTransaction', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify(failedData)
            });
        } catch (error) {
            console.error('Error logging failed transaction:', error);
        }
    }

    // Notification function
    function showNotification(message, type) {
        // Remove existing notifications
        const existingNotif = document.getElementById('notification');
        if (existingNotif) {
            existingNotif.remove();
        }

        // Create new notification
        const notif = document.createElement('div');
        notif.id = 'notification';
        notif.className = 'fixed top-4 right-4 z-50 p-4 rounded-lg shadow-lg flex items-center space-x-2 transition-all duration-300';

        // Set style based on type
        let icon = '';
        switch (type) {
            case 'success':
                notif.className += ' bg-green-100 text-green-800';
                icon = 'ri-checkbox-circle-line';
                break;
            case 'error':
                notif.className += ' bg-red-100 text-red-800';
                icon = 'ri-error-warning-line';
                break;
            case 'warning':
                notif.className += ' bg-yellow-100 text-yellow-800';
                icon = 'ri-alert-line';
                break;
            default:
                notif.className += ' bg-blue-100 text-blue-800';
                icon = 'ri-information-line';
        }

        notif.innerHTML = `<i class="${icon} text-lg"></i><span>${message}</span>`;
        document.body.appendChild(notif);

        // Auto remove after 5 seconds
        setTimeout(() => {
            if (notif.parentNode) {
                notif.remove();
            }
        }, 5000);
    }

</script>
