@using BiddingSystem.ViewModels
@model PaginatedList<BiddingSystem.ViewModels.PaymentTransactionViewModel>
@{
    ViewData["Title"] = "Payment Transactions";
    var statistics = ViewBag.Statistics as BiddingSystem.ViewModels.TransactionStatistics;
    var filter = ViewBag.Filter as BiddingSystem.ViewModels.PaymentTransactionSearchFilter;
}

<div class="px-4 sm:px-6 lg:px-8">
    <!-- Page Header -->
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-900">Payment Transactions</h1>
    </div>

    <!-- Statistics Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
        <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center">
                <div class="flex-shrink-0 bg-green-100 rounded-lg p-3">
                    <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                </div>
                <div class="ml-4">
                    <p class="text-sm font-medium text-gray-500">Successful</p>
                    <p class="text-2xl font-semibold text-gray-900">@statistics?.SuccessfulTransactions</p>
                    <p class="text-sm text-gray-600">₹@statistics?.SuccessfulAmount.ToString("N2")</p>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center">
                <div class="flex-shrink-0 bg-red-100 rounded-lg p-3">
                    <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                </div>
                <div class="ml-4">
                    <p class="text-sm font-medium text-gray-500">Failed</p>
                    <p class="text-2xl font-semibold text-gray-900">@statistics?.FailedTransactions</p>
                    <p class="text-sm text-gray-600">₹@statistics?.FailedAmount.ToString("N2")</p>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center">
                <div class="flex-shrink-0 bg-blue-100 rounded-lg p-3">
                    <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                    </svg>
                </div>
                <div class="ml-4">
                    <p class="text-sm font-medium text-gray-500">Refunded</p>
                    <p class="text-2xl font-semibold text-gray-900">@statistics?.RefundedTransactions</p>
                    <p class="text-sm text-gray-600">₹@statistics?.RefundedAmount.ToString("N2")</p>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center">
                <div class="flex-shrink-0 bg-indigo-100 rounded-lg p-3">
                    <svg class="w-6 h-6 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                </div>
                <div class="ml-4">
                    <p class="text-sm font-medium text-gray-500">Today</p>
                    <p class="text-2xl font-semibold text-gray-900">@statistics?.TodayTransactions</p>
                    <p class="text-sm text-gray-600">₹@statistics?.TodayAmount.ToString("N2")</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Search Filters -->
    <div class="bg-white rounded-lg shadow mb-6">
        <div class="p-6">
            <h2 class="text-lg font-semibold mb-4">Search Filters</h2>
            <form id="searchForm" onsubmit="searchTransactions(event)">
                <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-4">
                    <!-- Row 1 -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Tender ID</label>
                        <input type="text" name="TenderId" id="TenderId"
                               class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Tender Name</label>
                        <input type="text" name="TenderName" id="TenderName"
                               class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Bidder Name</label>
                        <input type="text" name="BidderName" id="BidderName"
                               class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Payment ID</label>
                        <input type="text" name="RazorpayPaymentId" id="RazorpayPaymentId"
                               class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" />
                    </div>

                    <!-- Row 2 -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Status</label>
                        <select name="Status" id="Status"
                                class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent">
                            <option value="">All</option>
                            <option value="Success">Success</option>
                            <option value="Failed">Failed</option>
                            <option value="Pending">Pending</option>
                            <option value="Refunded">Refunded</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Payment Type</label>
                        <select name="PaymentType" id="PaymentType"
                                class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent">
                            <option value="">All</option>
                            @foreach (PaymentType type in Enum.GetValues(typeof(PaymentType)))
                            {
                                <option value="@((int)type)">@type.ToString()</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">From Date</label>
                        <input type="date" name="FromDate" id="FromDate"
                               class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">To Date</label>
                        <input type="date" name="ToDate" id="ToDate"
                               class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" />
                    </div>

                    <!-- Row 3 -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Customer Email</label>
                        <input type="email" name="CustomerEmail" id="CustomerEmail"
                               class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Customer Phone</label>
                        <input type="text" name="CustomerPhone" id="CustomerPhone"
                               class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Payment Method</label>
                        <select name="PaymentMethod" id="PaymentMethod"
                                class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent">
                            <option value="">All</option>
                            <option value="card">Card</option>
                            <option value="netbanking">Net Banking</option>
                            <option value="upi">UPI</option>
                            <option value="wallet">Wallet</option>
                            <option value="REFUND">Refund</option>
                        </select>
                    </div>
                </div>

                <!-- Buttons -->
                <div class="mt-6 flex gap-3">
                    <button type="submit"
                            class="inline-flex items-center px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-md transition duration-150 ease-in-out">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                        Search
                    </button>
                    <button type="button" onclick="clearFilters()"
                            class="inline-flex items-center px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium rounded-md transition duration-150 ease-in-out">
                        Clear
                    </button>
                    <button type="button" onclick="exportTransactions()"
                            class="inline-flex items-center px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium rounded-md transition duration-150 ease-in-out">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                        </svg>
                        Export CSV
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Transaction List -->
    <div id="transactionListContainer">
        @await Html.PartialAsync("_TransactionListPartial", Model)
    </div>
</div>

<!-- Transaction Details Modal (Tailwind CSS) -->
<div id="transactionDetailsModal" class="fixed inset-0 z-50 hidden overflow-y-auto">
    <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:block sm:p-0">
        <!-- Background overlay -->
        <div class="fixed inset-0 transition-opacity bg-gray-500 bg-opacity-75" onclick="closeTransactionModal()"></div>

        <!-- Modal panel -->
        <div class="inline-block w-full max-w-3xl my-8 overflow-hidden text-left align-middle transition-all transform bg-white rounded-lg shadow-xl">
            <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-lg font-medium text-gray-900">Transaction Details</h3>
                    <button onclick="closeTransactionModal()" class="text-gray-400 hover:text-gray-500">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                    </button>
                </div>
                <div id="transactionDetailsContent" class="mt-4">
                    <!-- Content loaded via AJAX -->
                </div>
            </div>
            <div class="bg-gray-50 px-4 py-3 sm:px-6 sm:flex sm:flex-row-reverse">
                <button type="button" onclick="closeTransactionModal()"
                        class="w-full inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-4 py-2 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 sm:ml-3 sm:w-auto sm:text-sm">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentPage = 1;

        function searchTransactions(event) {
            event.preventDefault();
            currentPage = 1;
            loadTransactions();
        }

        function loadTransactions(page = null) {
            if (page) currentPage = page;

            const formData = new FormData(document.getElementById('searchForm'));
            formData.append('PageNumber', currentPage);
            formData.append('PageSize', 10);

            fetch('@Url.Action("SearchTransactions", "Payment")', {
                method: 'POST',
                body: formData
            })
                .then(response => response.text())
                .then(html => {
                    document.getElementById('transactionListContainer').innerHTML = html;
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('An error occurred while searching transactions');
                });
        }

        function clearFilters() {
            document.getElementById('searchForm').reset();
            currentPage = 1;
            loadTransactions();
        }

        function exportTransactions() {
            const formData = new FormData(document.getElementById('searchForm'));
            const params = new URLSearchParams(formData).toString();
            window.location.href = '@Url.Action("ExportTransactions", "Payment")?' + params;
        }

        function viewTransactionDetails(transactionId) {
            fetch('@Url.Action("TransactionDetails", "Payment")/' + transactionId)
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        displayTransactionDetails(data.data);
                        openTransactionModal();
                    } else {
                        alert('Error loading transaction details');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('An error occurred while loading transaction details');
                });
        }

        function displayTransactionDetails(transaction) {
            const html = `
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <div class="mb-3">
                                    <span class="text-sm font-medium text-gray-500">Transaction ID:</span>
                                    <p class="text-sm text-gray-900">${transaction.id}</p>
                                </div>
                                <div class="mb-3">
                                    <span class="text-sm font-medium text-gray-500">Payment Link ID:</span>
                                    <p class="text-sm text-gray-900">${transaction.paymentLinkId || 'N/A'}</p>
                                </div>
                                <div class="mb-3">
                                    <span class="text-sm font-medium text-gray-500">Razorpay Payment ID:</span>
                                    <p class="text-sm text-gray-900 font-mono">${transaction.razorpayPaymentId || 'N/A'}</p>
                                </div>
                                <div class="mb-3">
                                    <span class="text-sm font-medium text-gray-500">Razorpay Order ID:</span>
                                    <p class="text-sm text-gray-900 font-mono">${transaction.razorpayOrderId || 'N/A'}</p>
                                </div>
                                <div class="mb-3">
                                    <span class="text-sm font-medium text-gray-500">Amount:</span>
                                    <p class="text-lg font-semibold text-gray-900">₹${transaction.amount.toFixed(2)}</p>
                                </div>
                                <div class="mb-3">
                                    <span class="text-sm font-medium text-gray-500">Status:</span>
                                    <p><span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full ${getStatusClass(transaction.status)}">${transaction.status}</span></p>
                                </div>
                                <div class="mb-3">
                                    <span class="text-sm font-medium text-gray-500">Payment Type:</span>
                                    <p class="text-sm text-gray-900">${transaction.paymentTypeDisplay}</p>
                                </div>
                            </div>
                            <div>
                                <div class="mb-3">
                                    <span class="text-sm font-medium text-gray-500">Payment Method:</span>
                                    <p class="text-sm text-gray-900">${transaction.paymentMethodDisplay}</p>
                                </div>
                                <div class="mb-3">
                                    <span class="text-sm font-medium text-gray-500">Transaction Date:</span>
                                    <p class="text-sm text-gray-900">${new Date(transaction.transactionDate).toLocaleString()}</p>
                                </div>
                                <div class="mb-3">
                                    <span class="text-sm font-medium text-gray-500">Customer Email:</span>
                                    <p class="text-sm text-gray-900">${transaction.customerEmail || 'N/A'}</p>
                                </div>
                                <div class="mb-3">
                                    <span class="text-sm font-medium text-gray-500">Customer Phone:</span>
                                    <p class="text-sm text-gray-900">${transaction.customerPhone || 'N/A'}</p>
                                </div>
                                <div class="mb-3">
                                    <span class="text-sm font-medium text-gray-500">Tender ID:</span>
                                    <p class="text-sm text-gray-900">${transaction.tenderIdString || 'N/A'}</p>
                                </div>
                                <div class="mb-3">
                                    <span class="text-sm font-medium text-gray-500">Bidder Name:</span>
                                    <p class="text-sm text-gray-900">${transaction.bidderName || 'N/A'}</p>
                                </div>
                                ${transaction.errorDescription ? `
                                <div class="mb-3">
                                    <span class="text-sm font-medium text-gray-500">Error:</span>
                                    <p class="text-sm text-red-600">${transaction.errorDescription}</p>
                                </div>` : ''}
                            </div>
                        </div>
                    `;
            document.getElementById('transactionDetailsContent').innerHTML = html;
        }

        function getStatusClass(status) {
            switch (status?.toLowerCase()) {
                case 'success': return 'bg-green-100 text-green-800';
                case 'failed': return 'bg-red-100 text-red-800';
                case 'pending': return 'bg-yellow-100 text-yellow-800';
                case 'refunded': return 'bg-blue-100 text-blue-800';
                default: return 'bg-gray-100 text-gray-800';
            }
        }

        function openTransactionModal() {
            document.getElementById('transactionDetailsModal').classList.remove('hidden');
        }

        function closeTransactionModal() {
            document.getElementById('transactionDetailsModal').classList.add('hidden');
        }
    </script>
}