@using BiddingSystem.ViewModels
@model PaginatedList<BiddingSystem.ViewModels.PaymentTransactionViewModel>

<div class="bg-white rounded-lg shadow overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-200">
        <div class="flex justify-between items-center">
            <h3 class="text-lg font-semibold text-gray-900">Transaction List</h3>
            <span class="text-sm text-gray-500">Total: @Model.TotalCount transactions</span>
        </div>
    </div>

    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">#</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Payment ID</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tender ID</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Bidder</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Method</th>
                    <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Customer</th>
                    <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                @if (Model.Items.Any())
                {
                    var rowNumber = (Model.CurrentPage - 1) * Model.PageSize;
                    @foreach (var transaction in Model.Items)
                    {
                        rowNumber++;
                        <tr class="hover:bg-gray-50 transition-colors duration-150">
                            <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-900">
                                @rowNumber
                            </td>
                            <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-900">
                                <div>
                                    <div class="text-sm font-medium">@transaction.TransactionDate.ToString("dd MMM yyyy")</div>
                                    <div class="text-xs text-gray-500">@transaction.TransactionDate.ToString("HH:mm:ss")</div>
                                </div>
                            </td>
                            <td class="px-4 py-3 text-sm text-gray-900">
                                @if (!string.IsNullOrEmpty(transaction.RazorpayPaymentId))
                                {
                                    <span class="font-mono text-xs text-blue-600 hover:text-blue-800 cursor-pointer"
                                          title="@transaction.RazorpayPaymentId"
                                          onclick="copyToClipboard('@transaction.RazorpayPaymentId')">
                                        @(transaction.RazorpayPaymentId.Length > 20 ? transaction.RazorpayPaymentId.Substring(0, 20) + "..." : transaction.RazorpayPaymentId)
                                    </span>
                                }
                                else
                                {
                                    <span class="text-gray-400">N/A</span>
                                }
                            </td>
                            <td class="px-4 py-3 whitespace-nowrap text-sm">
                                @if (!string.IsNullOrEmpty(transaction.TenderIdString))
                                {
                                    <span class="font-medium text-indigo-600">@transaction.TenderIdString</span>
                                }
                                else
                                {
                                    <span class="text-gray-400">N/A</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-sm text-gray-900">
                                @if (!string.IsNullOrEmpty(transaction.BidderName))
                                {
                                    <div>
                                        <div class="font-medium">@transaction.BidderName</div>
                                        @if (!string.IsNullOrEmpty(transaction.CompanyName))
                                        {
                                            <div class="text-xs text-gray-500">@transaction.CompanyName</div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-gray-400">N/A</span>
                                }
                            </td>
                            <td class="px-4 py-3 whitespace-nowrap text-sm">
                                @if (transaction.PaymentType.HasValue)
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-indigo-100 text-indigo-800">
                                        @transaction.PaymentTypeDisplay
                                    </span>
                                }
                                else
                                {
                                    <span class="text-gray-400">-</span>
                                }
                            </td>
                            <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-900">
                                <span title="@transaction.PaymentMethodDisplay">
                                    @(transaction.PaymentMethodDisplay.Length > 15 ? transaction.PaymentMethodDisplay.Substring(0, 15) + "..." : transaction.PaymentMethodDisplay)
                                </span>
                            </td>
                            <td class="px-4 py-3 whitespace-nowrap text-sm text-right">
                                @if (transaction.Amount < 0)
                                {
                                    <span class="text-red-600 font-medium">-₹@Math.Abs(transaction.Amount).ToString("N2")</span>
                                }
                                else
                                {
                                    <span class="text-gray-900 font-medium">₹@transaction.Amount.ToString("N2")</span>
                                }
                            </td>
                            <td class="px-4 py-3 whitespace-nowrap">
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium @transaction.StatusClass">
                                    @transaction.Status
                                </span>
                                @if (!string.IsNullOrEmpty(transaction.ErrorCode))
                                {
                                    <span class="block text-xs text-red-500 mt-1" title="@transaction.ErrorDescription">
                                        Error: @transaction.ErrorCode
                                    </span>
                                }
                            </td>
                            <td class="px-4 py-3 text-sm text-gray-900">
                                @if (!string.IsNullOrEmpty(transaction.CustomerEmail) || !string.IsNullOrEmpty(transaction.CustomerPhone))
                                {
                                    <div>
                                        @if (!string.IsNullOrEmpty(transaction.CustomerEmail))
                                        {
                                            <div class="text-xs truncate max-w-[150px]" title="@transaction.CustomerEmail">
                                                @transaction.CustomerEmail
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(transaction.CustomerPhone))
                                        {
                                            <div class="text-xs text-gray-500">@transaction.CustomerPhone</div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-gray-400 text-xs">N/A</span>
                                }
                            </td>
                            <td class="px-4 py-3 whitespace-nowrap text-center">
                                <button onclick="viewTransactionDetails(@transaction.Id)"
                                        class="inline-flex items-center p-1 border border-transparent rounded-full text-indigo-600 hover:bg-indigo-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500"
                                        title="View Details">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                    </svg>
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="11" class="px-6 py-12 text-center">
                            <div class="flex flex-col items-center">
                                <svg class="w-12 h-12 text-gray-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                                </svg>
                                <p class="text-gray-500 text-sm">No transactions found</p>
                                <p class="text-gray-400 text-xs mt-1">Try adjusting your search filters</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="bg-white px-4 py-3 border-t border-gray-200 sm:px-6">
            <div class="flex items-center justify-between">
                <div class="text-sm text-gray-700">
                    Showing
                    <span class="font-medium">@((Model.CurrentPage - 1) * Model.PageSize + 1)</span>
                    to
                    <span class="font-medium">@Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount)</span>
                    of
                    <span class="font-medium">@Model.TotalCount</span>
                    results
                </div>
                <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px">
                    <!-- Previous Page -->
                    <button onclick="loadTransactions(@(Model.CurrentPage - 1))"
                    @(Model.CurrentPage == 1 ? "disabled" : "")
                            class="@(Model.CurrentPage == 1 ? "cursor-not-allowed opacity-50" : "hover:bg-gray-50") relative inline-flex items-center px-2 py-2 rounded-l-md border border-gray-300 bg-white text-sm font-medium text-gray-500">
                        <span class="sr-only">Previous</span>
                        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
                        </svg>
                    </button>

                    <!-- Page Numbers -->
                    @{
                        var startPage = Math.Max(1, Model.CurrentPage - 2);
                        var endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
                    }

                    @if (startPage > 1)
                    {
                        <button onclick="loadTransactions(1)"
                                class="relative inline-flex items-center px-4 py-2 border border-gray-300 bg-white text-sm font-medium text-gray-700 hover:bg-gray-50">
                            1
                        </button>
                        @if (startPage > 2)
                        {
                            <span class="relative inline-flex items-center px-4 py-2 border border-gray-300 bg-white text-sm font-medium text-gray-700">
                                ...
                            </span>
                        }
                    }

                    @for (var i = startPage; i <= endPage; i++)
                    {
                        var pageNum = i;
                        <button onclick="loadTransactions(@pageNum)"
                                class="@(i == Model.CurrentPage ? "z-10 bg-indigo-50 border-indigo-500 text-indigo-600" : "bg-white border-gray-300 text-gray-500 hover:bg-gray-50") relative inline-flex items-center px-4 py-2 border text-sm font-medium">
                            @i
                        </button>
                    }

                    @if (endPage < Model.TotalPages)
                    {
                        @if (endPage < Model.TotalPages - 1)
                        {
                            <span class="relative inline-flex items-center px-4 py-2 border border-gray-300 bg-white text-sm font-medium text-gray-700">
                                ...
                            </span>
                        }
                        <button onclick="loadTransactions(@Model.TotalPages)"
                                class="relative inline-flex items-center px-4 py-2 border border-gray-300 bg-white text-sm font-medium text-gray-700 hover:bg-gray-50">
                            @Model.TotalPages
                        </button>
                    }

                    <!-- Next Page -->
                    <button onclick="loadTransactions(@(Model.CurrentPage + 1))"
                    @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")
                            class="@(Model.CurrentPage == Model.TotalPages ? "cursor-not-allowed opacity-50" : "hover:bg-gray-50") relative inline-flex items-center px-2 py-2 rounded-r-md border border-gray-300 bg-white text-sm font-medium text-gray-500">
                        <span class="sr-only">Next</span>
                        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                        </svg>
                    </button>
                </nav>
            </div>
        </div>
    }
</div>

<script>
    function copyToClipboard(text) {
        navigator.clipboard.writeText(text).then(function () {
            // You can show a toast notification here if needed
            console.log('Copied to clipboard: ' + text);
        }, function (err) {
            console.error('Could not copy text: ', err);
        });
    }
</script>