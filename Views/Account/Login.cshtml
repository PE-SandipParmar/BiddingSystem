@model BiddingSystem.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | FSSAI BiddingSystem</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/4.6.0/remixicon.min.css" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com/3.4.16"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#3b82f6',
                        secondary: '#64748B',
                        success: '#22c55e',
                        warning: '#eab308',
                        danger: '#ef4444',
                        fssai: {
                            50: '#eff6ff',
                            100: '#dbeafe',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8',
                            800: '#1e40af',
                            900: '#1e3a8a'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'system-ui', 'sans-serif'],
                    },
                    animation: {
                        'fade-in': 'fadeIn 0.5s ease-in-out',
                        'slide-up': 'slideUp 0.5s ease-out',
                        'pulse-slow': 'pulse 3s cubic-bezier(0.4, 0, 0.6, 1) infinite',
                    }
                }
            }
        }
    </script>
    <style>
        @@keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }
        
        @@keyframes slideUp {
            from { 
                opacity: 0;
                transform: translateY(20px);
            }
            to { 
                opacity: 1;
                transform: translateY(0);
            }
        }

        .form-checkbox {
            appearance: none;
            background-color: #fff;
            margin: 0;
            color: #3b82f6;
            width: 1rem;
            height: 1rem;
            border: 1px solid #d1d5db;
            border-radius: 0.25rem;
            display: grid;
            place-content: center;
            transition: all 0.2s ease;
        }

        .form-checkbox:checked {
            background-color: #3b82f6;
            border-color: #3b82f6;
        }

        .form-checkbox:checked::before {
            content: "✓";
            color: white;
            font-size: 0.75rem;
            line-height: 1;
        }

        .spinner {
            width: 20px;
            height: 20px;
            border: 2px solid #ffffff;
            border-top: 2px solid transparent;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        @@keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .glass-effect {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .gradient-bg {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

        .fssai-gradient {
            background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
        }

        .input-focus:focus {
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
            border-color: #3b82f6;
        }

        .btn-primary {
            background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
            transition: all 0.3s ease;
        }

        .btn-primary:hover {
            background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
            transform: translateY(-1px);
            box-shadow: 0 10px 25px rgba(59, 130, 246, 0.3);
        }

        .floating-animation {
            animation: float 6s ease-in-out infinite;
        }

        @@keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-20px); }
        }
    </style>
</head>

<body class="min-h-screen bg-gray-50">
    <!-- Background Pattern -->
    <div class="absolute inset-0 bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50"></div>
    <div class="absolute inset-0 bg-[url('data:image/svg+xml,%3Csvg width="60" height="60" viewBox="0 0 60 60" xmlns="http://www.w3.org/2000/svg"%3E%3Cg fill="none" fill-rule="evenodd"%3E%3Cg fill="%239C92AC" fill-opacity="0.05"%3E%3Ccircle cx="30" cy="30" r="2"/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')] opacity-40"></div>
    
    <div class="relative min-h-screen flex">
        <!-- Left: Branding & Illustration -->
        <div class="hidden lg:flex lg:w-1/2 fssai-gradient flex-col items-center justify-center text-white p-12 relative overflow-hidden">
            <!-- Background Elements -->
            <div class="absolute top-0 left-0 w-full h-full">
                <div class="absolute top-20 left-20 w-32 h-32 bg-white opacity-10 rounded-full floating-animation"></div>
                <div class="absolute bottom-20 right-20 w-24 h-24 bg-white opacity-10 rounded-full floating-animation" style="animation-delay: -2s;"></div>
                <div class="absolute top-1/2 left-10 w-16 h-16 bg-white opacity-10 rounded-full floating-animation" style="animation-delay: -4s;"></div>
            </div>
            
            <!-- Content -->
            <div class="relative z-10 text-center animate-fade-in">
                <!-- FSSAI Logo -->
                <div class="mb-8">
                    <img src="~/assets/img/FSSAI_Logo.png" alt="FSSAI Logo" class="h-24 mx-auto mb-4 drop-shadow-lg" />
                    <img src="~/assets/img/Loginpage.svg" alt="Login Illustration" class="w-[600px] md:w-[720px] max-w-full h-auto" />

                </div>
                
                <!-- Features -->
                
            </div>
        </div>

        <!-- Right: Login Form -->
        <div class="flex flex-1 flex-col justify-center items-center p-8 min-h-screen">
            <div class="w-full max-w-md">
                <!-- Mobile Logo -->
                <div class="lg:hidden flex flex-col items-center mb-8 animate-slide-up">
                    <img src="~/assets/img/FSSAI_Logo.png" alt="FSSAI Logo" class="h-16 mb-4" />
                    <h1 class="text-2xl font-bold text-gray-800 mb-1">FSSAI BiddingSystem</h1>
                    <p class="text-gray-500 text-sm text-center">Food Safety and Standards Authority of India</p>
                </div>

                <!-- Login Form Card -->
                <div class="glass-effect rounded-2xl shadow-2xl p-8 animate-slide-up">
                    <div class="text-center mb-8">
                        <h2 class="text-2xl font-bold text-gray-800 mb-2">Welcome Back</h2>
                        <p class="text-gray-500">Sign in to your account to continue</p>
                    </div>

                    <form asp-action="Login" method="post" class="space-y-6" id="loginForm">
                        <input type="hidden" asp-for="ReturnUrl" />
                        
                        <!-- Validation Summary -->
                        <div asp-validation-summary="ModelOnly" class="hidden bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-4" role="alert" id="validationSummary"></div>

                        <!-- Username Field -->
                        <div class="space-y-2">
                            <label asp-for="Username" class="block text-sm font-semibold text-gray-700">Email or Username</label>
                            <div class="relative group">
                                <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-gray-400 group-focus-within:text-primary transition-colors">
                                    <i class="ri-user-line text-lg"></i>
                                </span>
                                <input asp-for="Username" type="text"
                                       class="input-focus pl-12 pr-4 py-3 w-full border border-gray-200 rounded-xl bg-gray-50 focus:bg-white transition-all duration-200 text-gray-800 placeholder-gray-400"
                                       placeholder="Enter your email or username" autofocus />
                            </div>
                            <span asp-validation-for="Username" class="text-red-500 text-sm flex items-center">
                              
                            </span>

                        </div>

                        <!-- Password Field -->
                        <div class="space-y-2">
                            <label asp-for="Password" class="block text-sm font-semibold text-gray-700">Password</label>
                            <div class="relative group">
                                <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-gray-400 group-focus-within:text-primary transition-colors">
                                    <i class="ri-lock-2-line text-lg"></i>
                                </span>
                                <input asp-for="Password" type="password" id="passwordField"
                                       class="input-focus pl-12 pr-12 py-3 w-full border border-gray-200 rounded-xl bg-gray-50 focus:bg-white transition-all duration-200 text-gray-800 placeholder-gray-400"
                                       placeholder="Enter your password" />
                                <span class="absolute inset-y-0 right-0 flex items-center pr-4 text-gray-400 hover:text-primary cursor-pointer transition-colors" id="togglePassword">
                                    <i class="ri-eye-line text-lg" id="eyeIcon"></i>
                                </span>
                            </div>
                            <span asp-validation-for="Password" class="text-red-500 text-sm flex items-center">
                              
                              
                            </span>
                        </div>

                        <!-- Remember Me & Forgot Password -->
                        <div class="flex items-center justify-between pt-2">
                            <label class="flex items-center cursor-pointer group">
                                <input asp-for="RememberMe" type="checkbox" class="form-checkbox h-4 w-4 text-primary" />
                                <span class="ml-3 text-sm text-gray-600 group-hover:text-gray-800 transition-colors">Remember me</span>
                            </label>
                            <a asp-action="ForgotPassword" class="text-sm text-primary hover:text-primary-600 font-medium transition-colors flex items-center">
                                <i class="ri-lock-unlock-line mr-1"></i>
                                Forgot Password?
                            </a>
                        </div>

                        <!-- Submit Button -->
                        <button type="submit" id="loginButton"
                                class="btn-primary w-full text-white py-3 rounded-xl font-semibold text-lg flex items-center justify-center shadow-lg">
                            <span id="buttonText">Sign In</span>
                            <div id="buttonSpinner" class="spinner ml-2 hidden"></div>
                        </button>
                    </form>

                    <!-- Additional Info -->
                    <div class="mt-8 pt-6 border-t border-gray-200">
                        <div class="text-center">
                            <p class="text-sm text-gray-500 mb-4">Need help accessing your account?</p>
                            <div class="flex justify-center space-x-6 text-sm">
                                <a href="#" class="text-primary hover:text-primary-600 font-medium transition-colors">
                                    <i class="ri-phone-line mr-1"></i>
                                    Contact Support
                                </a>
                                <a href="#" class="text-primary hover:text-primary-600 font-medium transition-colors">
                                    <i class="ri-question-line mr-1"></i>
                                    Help Center
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function() {
            // Add entrance animations
            $('.animate-fade-in').css('opacity', '0').animate({ opacity: 1 }, 800);
            $('.animate-slide-up').css({ opacity: 0, transform: 'translateY(30px)' }).animate({ 
                opacity: 1, 
                transform: 'translateY(0)' 
            }, 600);

            // Password visibility toggle with enhanced UX
            $('#togglePassword').click(function() {
                const passwordField = $('#passwordField');
                const eyeIcon = $('#eyeIcon');
                
                if (passwordField.attr('type') === 'password') {
                    passwordField.attr('type', 'text');
                    eyeIcon.removeClass('ri-eye-line').addClass('ri-eye-off-line');
                    $(this).attr('title', 'Hide password');
                } else {
                    passwordField.attr('type', 'password');
                    eyeIcon.removeClass('ri-eye-off-line').addClass('ri-eye-line');
                    $(this).attr('title', 'Show password');
                }
            });

            // Enhanced form submission with better UX
            $('#loginForm').submit(function(e) {
                const button = $('#loginButton');
                const buttonText = $('#buttonText');
                const buttonSpinner = $('#buttonSpinner');
                
                // Disable button and show loader
                button.prop('disabled', true);
                button.addClass('opacity-75 cursor-not-allowed');
                buttonText.text('Signing in...');
                buttonSpinner.removeClass('hidden');
                
                // Add loading state to form
                $(this).addClass('opacity-75');
                
                // Don't prevent default form submission - let MVC handle it
                return true;
            });

            // Show validation summary if it has content
            const validationSummary = $('#validationSummary');
            if (validationSummary.children().length > 0) {
                validationSummary.removeClass('hidden').hide().slideDown(300);
            }

            // Re-enable button if there are validation errors (page didn't redirect)
            if ($('.text-red-500:visible').length > 0 || validationSummary.is(':visible')) {
                setTimeout(function() {
                    const button = $('#loginButton');
                    const buttonText = $('#buttonText');
                    const buttonSpinner = $('#buttonSpinner');
                    const form = $('#loginForm');
                    
                    button.prop('disabled', false);
                    button.removeClass('opacity-75 cursor-not-allowed');
                    buttonText.text('Sign In');
                    buttonSpinner.addClass('hidden');
                    form.removeClass('opacity-75');
                }, 100);
            }

            // Enhanced input focus effects
            $('input').on('focus', function() {
                $(this).parent().addClass('ring-2 ring-primary ring-opacity-20');
            }).on('blur', function() {
                $(this).parent().removeClass('ring-2 ring-primary ring-opacity-20');
            });

            // Add keyboard navigation
            $(document).keydown(function(e) {
                if (e.key === 'Enter' && !$('#loginButton').prop('disabled')) {
                    $('#loginForm').submit();
                }
            });

            // Add accessibility improvements
            $('input').attr('autocomplete', 'username');
            $('#passwordField').attr('autocomplete', 'current-password');
        });
    </script>
</body>
</html>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}