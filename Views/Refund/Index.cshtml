@model BiddingSystem.ViewModels.RefundRequestListViewModel
@{
    ViewData["Title"] = "Refund Management";
}

<div class="container mx-auto px-4 py-6">
    <!-- Header -->
    <div class="flex justify-between items-center mb-6">
        <div>
            <h1 class="text-3xl font-bold text-gray-900">Refund Management</h1>
            <p class="text-gray-600 mt-1">Manage and process refund requests</p>
        </div>
        <div>
            <a href="@Url.Action("Create")" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg inline-flex items-center transition-colors">
                <i class="ri-add-line mr-2"></i>New Refund Request
            </a>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-6">
        <div class="bg-white rounded-lg shadow-md p-6 border-l-4 border-blue-500">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-500 uppercase tracking-wide">Total Requests</p>
                    <p class="text-2xl font-bold text-gray-900">@Model.TotalCount</p>
                </div>
                <div class="flex-shrink-0">
                    <i class="ri-file-list-3-line text-3xl text-gray-300"></i>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow-md p-6 border-l-4 border-yellow-500">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-500 uppercase tracking-wide">Pending</p>
                    <p class="text-2xl font-bold text-gray-900">@(Model.StatusCounts.GetValueOrDefault(BiddingSystem.Models.RefundStatus.Pending, 0))</p>
                </div>
                <div class="flex-shrink-0">
                    <i class="ri-time-line text-3xl text-gray-300"></i>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow-md p-6 border-l-4 border-green-500">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-500 uppercase tracking-wide">Completed</p>
                    <p class="text-2xl font-bold text-gray-900">@(Model.StatusCounts.GetValueOrDefault(BiddingSystem.Models.RefundStatus.Completed, 0))</p>
                </div>
                <div class="flex-shrink-0">
                    <i class="ri-check-line text-3xl text-gray-300"></i>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow-md p-6 border-l-4 border-red-500">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-500 uppercase tracking-wide">Rejected</p>
                    <p class="text-2xl font-bold text-gray-900">@(Model.StatusCounts.GetValueOrDefault(BiddingSystem.Models.RefundStatus.Rejected, 0))</p>
                </div>
                <div class="flex-shrink-0">
                    <i class="ri-close-line text-3xl text-gray-300"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="bg-white rounded-lg shadow-md p-6 mb-6">
        <form method="get" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Search</label>
                <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" 
                       placeholder="Search by ID or email..." 
                       class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Status</label>
                <select name="status" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <option value="">All Statuses</option>
                    @foreach (var status in Model.AvailableStatuses)
                    {
                        var isSelected = ViewBag.Status?.ToString() == status.ToString();
                        <option value="@status" selected="@isSelected">@@status.GetDisplayName()</option>
                    }
                </select>
            </div>
            
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Type</label>
                <select name="type" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <option value="">All Types</option>
                    @foreach (var type in Model.AvailableTypes)
                    {
                        var isSelected = ViewBag.Type?.ToString() == type.ToString();
                        <option value="@type" selected="@isSelected">@@type.GetDisplayName()</option>
                    }
                </select>
            </div>
            
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Reason</label>
                <select name="reason" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <option value="">All Reasons</option>
                    @foreach (var reason in Model.AvailableReasons)
                    {
                        var isSelected = ViewBag.Reason?.ToString() == reason.ToString();
                        <option value="@reason" selected="@isSelected">@@reason.GetDisplayName()</option>
                    }
                </select>
            </div>
            
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">From Date</label>
                <input type="date" name="fromDate" value="@ViewBag.FromDate?.ToString("yyyy-MM-dd")" 
                       class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            
            <div class="flex items-end">
                <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-md transition-colors">
                    <i class="ri-search-line mr-2"></i>Filter
                </button>
            </div>
        </form>
    </div>

    <!-- Refund Requests Table -->
    <div class="bg-white rounded-lg shadow-md overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200">
            <h3 class="text-lg font-medium text-gray-900">Refund Requests</h3>
        </div>
        
        @if (Model.RefundRequests.Any())
        {
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Refund ID</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Requested By</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Requested Date</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        @foreach (var refund in Model.RefundRequests)
                        {
                            <tr class="hover:bg-gray-50">
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <a href="@Url.Action("Details", new { id = refund.Id })" class="text-blue-600 hover:text-blue-800 font-medium">
                                        @refund.RefundId
                                    </a>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                        @refund.TypeDisplayName
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="text-sm font-medium text-gray-900">@refund.RequestedAmountDisplay</div>
                                    @if (refund.ApprovedAmount.HasValue && refund.ApprovedAmount != refund.RequestedAmount)
                                    {
                                        <div class="text-sm text-gray-500">Approved: @refund.ApprovedAmountDisplay</div>
                                    }
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @refund.StatusBadgeClass">
                                        @refund.StatusDisplayName
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                    @refund.RequestedBy
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                    @refund.RequestedAt.ToString("dd MMM yyyy")
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                    <div class="flex space-x-2">
                                        <a href="@Url.Action("Details", new { id = refund.Id })" 
                                           class="text-blue-600 hover:text-blue-900" title="View Details">
                                            <i class="ri-eye-line"></i>
                                        </a>
                                        @if (refund.Status == BiddingSystem.Models.RefundStatus.Pending)
                                        {
                                            <a href="@Url.Action("Edit", new { id = refund.Id })" 
                                               class="text-gray-600 hover:text-gray-900" title="Edit">
                                                <i class="ri-edit-line"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <div class="px-6 py-4 border-t border-gray-200">
                    <nav class="flex items-center justify-between">
                        <div class="flex-1 flex justify-between sm:hidden">
                            @if (Model.Page > 1)
                            {
                                <a href="@Url.Action("Index", new { page = Model.Page - 1 })" 
                                   class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
                                    Previous
                                </a>
                            }
                            @if (Model.Page < Model.TotalPages)
                            {
                                <a href="@Url.Action("Index", new { page = Model.Page + 1 })" 
                                   class="ml-3 relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
                                    Next
                                </a>
                            }
                        </div>
                        <div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between">
                            <div>
                                <p class="text-sm text-gray-700">
                                    Showing page <span class="font-medium">@Model.Page</span> of <span class="font-medium">@Model.TotalPages</span>
                                </p>
                            </div>
                            <div>
                                <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px">
                                    @for (int i = Math.Max(1, Model.Page - 2); i <= Math.Min(Model.TotalPages, Model.Page + 2); i++)
                                    {
                                        <a href="@Url.Action("Index", new { page = i })" 
                                           class="relative inline-flex items-center px-4 py-2 border text-sm font-medium @(i == Model.Page ? "z-10 bg-blue-50 border-blue-500 text-blue-600" : "bg-white border-gray-300 text-gray-500 hover:bg-gray-50")">
                                            @i
                                        </a>
                                    }
                                </nav>
                            </div>
                        </div>
                    </nav>
                </div>
            }
        }
        else
        {
            <div class="text-center py-12">
                <i class="ri-file-list-3-line text-6xl text-gray-300 mb-4"></i>
                <h3 class="text-lg font-medium text-gray-900 mb-2">No refund requests found</h3>
                <p class="text-gray-500 mb-4">No refund requests match your current filters.</p>
                <a href="@Url.Action("Create")" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg inline-flex items-center transition-colors">
                    <i class="ri-add-line mr-2"></i>Create New Refund Request
                </a>
            </div>
        }
    </div>
</div>