@{
    ViewData["Title"] = "All Refund Payment Transaction";
    var userRole = ViewBag.UserRole ?? "";
    var canInitiate = ViewBag.CanInitiate ?? false;
    var canApprove = ViewBag.CanApprove ?? false;
}

<div class="container-fluid px-4 py-6">
    <!-- Header Section -->
    <div class="mb-6 flex justify-between items-center">
        <div>
            <h1 class="text-2xl font-bold text-gray-800">All Refund Payment Transaction</h1>
        </div>
        <div class="flex items-center space-x-2">
            <div class="w-2 h-2 bg-green-500 rounded-full"></div>
            <div>
                <span class="text-sm font-medium">@User.Identity.Name</span>
                <span class="text-xs text-gray-500 block">@userRole</span>
            </div>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-4 gap-4 mb-6">
        <div class="bg-white rounded-lg shadow p-4 border-l-4 border-yellow-400">
            <div class="flex items-center">
                <div class="bg-yellow-100 p-2 rounded-full mr-3">
                    <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                </div>
                <div>
                    <p class="text-gray-500 text-sm">Pending</p>
                    <p class="text-2xl font-bold" id="pendingCount">0</p>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow p-4 border-l-4 border-green-400">
            <div class="flex items-center">
                <div class="bg-green-100 p-2 rounded-full mr-3">
                    <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                </div>
                <div>
                    <p class="text-gray-500 text-sm">Approved</p>
                    <p class="text-2xl font-bold" id="approvedCount">0</p>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow p-4 border-l-4 border-red-400">
            <div class="flex items-center">
                <div class="bg-red-100 p-2 rounded-full mr-3">
                    <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v1m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                </div>
                <div>
                    <p class="text-gray-500 text-sm">Failed</p>
                    <p class="text-2xl font-bold" id="failedCount">0</p>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow p-4 border-l-4 border-blue-400">
            <div class="flex items-center">
                <div class="bg-blue-100 p-2 rounded-full mr-3">
                    <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                </div>
                <div>
                    <p class="text-gray-500 text-sm">Total Amount</p>
                    <p class="text-2xl font-bold">₹<span id="totalAmount">0</span></p>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters Section -->
    <div class="bg-white rounded-lg shadow-sm p-4 mb-6">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <input type="text" id="searchTenderId" placeholder="Tender ID"
                   class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" />

            <input type="text" id="searchTenderName" placeholder="Tender Name"
                   class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" />

            <select id="paymentTypeFilter" class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                <option value="">All Payment Types</option>
                <option value="1">Bid Amount (EMD)</option>
                <option value="2">Security Deposit</option>
                <option value="3">Processing Fee</option>
                <option value="4">Other</option>
            </select>

            <button onclick="searchRefunds()"
                    class="bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700 flex items-center justify-center space-x-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
                <span>Search</span>
            </button>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="mb-4 flex justify-between items-center">
        <div class="flex items-center space-x-4">
            <label class="flex items-center space-x-2 cursor-pointer">
                <input type="checkbox" id="selectAll" onclick="toggleSelectAll()"
                       class="w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500">
                <span class="text-sm text-gray-700">Select All (Same Tender)</span>
            </label>
            <a href="#" onclick="viewPaymentSummary()" class="text-blue-600 hover:text-blue-800 text-sm">View Payment Summary</a>
        </div>

        <div class="flex space-x-2" id="actionButtons">
            @if (canApprove)
            {
                <button onclick="processSelectedRefunds('Approve')"
                        class="bg-green-600 text-white px-6 py-2 rounded-lg hover:bg-green-700 flex items-center space-x-2 disabled:opacity-50 hidden"
                        id="btnApprove" disabled>
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    <span>Approve Selected</span>
                </button>

                <button onclick="processSelectedRefunds('Reject')"
                        class="bg-red-600 text-white px-6 py-2 rounded-lg hover:bg-red-700 flex items-center space-x-2 disabled:opacity-50 hidden"
                        id="btnReject" disabled>
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                    <span>Reject Selected</span>
                </button>

                <button onclick="retrySelectedRefunds()"
                        class="bg-orange-600 text-white px-6 py-2 rounded-lg hover:bg-orange-700 flex items-center space-x-2 disabled:opacity-50 hidden"
                        id="btnRetry" disabled>
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                    </svg>
                    <span>Retry Failed</span>
                </button>
            }
            @if (canInitiate)
            {
                <button onclick="initiateSelectedRefunds()"
                        class="bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700 flex items-center space-x-2 disabled:opacity-50 hidden"
                        id="btnInitiate" disabled>
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                    </svg>
                    <span>Initiate Refund</span>
                </button>
            }
        </div>
    </div>

    <!-- Main Table -->
    <div class="bg-white rounded-lg shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="w-12 px-6 py-3">&nbsp;</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Bidder</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Company</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Payment Type</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Payment ID</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Action</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">View</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200" id="refundTableBody">
                    <!-- Data will be loaded here dynamically -->
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    <div class="mt-4 flex justify-between items-center">
        <div class="text-sm text-gray-700">
            Showing <span id="showingFrom">0</span> to <span id="showingTo">0</span> of <span id="totalRecords">0</span> results
        </div>
        <div class="flex space-x-2" id="pagination"></div>
    </div>
</div>

<!-- Modal for Reject Reason -->
<div id="rejectModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden overflow-y-auto h-full w-full z-50">
    <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
        <div class="mt-3">
            <h3 class="text-lg leading-6 font-medium text-gray-900">Reject Refund Request</h3>
            <div class="mt-2 px-7 py-3">
                <textarea id="rejectReason" rows="4"
                          class="w-full px-3 py-2 text-gray-700 border rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500"
                          placeholder="Enter rejection reason..."></textarea>
            </div>
            <div class="items-center px-4 py-3">
                <button onclick="confirmReject()"
                        class="px-4 py-2 bg-red-600 text-white text-base font-medium rounded-md w-full shadow-sm hover:bg-red-700">
                    Confirm Rejection
                </button>
                <button onclick="closeRejectModal()"
                        class="mt-3 px-4 py-2 bg-gray-300 text-gray-800 text-base font-medium rounded-md w-full shadow-sm hover:bg-gray-400">
                    Cancel
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Global Loading Overlay -->
<div id="loadingOverlay" class="fixed inset-0 bg-gray-900 bg-opacity-50 hidden overflow-y-auto h-full w-full z-[100]">
    <div class="flex items-center justify-center min-h-screen">
        <div class="bg-white rounded-lg p-8 shadow-xl">
            <div class="flex flex-col items-center">
                <div class="animate-spin rounded-full h-16 w-16 border-b-4 border-blue-600"></div>
                <p class="mt-4 text-lg font-semibold text-gray-800" id="loadingText">Processing Payment...</p>
                <p class="mt-2 text-sm text-gray-600" id="loadingSubtext">Please wait while we process your request</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentPage = 1;
        let pageSize = 10;
        let selectedRefundIds = [];
        let selectedFailedRefundIds = [];
        let userRole = '@userRole';
        let canApprove = @(canApprove ? "true" : "false");
        let canInitiate = @(canInitiate ? "true" : "false");
        let currentTenderId = null;
        let allRefundData = [];

        // Load data on page load
        $(document).ready(function () {
            console.log('User Role:', userRole);
            console.log('Can Approve:', canApprove);
            loadRefundList();
        });

        function loadRefundList() {
            const searchData = {
                tenderId: $('#searchTenderId').val(),
                tenderName: $('#searchTenderName').val(),
                paymentType: $('#paymentTypeFilter').val(),
                page: currentPage,
                pageSize: pageSize
            };

            $.ajax({
                url: '/Refund/GetRefundsList',
                type: 'GET',
                data: searchData,
                success: function (response) {
                    console.log('Response:', response);
                    if (response.success) {
                        allRefundData = response.data;
                        renderTable(response.data);
                        updatePagination(response.totalPages, response.totalRecords);
                        updateStats(response.stats);
                    } else {
                        showAlert('error', response.message);
                    }
                },
                error: function (xhr) {
                    console.error('Error loading refunds:', xhr);
                    showAlert('error', 'Failed to load refund list');
                }
            });
        }

        function renderTable(data) {
            const tbody = $('#refundTableBody');
            tbody.empty();

            if (!data || data.length === 0) {
                tbody.append(`
                        <tr>
                            <td colspan="9" class="px-6 py-4 text-center text-gray-500">No refund records found</td>
                        </tr>
                    `);
                return;
            }

            // Group by tender
            const groupedData = {};
            data.forEach(item => {
                const key = `${item.tenderId || item.tenderIdString}`;
                if (!groupedData[key]) {
                    groupedData[key] = {
                        tenderId: item.tenderId || item.tenderIdString,
                        tenderName: item.tenderName,
                        items: []
                    };
                }
                groupedData[key].items.push(item);
            });

            // Render grouped data
            Object.values(groupedData).forEach(tender => {
                // Tender header row
                tbody.append(`
                        <tr class="bg-gray-100">
                            <td colspan="9" class="px-6 py-3 font-semibold text-gray-800">
                                Tender: ${tender.tenderName} (${tender.tenderId})
                                <button onclick="viewTenderDetails('${tender.tenderId}')" class="ml-4 text-blue-600 hover:text-blue-800 text-sm">
                                    View Details
                                </button>
                            </td>
                        </tr>
                    `);

                // Update current tender for select all
                if (!currentTenderId) {
                    currentTenderId = tender.tenderId;
                }

                // Tender items
                tender.items.forEach(item => {
                    const isCheckboxEnabled = shouldEnableCheckbox(item);
                    const statusBadge = getStatusBadge(item.status);
                    const actionBadge = getActionBadge(item);

                    // Add error info tooltip for failed refunds
                    const errorInfo = item.status === 'Failed' && item.refundErrorMessage
                        ? `<span class="ml-2 text-xs text-red-600" title="${item.refundErrorMessage}">
                                 <svg class="inline w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                   <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                 </svg>
                               </span>` : '';

                    tbody.append(`
                            <tr class="hover:bg-gray-50 ${item.status === 'Failed' ? 'bg-red-50' : ''}">
                                <td class="px-6 py-4">
                                    <input type="checkbox"
                                           value="${item.id}"
                                           data-tender="${tender.tenderId}"
                                           data-status="${item.status}"
                                           data-payment-link-id="${item.paymentLinkId}"
                                           class="refund-checkbox w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500"
                                           onchange="updateSelection()"
                                           ${isCheckboxEnabled ? '' : 'disabled'}>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">${item.bidderName}</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">${item.companyName}</td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="px-2 py-1 text-xs rounded-full ${getPaymentTypeClass(item.paymentType)}">
                                        ${item.paymentType}
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">₹${formatAmount(item.amount)}</td>
                                <td class="px-6 py-4 whitespace-nowrap text-xs text-gray-500">${item.paymentId || 'N/A'}</td>
                                <td class="px-6 py-4 whitespace-nowrap">${actionBadge}</td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    ${statusBadge}
                                    ${errorInfo}
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <a href="/TenderBid/Details/${item.tenderBidId}"
                                       class="inline-flex items-center px-3 py-1 text-sm bg-blue-100 text-blue-700 rounded-lg hover:bg-blue-200">
                                        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                        </svg>
                                        Bid
                                    </a>
                                </td>
                            </tr>
                        `);
                });
            });

            // Update button states after rendering
            updateButtonStates();
        }

        function shouldEnableCheckbox(item) {
            // Debug logging
            console.log('Checking checkbox for:', {
                id: item.id,
                status: item.status,
                userRole: userRole,
                canSelect: item.canSelect,
                actionStatus: item.actionStatus
            });

            // Use the canSelect flag from backend if available
            if (item.hasOwnProperty('canSelect') && item.canSelect !== undefined) {
                return item.canSelect;
            }

            // For Checker/Approver: Enable for both Pending and Failed status
            if (userRole === 'Checker' || userRole === 'Approver') {
                // Check if item has a refund ID and is either Pending or Failed
                const isEnabled = item.id > 0 && (item.status === 'Pending' || item.status === 'Failed');
                console.log('Checker/Approver - Checkbox enabled:', isEnabled);
                return isEnabled;
            }

            // For Admin: Enable for Pending and Failed
            if (userRole === 'Admin') {
                return (item.id > 0 && (item.status === 'Pending' || item.status === 'Failed')) || (item.id === 0);
            }

            // For Maker: Only items not yet initiated
            if (userRole === 'Maker') {
                return !item.id || item.id === 0;
            }

            return false;
        }

        function getStatusBadge(status) {
            const statusClasses = {
                'Pending': 'bg-yellow-100 text-yellow-800',
                'Pending Approval': 'bg-orange-100 text-orange-800',
                'Approved': 'bg-green-100 text-green-800',
                'Rejected': 'bg-red-100 text-red-800',
                'Failed': 'bg-red-100 text-red-800 font-bold',
                'Processed': 'bg-blue-100 text-blue-800'
            };
            const cssClass = statusClasses[status] || 'bg-gray-100 text-gray-800';
            return `<span class="px-2 py-1 text-xs font-medium rounded-full ${cssClass}">${status}</span>`;
        }

        function getActionBadge(item) {
            if (item.status === 'Failed') {
                return `<span class="px-2 py-1 text-xs font-medium rounded-full bg-red-100 text-red-800">Retry Required</span>`;
            } else if (item.actionStatus === 'Awaiting Action') {
                return `<span class="px-2 py-1 text-xs font-medium rounded-full bg-blue-100 text-blue-800">Awaiting Action</span>`;
            } else if (item.actionStatus === 'Ready to Initiate') {
                return `<span class="px-2 py-1 text-xs font-medium rounded-full bg-purple-100 text-purple-800">Ready to Initiate</span>`;
            }
            return `<span class="text-xs text-gray-500">${item.actionStatus || '-'}</span>`;
        }

        function getPaymentTypeClass(type) {
            const typeStr = String(type).toLowerCase();
            if (typeStr.includes('bid') || typeStr.includes('emd')) {
                return 'bg-purple-100 text-purple-800';
            } else if (typeStr.includes('security')) {
                return 'bg-indigo-100 text-indigo-800';
            } else if (typeStr.includes('processing')) {
                return 'bg-green-100 text-green-800';
            }
            return 'bg-gray-100 text-gray-800';
        }

        function updateSelection() {
            selectedRefundIds = [];
            selectedFailedRefundIds = [];

            $('.refund-checkbox:checked').each(function () {
                const id = parseInt($(this).val());
                const status = $(this).data('status');

                selectedRefundIds.push(id);

                if (status === 'Failed') {
                    selectedFailedRefundIds.push(id);
                }
            });

            console.log('Selected IDs:', selectedRefundIds);
            console.log('Failed IDs:', selectedFailedRefundIds);
            updateButtonStates();
        }

        function updateButtonStates() {
            const hasSelection = selectedRefundIds.length > 0;
            const hasFailedSelection = selectedFailedRefundIds.length > 0;
            const hasOnlyFailed = selectedFailedRefundIds.length === selectedRefundIds.length && hasSelection;
            const hasPendingSelection = hasSelection && !hasOnlyFailed;

            if (canApprove) {
                // Show Approve/Reject only if there are pending items selected
                if (hasPendingSelection) {
                    $('#btnApprove').prop('disabled', false).removeClass('hidden');
                    $('#btnReject').prop('disabled', false).removeClass('hidden');
                } else {
                    $('#btnApprove').prop('disabled', true).addClass('hidden');
                    $('#btnReject').prop('disabled', true).addClass('hidden');
                }

                // Show Retry button if any failed items are selected
                if (hasFailedSelection) {
                    $('#btnRetry').prop('disabled', false).removeClass('hidden');
                } else {
                    $('#btnRetry').prop('disabled', true).addClass('hidden');
                }
            }

            if (canInitiate) {
                if (hasSelection) {
                    $('#btnInitiate').prop('disabled', false).removeClass('hidden');
                } else {
                    $('#btnInitiate').prop('disabled', true).addClass('hidden');
                }
            }
        }

        function processSelectedRefunds(action) {
            // Filter out failed refunds - only process pending ones
            const pendingRefundIds = selectedRefundIds.filter(id => !selectedFailedRefundIds.includes(id));

            if (pendingRefundIds.length === 0) {
                showAlert('warning', 'Please select pending refund requests (not failed ones)');
                return;
            }

            if (action === 'Reject') {
                $('#rejectModal').removeClass('hidden');
                return;
            }

            if (!confirm(`Are you sure you want to approve ${pendingRefundIds.length} refund request(s)?`)) {
                return;
            }

            $.ajax({
                url: '/Refund/ProcessRefunds',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    refundIds: pendingRefundIds,
                    action: action,
                    reason: ''
                }),
                success: function (response) {
                    if (response.success) {
                        showAlert('success', response.message);
                        selectedRefundIds = [];
                        selectedFailedRefundIds = [];
                        $('#selectAll').prop('checked', false);
                        loadRefundList();
                    } else {
                        showAlert('error', response.message);
                        if (response.errors) {
                            response.errors.forEach(error => showAlert('warning', error));
                        }
                    }
                },
                error: function (xhr) {
                    showAlert('error', 'Failed to process refunds');
                }
            });
        }

        function retrySelectedRefunds() {
            if (selectedFailedRefundIds.length === 0) {
                showAlert('warning', 'Please select failed refund requests to retry');
                return;
            }

            if (!confirm(`Are you sure you want to retry ${selectedFailedRefundIds.length} failed refund(s)?`)) {
                return;
            }

            // Process each failed refund individually
            let processedCount = 0;
            let successCount = 0;
            let failCount = 0;

            selectedFailedRefundIds.forEach(refundId => {
                $.ajax({
                    url: '/Refund/RetryFailedRefund',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        refundPaymentId: refundId
                    }),
                    success: function (response) {
                        processedCount++;
                        if (response.success) {
                            successCount++;
                            showAlert('success', `Refund ID ${refundId}: ${response.message}`);
                        } else {
                            failCount++;
                            showAlert('error', `Refund ID ${refundId}: ${response.message}`);
                        }

                        // If all processed, reload the list
                        if (processedCount === selectedFailedRefundIds.length) {
                            setTimeout(() => {
                                showAlert('info', `Retry complete: ${successCount} succeeded, ${failCount} failed`);
                                selectedRefundIds = [];
                                selectedFailedRefundIds = [];
                                $('#selectAll').prop('checked', false);
                                loadRefundList();
                            }, 1000);
                        }
                    },
                    error: function (xhr) {
                        processedCount++;
                        failCount++;
                        showAlert('error', `Failed to retry refund ID ${refundId}`);

                        if (processedCount === selectedFailedRefundIds.length) {
                            setTimeout(() => {
                                showAlert('info', `Retry complete: ${successCount} succeeded, ${failCount} failed`);
                                loadRefundList();
                            }, 1000);
                        }
                    }
                });
            });
        }

        function confirmReject() {
            const reason = $('#rejectReason').val().trim();
            const pendingRefundIds = selectedRefundIds.filter(id => !selectedFailedRefundIds.includes(id));

            if (!reason) {
                showAlert('warning', 'Please enter a rejection reason');
                return;
            }

            $.ajax({
                url: '/Refund/ProcessRefunds',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    refundIds: pendingRefundIds,
                    action: 'Reject',
                    reason: reason
                }),
                success: function (response) {
                    if (response.success) {
                        showAlert('success', response.message);
                        closeRejectModal();
                        selectedRefundIds = [];
                        selectedFailedRefundIds = [];
                        $('#selectAll').prop('checked', false);
                        loadRefundList();
                    } else {
                        showAlert('error', response.message);
                    }
                },
                error: function (xhr) {
                    showAlert('error', 'Failed to reject refunds');
                }
            });
        }

        function closeRejectModal() {
            $('#rejectModal').addClass('hidden');
            $('#rejectReason').val('');
        }

        function searchRefunds() {
            currentPage = 1;
            loadRefundList();
        }

        function updatePagination(totalPages, totalRecords) {
            const from = ((currentPage - 1) * pageSize) + 1;
            const to = Math.min(currentPage * pageSize, totalRecords);

            $('#showingFrom').text(totalRecords > 0 ? from : 0);
            $('#showingTo').text(to);
            $('#totalRecords').text(totalRecords);

            const pagination = $('#pagination');
            pagination.empty();

            if (totalPages <= 1) return;

            // Previous button
            if (currentPage > 1) {
                pagination.append(`
                        <button onclick="changePage(${currentPage - 1})" class="px-3 py-1 text-sm bg-white border border-gray-300 rounded-md hover:bg-gray-50">
                            Previous
                        </button>
                    `);
            }

            // Page numbers
            for (let i = 1; i <= totalPages; i++) {
                if (i === currentPage) {
                    pagination.append(`
                            <span class="px-3 py-1 text-sm bg-blue-600 text-white rounded-md">${i}</span>
                        `);
                } else if (i === 1 || i === totalPages || (i >= currentPage - 2 && i <= currentPage + 2)) {
                    pagination.append(`
                            <button onclick="changePage(${i})" class="px-3 py-1 text-sm bg-white border border-gray-300 rounded-md hover:bg-gray-50">
                                ${i}
                            </button>
                        `);
                }
            }

            // Next button
            if (currentPage < totalPages) {
                pagination.append(`
                        <button onclick="changePage(${currentPage + 1})" class="px-3 py-1 text-sm bg-white border border-gray-300 rounded-md hover:bg-gray-50">
                            Next
                        </button>
                    `);
            }
        }

        function changePage(page) {
            currentPage = page;
            loadRefundList();
        }

        function updateStats(stats) {
            if (stats) {
                $('#pendingCount').text(stats.pending || 0);
                $('#approvedCount').text(stats.approved || 0);
                $('#failedCount').text(stats.failed || 0);
                $('#totalAmount').text(formatAmount(stats.totalAmount || 0));
            }
        }

        function formatAmount(amount) {
            return new Intl.NumberFormat('en-IN').format(amount);
        }

        function viewPaymentSummary() {
            window.open('/Refund/PaymentSummary', '_blank');
        }

        function viewTenderDetails(tenderId) {
            window.open(`/Tender/Details/${tenderId}`, '_blank');
        }

        function showAlert(type, message) {
            const alertClass = type === 'success' ? 'border-green-500' :
                type === 'error' ? 'border-red-500' :
                    type === 'warning' ? 'border-yellow-500' :
                        'border-blue-500';

            const toast = $(`
                    <div class="fixed top-4 right-4 z-50 max-w-sm">
                        <div class="bg-white rounded-lg shadow-lg p-4 border-l-4 ${alertClass}">
                            <div class="flex items-center">
                                <span class="text-gray-800">${message}</span>
                            </div>
                        </div>
                    </div>
                `);

            $('body').append(toast);
            setTimeout(() => toast.fadeOut(() => toast.remove()), 3000);
        }

        // Add this function to your Refund Index view's Scripts section

        function initiateSelectedRefunds() {
            if (selectedRefundIds.length === 0) {
                showAlert('warning', 'Please select at least one payment for refund');
                return;
            }

            // Build refund items from selected rows
            const refundItems = [];

            $('.refund-checkbox:checked').each(function () {
                const $row = $(this).closest('tr');
                const paymentLinkId = $(this).data('payment-link-id') || $(this).val();
                const tenderBidId = $(this).data('tender-bid-id');
                const paymentType = $(this).data('payment-type-value');

                // Get data from the row if not in data attributes
                if (!tenderBidId) {
                    // Find from allRefundData if available
                    const item = allRefundData.find(r => r.id == $(this).val() || r.paymentLinkId == paymentLinkId);
                    if (item) {
                        refundItems.push({
                            paymentLinkId: item.paymentLinkId,
                            tenderBidId: item.tenderBidId,
                            paymentType: item.paymentTypeValue || 1
                        });
                    }
                } else {
                    refundItems.push({
                        paymentLinkId: parseInt(paymentLinkId),
                        tenderBidId: parseInt(tenderBidId),
                        paymentType: parseInt(paymentType) || 1
                    });
                }
            });

            if (refundItems.length === 0) {
                showAlert('error', 'Unable to get payment details. Please refresh and try again.');
                return;
            }

            // Show modal or prompt for refund reason
            const defaultReason = 'Tender awarded to another bidder';

            // Create a modal for refund reason
            const modalHtml = `
                <div id="initiateRefundModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50">
                    <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
                        <div class="mt-3">
                            <h3 class="text-lg leading-6 font-medium text-gray-900">Initiate Refund</h3>
                            <div class="mt-2 px-7 py-3">
                                <p class="text-sm text-gray-600 mb-3">
                                    You are about to initiate refund for ${refundItems.length} payment(s).
                                </p>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Refund Reason</label>
                                <select id="refundReasonSelect" class="w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                                    <option value="Tender awarded to another bidder">Tender awarded to another bidder</option>
                                    <option value="Bid rejected - not meeting requirements">Bid rejected - not meeting requirements</option>
                                    <option value="Tender cancelled">Tender cancelled</option>
                                    <option value="Other">Other (specify below)</option>
                                </select>
                                <textarea id="refundReasonText" rows="3"
                                          class="w-full px-3 py-2 mt-3 text-gray-700 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 hidden"
                                          placeholder="Enter custom reason..."></textarea>
                            </div>
                            <div class="items-center px-4 py-3">
                                <button onclick="confirmInitiateRefund()"
                                        class="px-4 py-2 bg-blue-600 text-white text-base font-medium rounded-md w-full shadow-sm hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500">
                                    Confirm Initiate Refund
                                </button>
                                <button onclick="closeInitiateModal()"
                                        class="mt-3 px-4 py-2 bg-gray-300 text-gray-800 text-base font-medium rounded-md w-full shadow-sm hover:bg-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-300">
                                    Cancel
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            `;

            // Remove existing modal if any
            $('#initiateRefundModal').remove();

            // Add modal to body
            $('body').append(modalHtml);

            // Show/hide custom reason textarea based on selection
            $('#refundReasonSelect').on('change', function () {
                if ($(this).val() === 'Other') {
                    $('#refundReasonText').removeClass('hidden');
                } else {
                    $('#refundReasonText').addClass('hidden');
                }
            });

            // Store refund items globally for confirm function
            window.pendingRefundItems = refundItems;
        }

        function confirmInitiateRefund() {
            const reasonSelect = $('#refundReasonSelect').val();
            let reason = reasonSelect;

            if (reasonSelect === 'Other') {
                reason = $('#refundReasonText').val().trim();
                if (!reason) {
                    showAlert('warning', 'Please enter a refund reason');
                    return;
                }
            }

            const refundItems = window.pendingRefundItems;

            if (!refundItems || refundItems.length === 0) {
                showAlert('error', 'No items selected for refund');
                closeInitiateModal();
                return;
            }

            // Show loading overlay
            if (typeof showLoadingOverlay === 'function') {
                showLoadingOverlay('Initiating Refunds...', `Processing ${refundItems.length} refund request(s)`);
            }

            // Close modal
            closeInitiateModal();

            // Make AJAX call to initiate refunds
            $.ajax({
                url: '/Refund/InitiateRefunds',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    refundItems: refundItems,
                    reason: reason
                }),
                success: function (response) {
                    if (typeof hideLoadingOverlay === 'function') {
                        hideLoadingOverlay();
                    }

                    if (response.success) {
                        showAlert('success', response.message || `Successfully initiated ${refundItems.length} refund(s) for approval`);

                        // Clear selections
                        selectedRefundIds = [];
                        $('.refund-checkbox').prop('checked', false);
                        $('#selectAll').prop('checked', false);

                        // Reload the list
                        if (typeof loadRefundList === 'function') {
                            loadRefundList();
                        } else {
                            location.reload();
                        }
                    } else {
                        showAlert('error', response.message || 'Failed to initiate refunds');
                        if (response.errors && Array.isArray(response.errors)) {
                            response.errors.forEach(error => showAlert('warning', error));
                        }
                    }
                },
                error: function (xhr, status, error) {
                    if (typeof hideLoadingOverlay === 'function') {
                        hideLoadingOverlay();
                    }
                    console.error('Error initiating refunds:', error);
                    showAlert('error', 'Failed to initiate refunds. Please try again.');
                }
            });
        }

        function closeInitiateModal() {
            $('#initiateRefundModal').remove();
            window.pendingRefundItems = null;
        }

        // Helper function for showing alerts if not already defined
        function showAlert(type, message) {
            // Check if function already exists
            if (window.showAlertOriginal) {
                return window.showAlertOriginal(type, message);
            }

            const alertClass = type === 'success' ? 'border-green-500 bg-green-50' :
                type === 'error' ? 'border-red-500 bg-red-50' :
                    type === 'warning' ? 'border-yellow-500 bg-yellow-50' :
                        'border-blue-500 bg-blue-50';

            const iconColor = type === 'success' ? 'text-green-600' :
                type === 'error' ? 'text-red-600' :
                    type === 'warning' ? 'text-yellow-600' :
                        'text-blue-600';

            const toast = $(`
                <div class="fixed top-4 right-4 z-50 max-w-sm animate-fade-in">
                    <div class="${alertClass} rounded-lg shadow-lg p-4 border-l-4">
                        <div class="flex items-center">
                            <span class="${iconColor} mr-2">
                                ${type === 'success' ? '✓' : type === 'error' ? '✕' : type === 'warning' ? '⚠' : 'ℹ'}
                            </span>
                            <span class="text-gray-800">${message}</span>
                        </div>
                    </div>
                </div>
            `);

            $('body').append(toast);

            // Auto remove after 5 seconds
            setTimeout(() => {
                toast.fadeOut(300, function () {
                    $(this).remove();
                });
            }, 5000);
        }
    </script>
}