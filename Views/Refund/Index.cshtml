@{
    ViewData["Title"] = "All Refund Payment Transaction";
    var userRole = ViewBag.UserRole ?? "";
    var canInitiate = ViewBag.CanInitiate ?? false;
    var canApprove = ViewBag.CanApprove ?? false;
}

<div class="container-fluid px-4 py-8">
    <!-- Header Section -->
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-800">All Refund Payment Transaction</h1>
        <p class="text-gray-600 mt-1">
            @if (userRole == "Admin")
            {
                <span>Manage all refund operations - initiate and approve refund requests</span>
            }
            else if (userRole == "Checker")
            {
                <span>Review and approve pending refund requests</span>
            }
            else if (userRole == "Maker")
            {
                <span>Select eligible bidders to initiate refund requests</span>
            }
        </p>
        <p class="text-sm text-gray-500 mt-1">Logged in as: <strong>@userRole</strong></p>
    </div>

    <!-- Search Filters -->
    <div class="bg-white rounded-lg shadow-sm p-4 mb-6">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div>
                <input type="text"
                       id="searchTenderId"
                       placeholder="Tender ID"
                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" />
            </div>
            <div>
                <input type="text"
                       id="searchTenderName"
                       placeholder="Tender Name"
                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" />
            </div>
            @if (userRole == "Admin")
            {
                <div>
                    <select id="viewMode" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                        <option value="all">All Eligible Bidders</option>
                        <option value="pending">Pending Approvals Only</option>
                    </select>
                </div>
            }
            <div>
                <button onclick="loadRefundList(1)"
                        class="w-full bg-blue-800 text-white px-6 py-2 rounded-lg hover:bg-blue-700 transition duration-200 flex items-center justify-center">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                    Search
                </button>
            </div>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="mb-4 flex justify-between items-center">
        <div class="flex items-center space-x-4">
            <input type="checkbox" id="selectAll" class="w-4 h-4 text-blue-600 rounded focus:ring-blue-500" onchange="toggleSelectAll()">
            <label for="selectAll" class="text-sm font-medium text-gray-700">Select All (Same Tender)</label>
        </div>

        <div class="flex space-x-2">
            @if (canApprove)
            {
                <button onclick="processSelectedRefunds('Approve')"
                        class="bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700 transition duration-200 disabled:opacity-50"
                        id="btnApprove" disabled style="display:none;">
                    Approve Selected
                </button>
                <button onclick="processSelectedRefunds('Reject')"
                        class="bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700 transition duration-200 disabled:opacity-50"
                        id="btnReject" disabled style="display:none;">
                    Reject Selected
                </button>
            }

            @if (canInitiate)
            {
                <button onclick="initiateSelectedRefunds()"
                        class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition duration-200 disabled:opacity-50"
                        id="btnInitiate" disabled style="display:none;">
                    Send For Approval
                </button>
            }
        </div>
    </div>

    <!-- Main Table -->
    <div class="bg-white rounded-lg shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-4 py-3 text-left">
                            <span class="sr-only">Select</span>
                        </th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Bidders</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Company Name</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Total Amount to be refunded</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Reason for refund</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Send For Approval</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">STATUS</th>
                        <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody id="refundTableBody" class="bg-white divide-y divide-gray-200">
                    <!-- Table rows will be loaded here via AJAX -->
                </tbody>
            </table>
        </div>

        <!-- Loading indicator -->
        <div id="loadingIndicator" class="hidden text-center py-8">
            <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
            <p class="mt-2 text-gray-600">Loading...</p>
        </div>

        <!-- No data message -->
        <div id="noDataMessage" class="hidden text-center py-8">
            <p class="text-gray-500">No refund records found.</p>
        </div>
    </div>

    <!-- Pagination -->
    <div id="paginationContainer" class="bg-white rounded-lg shadow-sm px-6 py-3 mt-4 flex items-center justify-between">
        <!-- Pagination will be loaded here via AJAX -->
    </div>
</div>

<!-- Remarks Modal (for Checker/Admin) -->
@if (canApprove)
{
    <div id="remarksModal" class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50">
        <div class="bg-white rounded-lg p-6 max-w-md w-full mx-4">
            <h3 class="text-lg font-bold mb-4">Add Remarks</h3>
            <textarea id="checkerRemarks"
                      rows="4"
                      class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"
                      placeholder="Enter your remarks here..."></textarea>
            <div class="mt-4 flex justify-end space-x-2">
                <button onclick="closeRemarksModal()"
                        class="px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50">
                    Cancel
                </button>
                <button onclick="submitRemarks()"
                        class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700">
                    Submit
                </button>
            </div>
        </div>
    </div>
}

<!-- Add these modals to your Index.cshtml after the remarksModal -->
<!-- Processing Modal -->
<div id="processingModal" class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50">
    <div class="bg-white rounded-lg p-6 max-w-sm w-full mx-4">
        <div class="flex flex-col items-center">
            <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600"></div>
            <p class="mt-4 text-gray-700 font-medium">Processing Refunds...</p>
            <p class="text-sm text-gray-500 mt-2">Please wait</p>
        </div>
    </div>
</div>

<!-- Result Modal -->
<div id="resultModal" class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50">
    <div class="bg-white rounded-lg p-6 max-w-lg w-full mx-4 max-h-[80vh] overflow-y-auto">
        <div id="resultContent">
            <!-- Content will be inserted here dynamically -->
        </div>
        <div class="mt-6 flex justify-end">
            <button onclick="closeResultModal()"
                    class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition duration-200">
                OK
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentPage = 1;
        let totalPages = 1;
        let selectedItems = [];
        let pendingAction = '';
        let currentTenderId = null;
        const userRole = '@userRole';
        const canInitiate = @Json.Serialize(canInitiate);
        const canApprove = @Json.Serialize(canApprove);
        let currentViewMode = 'maker';

        $(document).ready(function () {
            loadRefundList(1);

            // Enter key press for search
            $('#searchTenderId, #searchTenderName').keypress(function (e) {
                if (e.which == 13) {
                    loadRefundList(1);
                }
            });

            // View mode change for Admin
            $('#viewMode').change(function () {
                loadRefundList(1);
            });
        });

        function loadRefundList(page) {
            currentPage = page;
            selectedItems = [];
            updateActionButtons();

            $('#loadingIndicator').removeClass('hidden');
            $('#refundTableBody').empty();
            $('#noDataMessage').addClass('hidden');

            const filter = {
                TenderId: $('#searchTenderId').val(),
                TenderName: $('#searchTenderName').val(),
                PageNumber: page,
                PageSize: 25,
                ShowPendingOnly: $('#viewMode').val() === 'pending'
            };

            $.ajax({
                url: '@Url.Action("GetRefundList", "Refund")',
                type: 'GET',
                data: filter,
                success: function (response) {
                    $('#loadingIndicator').addClass('hidden');

                    if (response.success) {
                        currentViewMode = response.canApprove && (userRole === 'Checker' || filter.ShowPendingOnly) ? 'checker' : 'maker';
                        renderTable(response.data, response);
                        renderPagination(response.data);
                        updateButtonVisibility();
                    } else {
                        $('#noDataMessage').removeClass('hidden');
                    }
                },
                error: function () {
                    $('#loadingIndicator').addClass('hidden');
                    alert('Error loading refund list');
                }
            });
        }

        function renderTable(data, response) {
            const tbody = $('#refundTableBody');
            tbody.empty();

            if (!data.items || data.items.length === 0) {
                $('#noDataMessage').removeClass('hidden');
                return;
            }

            let currentTender = '';
            data.items.forEach(function (item) {
                // Group by tender
                if (item.tenderIdString !== currentTender) {
                    currentTender = item.tenderIdString;
                    tbody.append(`
                        <tr class="bg-gray-100">
                            <td colspan="8" class="px-6 py-2 text-sm font-semibold text-gray-700">
                                Tender: ${item.tenderIdString} - ${item.tenderTitle}
                            </td>
                        </tr>
                    `);
                }

                const isDisabled = item.hasPendingRefund && currentViewMode === 'maker';
                const checkboxId = currentViewMode === 'checker' ? item.refundPaymentId : item.tenderBidId;

                let statusBadge = '';
                let actionButton = '';

                if (currentViewMode === 'checker') {
                    // Checker sees pending refunds to approve
                    statusBadge = '<span class="px-2 py-1 text-xs font-medium bg-yellow-100 text-yellow-800 rounded-full">Pending Approval</span>';
                    actionButton = '<span class="px-2 py-1 text-xs font-medium bg-blue-100 text-blue-800 rounded-full">Awaiting Action</span>';
                } else {
                    // Maker/Admin view
                    if (item.hasPendingRefund) {
                        // Check if refund has been processed through Razorpay
                        if (item.razorpayRefundId) {
                            // Successfully refunded through Razorpay
                            statusBadge = `
                                <span class="px-2 py-1 text-xs font-medium bg-green-100 text-green-800 rounded-full">
                                    Refunded
                                </span>
                                <div class="text-xs text-gray-500 mt-1" title="Razorpay ID: ${item.razorpayRefundId}">
                                    <svg class="inline w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                                    </svg>
                                    Razorpay Processed
                                </div>`;
                        } else if (item.refundStatus === 'Failed') {
                            // Failed refund
                            statusBadge = `
                                <span class="px-2 py-1 text-xs font-medium bg-red-100 text-red-800 rounded-full">
                                    Failed
                                </span>
                                ${item.refundErrorMessage ? `
                                <div class="text-xs text-red-600 mt-1" title="${item.refundErrorMessage}">
                                    <svg class="inline w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
                                    </svg>
                                    Error
                                </div>` : ''}`;
                        } else if (item.refundStatus === 'Approved') {
                            // Approved but not yet processed through Razorpay (maybe manual refund)
                            statusBadge = '<span class="px-2 py-1 text-xs font-medium bg-green-100 text-green-800 rounded-full">Approved</span>';
                        } else {
                            // Pending approval
                            statusBadge = '<span class="px-2 py-1 text-xs font-medium bg-yellow-100 text-yellow-800 rounded-full">Pending Approval</span>';
                        }
                        actionButton = statusBadge;
                    } else {
                        // Not initiated
                        statusBadge = '<span class="px-2 py-1 text-xs font-medium bg-gray-100 text-gray-600 rounded-full">Not Initiated</span>';
                        if (response.canInitiate) {
                            actionButton = '<button class="bg-blue-600 text-white px-3 py-1 rounded text-sm hover:bg-blue-700" onclick="initiateRefund(' + item.tenderBidId + ')">Send For Approval</button>';
                        } else {
                            actionButton = statusBadge;
                        }
                    }
                }

                // View buttons
                let viewButtons = `
                    <a href="/TenderBid/Details/${item.tenderBidId}"
                       class="inline-flex items-center justify-center px-3 py-1 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
                        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                        </svg>
                        Bid
                    </a>
                `;

                // Add refund details link if refund has been processed
                if (item.refundPaymentId && (item.razorpayRefundId || item.refundStatus === 'Approved' || item.refundStatus === 'Failed')) {
                    viewButtons += `
                        <a href="/Refund/Details/${item.refundPaymentId}"
                           class="ml-2 inline-flex items-center justify-center px-3 py-1 border border-blue-300 text-sm font-medium rounded-md text-blue-700 bg-blue-50 hover:bg-blue-100">
                            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                            </svg>
                            Refund
                        </a>
                    `;
                }

                tbody.append(`
                    <tr class="hover:bg-gray-50">
                        <td class="px-4 py-3">
                            <input type="checkbox"
                                   class="refund-checkbox w-4 h-4 text-blue-600 rounded focus:ring-blue-500"
                                   value="${checkboxId}"
                                   data-tender="${item.tenderId}"
                                   ${isDisabled ? 'disabled' : ''}
                                   onchange="updateSelection(this)">
                        </td>
                        <td class="px-6 py-3 whitespace-nowrap text-sm text-gray-900">${item.bidderName}</td>
                        <td class="px-6 py-3 whitespace-nowrap text-sm text-gray-900">${item.companyName || '-'}</td>
                        <td class="px-6 py-3 whitespace-nowrap text-sm text-gray-900">₹ ${item.totalAmountToRefund.toLocaleString('en-IN', { minimumFractionDigits: 2 })}</td>
                        <td class="px-6 py-3 text-sm text-gray-900">${item.reasonForRefund}</td>
                        <td class="px-6 py-3 whitespace-nowrap">${actionButton}</td>
                        <td class="px-6 py-3 whitespace-nowrap">${statusBadge}</td>
                        <td class="px-6 py-3 whitespace-nowrap text-center">${viewButtons}</td>
                    </tr>
                `);
            });
        }

        function updateButtonVisibility() {
            if (currentViewMode === 'checker' && canApprove) {
                $('#btnApprove').show();
                $('#btnReject').show();
                $('#btnInitiate').hide();
            } else if (currentViewMode === 'maker' && canInitiate) {
                $('#btnApprove').hide();
                $('#btnReject').hide();
                $('#btnInitiate').show();
            } else {
                $('#btnApprove').hide();
                $('#btnReject').hide();
                $('#btnInitiate').hide();
            }
        }

        function renderPagination(data) {
            const container = $('#paginationContainer');
            container.empty();

            const info = $('<div class="text-sm text-gray-700"></div>');
            const startItem = (data.currentPage - 1) * data.pageSize + 1;
            const endItem = Math.min(data.currentPage * data.pageSize, data.totalCount);
            info.text(`Showing ${startItem} to ${endItem} of ${data.totalCount} results`);

            const pagination = $('<div class="flex space-x-1"></div>');

            if (data.hasPreviousPage) {
                pagination.append(`<button onclick="loadRefundList(${data.currentPage - 1})" class="px-3 py-1 text-sm border rounded hover:bg-gray-100">Previous</button>`);
            }

            for (let i = Math.max(1, data.currentPage - 2); i <= Math.min(data.totalPages, data.currentPage + 2); i++) {
                const btnClass = i === data.currentPage ? 'bg-blue-600 text-white' : 'hover:bg-gray-100';
                pagination.append(`<button onclick="loadRefundList(${i})" class="px-3 py-1 text-sm border rounded ${btnClass}">${i}</button>`);
            }

            if (data.hasNextPage) {
                pagination.append(`<button onclick="loadRefundList(${data.currentPage + 1})" class="px-3 py-1 text-sm border rounded hover:bg-gray-100">Next</button>`);
            }

            container.append(info);
            container.append(pagination);
        }

        function toggleSelectAll() {
            const isChecked = $('#selectAll').prop('checked');
            const checkboxes = $('.refund-checkbox:not(:disabled)');

            if (isChecked && checkboxes.length > 0) {
                // Get first tender ID from enabled checkboxes
                const firstTender = checkboxes.first().data('tender');

                checkboxes.each(function () {
                    if ($(this).data('tender') == firstTender) {
                        $(this).prop('checked', true);
                    }
                });

                selectedItems = checkboxes.filter(':checked').map(function () {
                    return parseInt($(this).val());
                }).get();
            } else {
                checkboxes.prop('checked', false);
                selectedItems = [];
            }

            updateActionButtons();
        }

        function updateSelection(checkbox) {
            const value = parseInt($(checkbox).val());
            const tenderId = $(checkbox).data('tender');

            if ($(checkbox).prop('checked')) {
                // Check if we already have items from a different tender
                if (selectedItems.length > 0) {
                    const firstCheckbox = $('.refund-checkbox:checked').first();
                    const firstTenderId = firstCheckbox.data('tender');

                    if (tenderId != firstTenderId) {
                        alert('You can only select bidders from the same tender at a time.');
                        $(checkbox).prop('checked', false);
                        return;
                    }
                }
                selectedItems.push(value);
            } else {
                selectedItems = selectedItems.filter(id => id !== value);
            }

            updateActionButtons();
        }

        function updateActionButtons() {
            const hasSelection = selectedItems.length > 0;

            $('#btnApprove').prop('disabled', !hasSelection);
            $('#btnReject').prop('disabled', !hasSelection);
            $('#btnInitiate').prop('disabled', !hasSelection);

            $('#selectAll').prop('checked', false);
        }

        function initiateRefund(tenderBidId) {
            if (!canInitiate) {
                alert('You do not have permission to initiate refunds.');
                return;
            }
            initiateSelectedRefunds([tenderBidId]);
        }

        function initiateSelectedRefunds(ids) {
            if (!canInitiate) {
                alert('You do not have permission to initiate refunds.');
                return;
            }

            const tenderBidIds = ids || selectedItems;

            if (tenderBidIds.length === 0) {
                alert('Please select at least one bidder for refund.');
                return;
            }

            if (confirm(`Are you sure you want to initiate refund for ${tenderBidIds.length} bidder(s)?`)) {
                $.ajax({
                    url: '@Url.Action("InitiateRefunds", "Refund")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        TenderBidIds: tenderBidIds,
                        ReasonForRefund: 'Tender awarded to another bidder'
                    }),
                    success: function (response) {
                        if (response.success) {
                            alert(response.message);
                            loadRefundList(currentPage);
                        } else {
                            alert('Error: ' + response.message);
                        }
                    },
                    error: function () {
                        alert('An error occurred while initiating refunds.');
                    }
                });
            }
        }

        function processSelectedRefunds(action) {
            if (!canApprove) {
                alert('You do not have permission to approve/reject refunds.');
                return;
            }

            if (selectedItems.length === 0) {
                alert('Please select at least one refund to process.');
                return;
            }

            pendingAction = action;

            if (action === 'Reject') {
                $('#remarksModal').removeClass('hidden').addClass('flex');
            } else {
                if (confirm(`Are you sure you want to approve ${selectedItems.length} refund(s)?`)) {
                    submitProcessRefunds('');
                }
            }
        }

        function closeRemarksModal() {
            $('#remarksModal').removeClass('flex').addClass('hidden');
            $('#checkerRemarks').val('');
            pendingAction = '';
        }

        function submitRemarks() {
            const remarks = $('#checkerRemarks').val();
            if (!remarks && pendingAction === 'Reject') {
                alert('Remarks are required when rejecting refunds.');
                return;
            }
            submitProcessRefunds(remarks);
            closeRemarksModal();
        }


        function submitProcessRefunds(remarks) {
            // Show processing modal
            showProcessingModal();

            $.ajax({
                url: '@Url.Action("ProcessRefunds", "Refund")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    RefundPaymentIds: selectedItems,
                    Action: pendingAction,
                    CheckerRemarks: remarks
                }),
                success: function (response) {
                    hideProcessingModal();

                    if (response.success && response.allSuccessful) {
                        // Complete success
                        showResultModal('success', 'Success!', response.message);
                    }
                    else if (response.partialSuccess) {
                        // Partial success - some refunds failed
                        let content = `<p class="text-gray-700">${response.message}</p>`;

                        if (response.details && response.details.failed) {
                            content += '<div class="mt-4 p-3 bg-yellow-50 border border-yellow-200 rounded">';
                            content += '<p class="font-semibold text-yellow-800 mb-2">Failed Refunds:</p>';
                            content += '<ul class="list-disc list-inside text-sm text-yellow-700">';
                            response.details.failed.forEach(function (item) {
                                content += `<li>Refund ID ${item.refundId}: ${item.error}</li>`;
                            });
                            content += '</ul>';
                            content += '</div>';
                        }
                        content += '<p class="mt-4 text-sm text-gray-600">Successfully processed refunds have been updated. Failed refunds are marked with error status.</p>';

                        showResultModal('warning', 'Partial Success', content);
                    }
                    else if (response.rolledBack) {
                        // Complete failure - all changes rolled back
                        let content = `
                            <p class="text-gray-700">${response.message}</p>
                            <p class="mt-3 text-sm text-gray-600">No changes have been made to the database.</p>
                        `;
                        showResultModal('error', 'Processing Failed', content);
                    }
                    else {
                        // Other failure scenarios
                        showResultModal('error', 'Error', response.message || 'An error occurred while processing refunds.');
                    }
                },
                error: function (xhr, status, error) {
                    hideProcessingModal();

                    let errorMessage = 'An error occurred while processing refunds.';
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMessage = xhr.responseJSON.message;
                    } else if (xhr.responseText) {
                        try {
                            const errorResponse = JSON.parse(xhr.responseText);
                            errorMessage = errorResponse.message || errorMessage;
                        } catch (e) {
                            errorMessage = 'Server error: ' + error;
                        }
                    }

                    showResultModal('error', 'Connection Error', errorMessage);
                }
            });
        }

        // Add these helper functions for the Tailwind modals
        function showProcessingModal() {
            $('#processingModal').removeClass('hidden').addClass('flex');
        }

        function hideProcessingModal() {
            $('#processingModal').removeClass('flex').addClass('hidden');
        }

        function showResultModal(type, title, content) {
            let icon = '';
            let titleClass = '';

            if (type === 'success') {
                icon = `<svg class="w-12 h-12 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>`;
                titleClass = 'text-green-800';
            } else if (type === 'warning') {
                icon = `<svg class="w-12 h-12 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                        </svg>`;
                titleClass = 'text-yellow-800';
            } else {
                icon = `<svg class="w-12 h-12 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>`;
                titleClass = 'text-red-800';
            }

            const resultHtml = `
                <div class="flex flex-col items-center">
                    ${icon}
                    <h3 class="mt-4 text-lg font-semibold ${titleClass}">${title}</h3>
                    <div class="mt-4 w-full">
                        ${typeof content === 'string' && !content.includes('<') ? `<p class="text-gray-700">${content}</p>` : content}
                    </div>
                </div>
            `;

            $('#resultContent').html(resultHtml);
            $('#resultModal').removeClass('hidden').addClass('flex');
        }

        function closeResultModal() {
            $('#resultModal').removeClass('flex').addClass('hidden');
            loadRefundList(currentPage);
        }
    </script>
}