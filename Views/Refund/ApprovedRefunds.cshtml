@{
    ViewData["Title"] = "Approved Refund Transactions";
    var userRole = ViewBag.UserRole ?? "";
}

<div class="container-fluid px-4 py-8">
    <!-- Header Section -->
    <div class="mb-6 flex justify-between items-center">
        <div>
            <h1 class="text-2xl font-bold text-gray-800">Approved Refund Transactions</h1>
            <p class="text-gray-600 mt-1">View all approved refund requests</p>
        </div>
        <div>
            <a href="@Url.Action("Index", "Refund")" class="bg-gray-600 text-white px-4 py-2 rounded-lg hover:bg-gray-700 transition duration-200">
                Back to Pending Refunds
            </a>
        </div>
    </div>

    <!-- Search Filters -->
    <div class="bg-white rounded-lg shadow-sm p-4 mb-6">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div>
                <input type="text"
                       id="searchTenderId"
                       placeholder="Tender ID"
                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" />
            </div>
            <div>
                <input type="text"
                       id="searchTenderName"
                       placeholder="Tender Name"
                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" />
            </div>
            <div>
                <input type="date"
                       id="searchFromDate"
                       placeholder="From Date"
                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" />
            </div>
            <div>
                <button onclick="loadApprovedRefunds(1)"
                        class="w-full bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700 transition duration-200 flex items-center justify-center">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                    Search
                </button>
            </div>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
        <div class="bg-white rounded-lg shadow p-4">
            <div class="text-sm text-gray-600">Total Approved</div>
            <div class="text-2xl font-bold text-green-600" id="totalApproved">0</div>
        </div>
        <div class="bg-white rounded-lg shadow p-4">
            <div class="text-sm text-gray-600">Total Amount</div>
            <div class="text-2xl font-bold text-blue-600" id="totalAmount">₹0</div>
        </div>
        <div class="bg-white rounded-lg shadow p-4">
            <div class="text-sm text-gray-600">This Month</div>
            <div class="text-2xl font-bold text-purple-600" id="thisMonth">0</div>
        </div>
        <div class="bg-white rounded-lg shadow p-4">
            <div class="text-sm text-gray-600">Processed</div>
            <div class="text-2xl font-bold text-orange-600" id="processed">0</div>
        </div>
    </div>

    <!-- Main Table -->
    <div class="bg-white rounded-lg shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Refund ID</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tender</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Bidder</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Company</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Payment Type</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Approved Date</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody id="approvedTableBody" class="bg-white divide-y divide-gray-200">
                    <!-- Table rows will be loaded here via AJAX -->
                </tbody>
            </table>
        </div>

        <!-- Loading indicator -->
        <div id="loadingIndicator" class="hidden text-center py-8">
            <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
            <p class="mt-2 text-gray-600">Loading...</p>
        </div>

        <!-- No data message -->
        <div id="noDataMessage" class="hidden text-center py-8">
            <p class="text-gray-500">No approved refunds found.</p>
        </div>
    </div>

    <!-- Pagination -->
    <div id="paginationContainer" class="bg-white rounded-lg shadow-sm px-6 py-3 mt-4 flex items-center justify-between">
        <!-- Pagination will be loaded here via AJAX -->
    </div>
</div>

@section Scripts {
    <script>
        let currentPage = 1;
        const userRole = '@userRole';

        $(document).ready(function () {
            loadApprovedRefunds(1);

            // Enter key press for search
            $('#searchTenderId, #searchTenderName').keypress(function (e) {
                if (e.which == 13) {
                    loadApprovedRefunds(1);
                }
            });
        });

        function loadApprovedRefunds(page) {
            currentPage = page;

            $('#loadingIndicator').removeClass('hidden');
            $('#approvedTableBody').empty();
            $('#noDataMessage').addClass('hidden');

            const filter = {
                tenderId: $('#searchTenderId').val(),
                tenderName: $('#searchTenderName').val(),
                fromDate: $('#searchFromDate').val(),
                page: page,
                pageSize: 10
            };

            $.ajax({
                url: '@Url.Action("GetApprovedRefunds", "Refund")',  // FIXED: Correct action name
                type: 'GET',
                data: filter,
                success: function (response) {
                    console.log('Response:', response);
                    $('#loadingIndicator').addClass('hidden');

                    if (response.success && response.data && response.data.length > 0) {
                        renderApprovedTable(response.data);
                        renderPagination(response.totalPages, response.totalRecords, page);
                        updateStatistics(response.data);
                    } else {
                        $('#noDataMessage').removeClass('hidden');
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Error:', error);
                    $('#loadingIndicator').addClass('hidden');
                    $('#noDataMessage').removeClass('hidden');
                    showAlert('error', 'Error loading approved refunds');
                }
            });
        }

        function renderApprovedTable(data) {
            const tbody = $('#approvedTableBody');
            tbody.empty();

            if (!data || data.length === 0) {
                $('#noDataMessage').removeClass('hidden');
                return;
            }

            data.forEach(function (item) {
                const approvedDate = item.approvedAt ? new Date(item.approvedAt).toLocaleDateString('en-IN') : '-';
                const paymentStatusBadge = item.paymentProcessed
                    ? '<span class="px-2 py-1 text-xs font-medium bg-green-100 text-green-800 rounded-full">Processed</span>'
                    : '<span class="px-2 py-1 text-xs font-medium bg-yellow-100 text-yellow-800 rounded-full">Processing</span>';

                const paymentTypeBadge = getPaymentTypeBadge(item.paymentTypeDisplay);

                // Create action buttons
                const actionButtons = `
                            <div class="flex space-x-2">
                                <a href="/TenderBid/Details/${item.tenderBidId}"
                                   class="inline-flex items-center px-2 py-1 text-xs bg-blue-100 text-blue-700 rounded hover:bg-blue-200"
                                   title="View Bid Details">
                                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                                    </svg>
                                    Bid
                                </a>
                                <a href="/Payment/ViewPaymentLink/${item.paymentLinkId || item.originalPaymentId}"
                                   class="inline-flex items-center px-2 py-1 text-xs bg-green-100 text-green-700 rounded hover:bg-green-200"
                                   title="View Payment Details">
                                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
                                    </svg>
                                    Payment
                                </a>
                                <button onclick="viewRefundDetails(${item.refundPaymentId})"
                                        class="inline-flex items-center px-2 py-1 text-xs bg-purple-100 text-purple-700 rounded hover:bg-purple-200"
                                        title="View Refund Details">
                                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                    </svg>
                                    Details
                                </button>
                            </div>
                        `;

                tbody.append(`
                            <tr class="hover:bg-gray-50">
                                <td class="px-6 py-3 whitespace-nowrap text-sm font-medium text-gray-900">
                                    #${item.refundPaymentId}
                                    ${item.razorpayRefundId ?
                        `<span class="block text-xs text-gray-500" title="Razorpay Refund ID">${item.razorpayRefundId}</span>` :
                        ''}
                                </td>
                                <td class="px-6 py-3 text-sm text-gray-900">
                                    <div class="font-medium">${item.tenderIdString || '-'}</div>
                                    <div class="text-xs text-gray-500 truncate max-w-xs" title="${item.tenderTitle}">
                                        ${item.tenderTitle || '-'}
                                    </div>
                                </td>
                                <td class="px-6 py-3 whitespace-nowrap text-sm text-gray-900">
                                    <div class="font-medium">${item.bidderName || '-'}</div>
                                    <div class="text-xs text-gray-500">${item.bidderEmail || '-'}</div>
                                </td>
                                <td class="px-6 py-3 whitespace-nowrap text-sm text-gray-900">${item.companyName || '-'}</td>
                                <td class="px-6 py-3 whitespace-nowrap">${paymentTypeBadge}</td>
                                <td class="px-6 py-3 whitespace-nowrap text-sm font-medium text-gray-900">
                                    ₹${formatAmount(item.refundAmount)}
                                </td>
                                <td class="px-6 py-3 whitespace-nowrap text-sm text-gray-900">
                                    <div>${approvedDate}</div>
                                    ${item.approvedByName ?
                        `<div class="text-xs text-gray-500">by ${item.approvedByName}</div>` :
                        ''}
                                </td>
                                <td class="px-6 py-3 whitespace-nowrap">${paymentStatusBadge}</td>
                                <td class="px-6 py-3 whitespace-nowrap text-sm">
                                    ${actionButtons}
                                </td>
                            </tr>
                        `);
            });
        }

        function viewRefundDetails(refundPaymentId) {
            // Create a modal to show refund details or navigate to a details page
            showRefundDetailsModal(refundPaymentId);
        }

        function showRefundDetailsModal(refundPaymentId) {
            // For now, navigate to a details page. You can implement a modal later if needed
            window.location.href = '/Refund/Details/' + refundPaymentId;
        }

        function getPaymentTypeBadge(type) {
            if (!type) return '<span class="px-2 py-1 text-xs font-medium bg-gray-100 text-gray-800 rounded-full">Other</span>';

            const typeStr = type.toLowerCase();
            if (typeStr.includes('bid') || typeStr.includes('emd')) {
                return `<span class="px-2 py-1 text-xs font-medium bg-purple-100 text-purple-800 rounded-full">${type}</span>`;
            } else if (typeStr.includes('security')) {
                return `<span class="px-2 py-1 text-xs font-medium bg-indigo-100 text-indigo-800 rounded-full">${type}</span>`;
            } else if (typeStr.includes('processing')) {
                return `<span class="px-2 py-1 text-xs font-medium bg-green-100 text-green-800 rounded-full">${type}</span>`;
            }
            return `<span class="px-2 py-1 text-xs font-medium bg-gray-100 text-gray-800 rounded-full">${type}</span>`;
        }

        function renderPagination(totalPages, totalRecords, currentPage) {
            const container = $('#paginationContainer');
            container.empty();

            if (totalPages <= 0) {
                return;
            }

            const info = $('<div class="text-sm text-gray-700"></div>');
            const startItem = ((currentPage - 1) * 10) + 1;
            const endItem = Math.min(currentPage * 10, totalRecords);
            info.text(`Showing ${startItem} to ${endItem} of ${totalRecords} results`);

            const pagination = $('<div class="flex space-x-1"></div>');

            if (currentPage > 1) {
                pagination.append(`
                            <button onclick="loadApprovedRefunds(${currentPage - 1})"
                                    class="px-3 py-1 text-sm border rounded hover:bg-gray-100">
                                Previous
                            </button>
                        `);
            }

            for (let i = Math.max(1, currentPage - 2); i <= Math.min(totalPages, currentPage + 2); i++) {
                const btnClass = i === currentPage ? 'bg-blue-600 text-white' : 'hover:bg-gray-100';
                pagination.append(`
                            <button onclick="loadApprovedRefunds(${i})"
                                    class="px-3 py-1 text-sm border rounded ${btnClass}">
                                ${i}
                            </button>
                        `);
            }

            if (currentPage < totalPages) {
                pagination.append(`
                            <button onclick="loadApprovedRefunds(${currentPage + 1})"
                                    class="px-3 py-1 text-sm border rounded hover:bg-gray-100">
                                Next
                            </button>
                        `);
            }

            container.append(info);
            container.append(pagination);
        }

        function updateStatistics(data) {
            if (!data || data.length === 0) {
                $('#totalApproved').text(0);
                $('#totalAmount').text('₹0');
                $('#thisMonth').text(0);
                $('#processed').text(0);
                return;
            }

            // Total count
            $('#totalApproved').text(data.length);

            // Calculate total amount
            const totalAmount = data.reduce((sum, item) => sum + (item.refundAmount || 0), 0);
            $('#totalAmount').text('₹' + formatAmount(totalAmount));

            // Count processed
            const processedCount = data.filter(item => item.paymentProcessed).length;
            $('#processed').text(processedCount);

            // Count this month
            const currentMonth = new Date().getMonth();
            const currentYear = new Date().getFullYear();
            const thisMonthCount = data.filter(item => {
                if (!item.approvedAt) return false;
                const approvedDate = new Date(item.approvedAt);
                return approvedDate.getMonth() === currentMonth && approvedDate.getFullYear() === currentYear;
            }).length;
            $('#thisMonth').text(thisMonthCount);
        }

        function formatAmount(amount) {
            return new Intl.NumberFormat('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(amount || 0);
        }

        function showAlert(type, message) {
            const alertClass = type === 'success' ? 'border-green-500' :
                type === 'error' ? 'border-red-500' :
                    'border-blue-500';

            const toast = $(`
                        <div class="fixed top-4 right-4 z-50 max-w-sm">
                            <div class="bg-white rounded-lg shadow-lg p-4 border-l-4 ${alertClass}">
                                <div class="flex items-center">
                                    <span class="text-gray-800">${message}</span>
                                </div>
                            </div>
                        </div>
                    `);

            $('body').append(toast);
            setTimeout(() => toast.fadeOut(() => toast.remove()), 3000);
        }
    </script>
}