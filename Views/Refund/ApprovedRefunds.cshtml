@{
    ViewData["Title"] = "Approved Refund Transactions";
    var userRole = ViewBag.UserRole ?? "";
}

<div class="container-fluid px-4 py-8">
    <!-- Header Section -->
    <div class="mb-6 flex justify-between items-center">
        <div>
            <h1 class="text-2xl font-bold text-gray-800">Approved Refund Transactions</h1>
            <p class="text-gray-600 mt-1">View all approved refund requests</p>
        </div>
        <div>
            <a href="@Url.Action("Index", "Refund")" class="bg-gray-600 text-white px-4 py-2 rounded-lg hover:bg-gray-700 transition duration-200">
                Back to Pending Refunds
            </a>
        </div>
    </div>

    <!-- Search Filters -->
    <div class="bg-white rounded-lg shadow-sm p-4 mb-6">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div>
                <input type="text"
                       id="searchTenderId"
                       placeholder="Tender ID"
                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" />
            </div>
            <div>
                <input type="text"
                       id="searchTenderName"
                       placeholder="Tender Name"
                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" />
            </div>
            <div>
                <input type="date"
                       id="searchFromDate"
                       placeholder="From Date"
                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" />
            </div>
            <div>
                <button onclick="loadApprovedRefunds(1)"
                        class="w-full bg-blue-800 text-white px-6 py-2 rounded-lg hover:bg-blue-700 transition duration-200 flex items-center justify-center">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                    Search
                </button>
            </div>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
        <div class="bg-white rounded-lg shadow p-4">
            <div class="text-sm text-gray-600">Total Approved</div>
            <div class="text-2xl font-bold text-green-600" id="totalApproved">0</div>
        </div>
        <div class="bg-white rounded-lg shadow p-4">
            <div class="text-sm text-gray-600">Total Amount</div>
            <div class="text-2xl font-bold text-blue-600" id="totalAmount">₹0</div>
        </div>
        <div class="bg-white rounded-lg shadow p-4">
            <div class="text-sm text-gray-600">This Month</div>
            <div class="text-2xl font-bold text-purple-600" id="thisMonth">0</div>
        </div>
        <div class="bg-white rounded-lg shadow p-4">
            <div class="text-sm text-gray-600">Processing</div>
            <div class="text-2xl font-bold text-orange-600" id="processing">0</div>
        </div>
    </div>

    <!-- Main Table -->
    <div class="bg-white rounded-lg shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tender ID</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tender Title</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Bidder Name</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Company Name</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Refund Amount</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Approved Date</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Approved By</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Payment Status</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody id="approvedTableBody" class="bg-white divide-y divide-gray-200">
                    <!-- Table rows will be loaded here via AJAX -->
                </tbody>
            </table>
        </div>

        <!-- Loading indicator -->
        <div id="loadingIndicator" class="hidden text-center py-8">
            <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
            <p class="mt-2 text-gray-600">Loading...</p>
        </div>

        <!-- No data message -->
        <div id="noDataMessage" class="hidden text-center py-8">
            <p class="text-gray-500">No approved refunds found.</p>
        </div>
    </div>

    <!-- Pagination -->
    <div id="paginationContainer" class="bg-white rounded-lg shadow-sm px-6 py-3 mt-4 flex items-center justify-between">
        <!-- Pagination will be loaded here via AJAX -->
    </div>
</div>

@section Scripts {
    <script>
        let currentPage = 1;
        const userRole = '@userRole';

        $(document).ready(function () {
            loadApprovedRefunds(1);

            // Enter key press for search
            $('#searchTenderId, #searchTenderName').keypress(function (e) {
                if (e.which == 13) {
                    loadApprovedRefunds(1);
                }
            });
        });

        function loadApprovedRefunds(page) {
            currentPage = page;

            $('#loadingIndicator').removeClass('hidden');
            $('#approvedTableBody').empty();
            $('#noDataMessage').addClass('hidden');

            const filter = {
                TenderId: $('#searchTenderId').val(),
                TenderName: $('#searchTenderName').val(),
                FromDate: $('#searchFromDate').val(),
                PageNumber: page,
                PageSize: 25,
                RefundStatus: 'Approved'
            };

            $.ajax({
                url: '@Url.Action("GetApprovedRefundsList", "Refund")',
                type: 'GET',
                data: filter,
                success: function (response) {
                    $('#loadingIndicator').addClass('hidden');

                    if (response.success) {
                        renderApprovedTable(response.data);
                        renderPagination(response.data);
                        updateStatistics(response.data);
                    } else {
                        $('#noDataMessage').removeClass('hidden');
                    }
                },
                error: function (xhr, status, error) {
                    $('#loadingIndicator').addClass('hidden');
                    $('#noDataMessage').removeClass('hidden');
                    alert('Error loading approved refunds');
                }
            });
        }

        function renderApprovedTable(data) {
            const tbody = $('#approvedTableBody');
            tbody.empty();

            if (!data.items || data.items.length === 0) {
                $('#noDataMessage').removeClass('hidden');
                return;
            }

            data.items.forEach(function (item) {
                const approvedDate = item.approvedAt ? new Date(item.approvedAt).toLocaleDateString('en-IN') : '-';
                const paymentStatusBadge = item.paymentProcessed
                    ? '<span class="px-2 py-1 text-xs font-medium bg-green-100 text-green-800 rounded-full">Processed</span>'
                    : '<span class="px-2 py-1 text-xs font-medium bg-yellow-100 text-yellow-800 rounded-full">Processing</span>';

                tbody.append(`
                            <tr class="hover:bg-gray-50">
                                <td class="px-6 py-3 whitespace-nowrap text-sm text-gray-900">${item.tenderIdString}</td>
                                <td class="px-6 py-3 text-sm text-gray-900">${item.tenderTitle}</td>
                                <td class="px-6 py-3 whitespace-nowrap text-sm text-gray-900">${item.bidderName}</td>
                                <td class="px-6 py-3 whitespace-nowrap text-sm text-gray-900">${item.companyName || '-'}</td>
                                <td class="px-6 py-3 whitespace-nowrap text-sm font-medium text-gray-900">₹ ${item.refundAmount.toLocaleString('en-IN', { minimumFractionDigits: 2 })}</td>
                                <td class="px-6 py-3 whitespace-nowrap text-sm text-gray-900">${approvedDate}</td>
                                <td class="px-6 py-3 whitespace-nowrap text-sm text-gray-900">${item.approvedByName || '-'}</td>
                                <td class="px-6 py-3 whitespace-nowrap">${paymentStatusBadge}</td>
                                <td class="px-6 py-3 whitespace-nowrap text-sm">
                                    <button onclick="viewDetails(${item.refundPaymentId})" class="text-blue-600 hover:text-blue-900">
                                        View Details
                                    </button>
                                </td>
                            </tr>
                        `);
            });
        }

        function renderPagination(data) {
            const container = $('#paginationContainer');
            container.empty();

            const info = $('<div class="text-sm text-gray-700"></div>');
            const startItem = (data.currentPage - 1) * data.pageSize + 1;
            const endItem = Math.min(data.currentPage * data.pageSize, data.totalCount);
            info.text(`Showing ${startItem} to ${endItem} of ${data.totalCount} results`);

            const pagination = $('<div class="flex space-x-1"></div>');

            if (data.hasPreviousPage) {
                pagination.append(`<button onclick="loadApprovedRefunds(${data.currentPage - 1})" class="px-3 py-1 text-sm border rounded hover:bg-gray-100">Previous</button>`);
            }

            for (let i = Math.max(1, data.currentPage - 2); i <= Math.min(data.totalPages, data.currentPage + 2); i++) {
                const btnClass = i === data.currentPage ? 'bg-blue-600 text-white' : 'hover:bg-gray-100';
                pagination.append(`<button onclick="loadApprovedRefunds(${i})" class="px-3 py-1 text-sm border rounded ${btnClass}">${i}</button>`);
            }

            if (data.hasNextPage) {
                pagination.append(`<button onclick="loadApprovedRefunds(${data.currentPage + 1})" class="px-3 py-1 text-sm border rounded hover:bg-gray-100">Next</button>`);
            }

            container.append(info);
            container.append(pagination);
        }

        function updateStatistics(data) {
            // Update statistics cards
            $('#totalApproved').text(data.totalCount || 0);

            // Calculate total amount from items
            if (data.items && data.items.length > 0) {
                const totalAmount = data.items.reduce((sum, item) => sum + item.refundAmount, 0);
                $('#totalAmount').text('₹' + totalAmount.toLocaleString('en-IN', { minimumFractionDigits: 2 }));

                // Count processing
                const processingCount = data.items.filter(item => !item.paymentProcessed).length;
                $('#processing').text(processingCount);

                // Count this month
                const currentMonth = new Date().getMonth();
                const thisMonthCount = data.items.filter(item => {
                    const approvedDate = new Date(item.approvedAt);
                    return approvedDate.getMonth() === currentMonth;
                }).length;
                $('#thisMonth').text(thisMonthCount);
            }
        }

        function viewDetails(refundPaymentId) {
            // You can implement a modal or redirect to a details page
            alert('View details for refund ID: ' + refundPaymentId);
        }
    </script>
}