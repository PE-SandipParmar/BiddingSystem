@model BiddingSystem.ViewModels.ApprovedRefundViewModel
@{
    ViewData["Title"] = "Refund Details";
}

<div class="container-fluid px-4 py-8">
    <div class="max-w-4xl mx-auto">
        <!-- Header -->
        <div class="mb-6">
            <div class="flex justify-between items-center">
                <h1 class="text-2xl font-bold text-gray-800">Refund Details</h1>
                <a href="@Url.Action("ApprovedRefunds", "Refund")"
                   class="bg-gray-500 text-white px-4 py-2 rounded-lg hover:bg-gray-600 transition">
                    Back to List
                </a>
            </div>
        </div>

        <!-- Main Card -->
        <div class="bg-white rounded-lg shadow-sm p-6">
            <!-- Status Badge -->
            <div class="mb-6">
                @if (Model.RefundStatus == "Approved" && !string.IsNullOrEmpty(Model.RazorpayRefundId))
                {
                    <span class="px-3 py-1 text-sm font-medium bg-green-100 text-green-800 rounded-full">
                        Successfully Refunded
                    </span>
                }
                else if (Model.RefundStatus == "Approved")
                {
                    <span class="px-3 py-1 text-sm font-medium bg-blue-100 text-blue-800 rounded-full">
                        Approved
                    </span>
                }
                else if (Model.RefundStatus == "Failed")
                {
                    <span class="px-3 py-1 text-sm font-medium bg-red-100 text-red-800 rounded-full">
                        Refund Failed
                    </span>
                }
                else if (Model.RefundStatus == "Rejected")
                {
                    <span class="px-3 py-1 text-sm font-medium bg-gray-100 text-gray-800 rounded-full">
                        Rejected
                    </span>
                }
                else
                {
                    <span class="px-3 py-1 text-sm font-medium bg-yellow-100 text-yellow-800 rounded-full">
                        @Model.RefundStatus
                    </span>
                }
            </div>

            <!-- Tender Information -->
            <div class="border-b pb-4 mb-4">
                <h2 class="text-lg font-semibold text-gray-700 mb-3">Tender Information</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <p class="text-sm text-gray-500">Tender ID</p>
                        <p class="font-medium">@Model.TenderIdString</p>
                    </div>
                    <div>
                        <p class="text-sm text-gray-500">Tender Title</p>
                        <p class="font-medium">@Model.TenderTitle</p>
                    </div>
                </div>
            </div>

            <!-- Bidder Information -->
            <div class="border-b pb-4 mb-4">
                <h2 class="text-lg font-semibold text-gray-700 mb-3">Bidder Information</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <p class="text-sm text-gray-500">Bidder Name</p>
                        <p class="font-medium">@Model.BidderName</p>
                    </div>
                    <div>
                        <p class="text-sm text-gray-500">Company Name</p>
                        <p class="font-medium">@(Model.CompanyName ?? "N/A")</p>
                    </div>
                    <div>
                        <p class="text-sm text-gray-500">Email</p>
                        <p class="font-medium">@Model.BidderEmail</p>
                    </div>
                    <div>
                        <p class="text-sm text-gray-500">Bid ID</p>
                        <p class="font-medium">#@Model.TenderBidId</p>
                    </div>
                </div>
            </div>

            <!-- Refund Information -->
            <div class="border-b pb-4 mb-4">
                <h2 class="text-lg font-semibold text-gray-700 mb-3">Refund Information</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <p class="text-sm text-gray-500">Refund Amount</p>
                        <p class="font-medium text-lg">₹ @Model.RefundAmount.ToString("N2")</p>
                    </div>
                    <div>
                        <p class="text-sm text-gray-500">Refund Payment ID</p>
                        <p class="font-medium">#@Model.RefundPaymentId</p>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.RazorpayRefundId))
                    {
                        <div>
                            <p class="text-sm text-gray-500">Razorpay Refund ID</p>
                            <p class="font-mono text-sm bg-gray-100 p-2 rounded">@Model.RazorpayRefundId</p>
                        </div>
                    }
                    <div>
                        <p class="text-sm text-gray-500">Reason for Refund</p>
                        <p class="font-medium">@Model.ReasonForRefund</p>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.RefundErrorMessage))
                {
                    <div class="mt-4 p-3 bg-red-50 border border-red-200 rounded">
                        <p class="text-sm text-gray-500">Error Message</p>
                        <p class="text-red-700">@Model.RefundErrorMessage</p>
                    </div>
                }
            </div>

            <!-- Processing Information -->
            <div class="border-b pb-4 mb-4">
                <h2 class="text-lg font-semibold text-gray-700 mb-3">Processing Information</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <p class="text-sm text-gray-500">Initiated At</p>
                        <p class="font-medium">@Model.InitiatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                    </div>
                    @if (Model.ApprovedAt.HasValue)
                    {
                        <div>
                            <p class="text-sm text-gray-500">Approved At</p>
                            <p class="font-medium">@Model.ApprovedAt.Value.ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.ApprovedByName))
                    {
                        <div>
                            <p class="text-sm text-gray-500">Approved By</p>
                            <p class="font-medium">@Model.ApprovedByName</p>
                        </div>
                    }
                    <div>
                        <p class="text-sm text-gray-500">Payment Processed</p>
                        <p class="font-medium">
                            @if (Model.PaymentProcessed)
                            {
                                <span class="text-green-600">Yes</span>
                            }
                            else
                            {
                                <span class="text-gray-400">No</span>
                            }
                        </p>
                    </div>
                </div>
            </div>

            <!-- Checker Remarks -->
            @if (!string.IsNullOrEmpty(Model.CheckerRemarks))
            {
                <div>
                    <h2 class="text-lg font-semibold text-gray-700 mb-3">Checker Remarks</h2>
                    <div class="bg-gray-50 p-4 rounded">
                        <p class="text-gray-700">@Model.CheckerRemarks</p>
                    </div>
                </div>
            }
        </div>

        <!-- Action Buttons -->
        <div class="mt-6 flex justify-end space-x-3">
            <a href="/TenderBid/Details/@Model.TenderBidId"
               class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition">
                View Tender Bid
            </a>
            @if (!string.IsNullOrEmpty(Model.RazorpayRefundId))
            {
                <button onclick="checkRefundStatus('@Model.RazorpayRefundId')"
                        class="bg-gray-600 text-white px-4 py-2 rounded-lg hover:bg-gray-700 transition">
                    Check Refund Status
                </button>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function checkRefundStatus(refundId) {
            // You can implement a real-time status check here if needed
            alert('Refund ID: ' + refundId + '\nStatus: Processed\n\nFor detailed status, check Razorpay dashboard.');
        }
    </script>
}