@model BiddingSystem.ViewModels.ApprovedRefundViewModel
@{
    ViewData["Title"] = "Refund Details";
    var userRole = ViewBag.UserRole ?? "";
}

<div class="container-fluid px-4 py-8">
    <!-- Header Section -->
    <div class="mb-6 flex justify-between items-center">
        <div>
            <h1 class="text-2xl font-bold text-gray-800">Refund Details</h1>
            <p class="text-gray-600 mt-1">View detailed information about this refund</p>
        </div>
        <div>
            <a href="@Url.Action("ApprovedRefunds", "Refund")" class="bg-gray-600 text-white px-4 py-2 rounded-lg hover:bg-gray-700 transition duration-200">
                <i class="ri-arrow-left-line mr-2"></i>Back to Approved Refunds
            </a>
        </div>
    </div>

    <!-- Refund Information Card -->
    <div class="bg-white rounded-lg shadow-sm p-6 mb-6">
        <div class="flex justify-between items-center mb-4">
            <h2 class="text-lg font-semibold text-gray-800">Refund Information</h2>
            <div class="flex space-x-2">
                @if (Model.PaymentProcessed)
                {
                    <span class="px-3 py-1 text-xs font-medium bg-green-100 text-green-800 rounded-full">Processed</span>
                }
                else
                {
                    <span class="px-3 py-1 text-xs font-medium bg-yellow-100 text-yellow-800 rounded-full">Processing</span>
                }
                <span class="px-3 py-1 text-xs font-medium bg-blue-100 text-blue-800 rounded-full">@Model.RefundStatus</span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Left Column -->
            <div class="space-y-4">
                <div>
                    <label class="text-sm font-medium text-gray-500">Refund Payment ID</label>
                    <p class="text-sm text-gray-900">#@Model.RefundPaymentId</p>
                </div>
                <div>
                    <label class="text-sm font-medium text-gray-500">Tender ID</label>
                    <p class="text-sm text-gray-900">@Model.TenderIdString</p>
                </div>
                <div>
                    <label class="text-sm font-medium text-gray-500">Tender Title</label>
                    <p class="text-sm text-gray-900">@Model.TenderTitle</p>
                </div>
                <div>
                    <label class="text-sm font-medium text-gray-500">Refund Amount</label>
                    <p class="text-lg font-semibold text-green-600">₹@Model.RefundAmount.ToString("N2")</p>
                </div>
                <div>
                    <label class="text-sm font-medium text-gray-500">Reason for Refund</label>
                    <p class="text-sm text-gray-900">@Model.ReasonForRefund</p>
                </div>
            </div>

            <!-- Right Column -->
            <div class="space-y-4">
                <div>
                    <label class="text-sm font-medium text-gray-500">Bidder Name</label>
                    <p class="text-sm text-gray-900">@Model.BidderName</p>
                </div>
                <div>
                    <label class="text-sm font-medium text-gray-500">Company Name</label>
                    <p class="text-sm text-gray-900">@(string.IsNullOrEmpty(Model.CompanyName) ? "N/A" : Model.CompanyName)</p>
                </div>
                <div>
                    <label class="text-sm font-medium text-gray-500">Bidder Email</label>
                    <p class="text-sm text-gray-900">@(string.IsNullOrEmpty(Model.BidderEmail) ? "N/A" : Model.BidderEmail)</p>
                </div>
                <div>
                    <label class="text-sm font-medium text-gray-500">Initiated At</label>
                    <p class="text-sm text-gray-900">@Model.InitiatedAt.ToString("dd MMM yyyy HH:mm")</p>
                </div>
                <div>
                    <label class="text-sm font-medium text-gray-500">Approved At</label>
                    <p class="text-sm text-gray-900">@(Model.ApprovedAt?.ToString("dd MMM yyyy HH:mm") ?? "N/A")</p>
                </div>
                <div>
                    <label class="text-sm font-medium text-gray-500">Approved By</label>
                    <p class="text-sm text-gray-900">@(string.IsNullOrEmpty(Model.ApprovedByName) ? "N/A" : Model.ApprovedByName)</p>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.CheckerRemarks))
        {
            <div class="mt-6 pt-6 border-t border-gray-200">
                <label class="text-sm font-medium text-gray-500">Checker Remarks</label>
                <p class="text-sm text-gray-900 mt-1">@Model.CheckerRemarks</p>
            </div>
        }
    </div>

    <!-- Tender Bid Information Card -->
    <div class="bg-white rounded-lg shadow-sm p-6 mb-6">
        <h2 class="text-lg font-semibold text-gray-800 mb-4">Related Tender Bid Information</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-4">
                <div>
                    <label class="text-sm font-medium text-gray-500">Tender Bid ID</label>
                    <p class="text-sm text-gray-900">#@Model.TenderBidId</p>
                </div>
                <div>
                    <label class="text-sm font-medium text-gray-500">Tender ID</label>
                    <p class="text-sm text-gray-900">@Model.TenderIdString</p>
                </div>
            </div>
            <div class="space-y-4">
                <div>
                    <label class="text-sm font-medium text-gray-500">Bidder Name</label>
                    <p class="text-sm text-gray-900">@Model.BidderName</p>
                </div>
                <div>
                    <label class="text-sm font-medium text-gray-500">Company Name</label>
                    <p class="text-sm text-gray-900">@(string.IsNullOrEmpty(Model.CompanyName) ? "N/A" : Model.CompanyName)</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Status Timeline -->
    <div class="bg-white rounded-lg shadow-sm p-6">
        <h2 class="text-lg font-semibold text-gray-800 mb-4">Status Timeline</h2>
        
        <div class="space-y-4">
            <!-- Initiated -->
            <div class="flex items-start space-x-3">
                <div class="flex-shrink-0">
                    <div class="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center">
                        <i class="ri-add-line text-blue-600 text-sm"></i>
                    </div>
                </div>
                <div class="flex-1">
                    <h3 class="text-sm font-medium text-gray-900">Refund Initiated</h3>
                    <p class="text-sm text-gray-500">@Model.InitiatedAt.ToString("dd MMM yyyy HH:mm")</p>
                </div>
            </div>

            <!-- Approved -->
            @if (Model.ApprovedAt.HasValue)
            {
                <div class="flex items-start space-x-3">
                    <div class="flex-shrink-0">
                        <div class="w-8 h-8 bg-green-100 rounded-full flex items-center justify-center">
                            <i class="ri-check-line text-green-600 text-sm"></i>
                        </div>
                    </div>
                    <div class="flex-1">
                        <h3 class="text-sm font-medium text-gray-900">Refund Approved</h3>
                        <p class="text-sm text-gray-500">@Model.ApprovedAt.Value.ToString("dd MMM yyyy HH:mm")</p>
                        @if (!string.IsNullOrEmpty(Model.ApprovedByName))
                        {
                            <p class="text-xs text-gray-400">Approved by: @Model.ApprovedByName</p>
                        }
                    </div>
                </div>
            }

            <!-- Payment Status -->
            <div class="flex items-start space-x-3">
                <div class="flex-shrink-0">
                    <div class="w-8 h-8 @(Model.PaymentProcessed ? "bg-green-100" : "bg-yellow-100") rounded-full flex items-center justify-center">
                        <i class="@(Model.PaymentProcessed ? "ri-check-double-line text-green-600" : "ri-time-line text-yellow-600") text-sm"></i>
                    </div>
                </div>
                <div class="flex-1">
                    <h3 class="text-sm font-medium text-gray-900">Payment @(Model.PaymentProcessed ? "Processed" : "Processing")</h3>
                    <p class="text-sm text-gray-500">@(Model.PaymentProcessed ? "Refund has been processed" : "Refund is being processed")</p>
                </div>
            </div>
        </div>
    </div>
</div>