@model BiddingSystem.ViewModels.DashboardViewModel
@using BiddingSystem.Models
@{
    ViewData["Title"] = "Dashboard";
}

<div class="space-y-6">
    <!-- Page Header -->
    <div class="mb-6">
        <div class="flex flex-wrap items-center justify-between mb-4">
            <div>
                <h2 class="text-2xl font-bold text-gray-800">Dashboard</h2>
                <p class="text-gray-600">@DateTime.Now.ToString("MMMM dd, yyyy") | @DateTime.Now.DayOfWeek</p>
            </div>
            <div class="flex space-x-3 mt-4 sm:mt-0">
               @*  <button class="flex items-center px-4 py-2 bg-white border border-gray-300 rounded-button text-gray-700 hover:bg-gray-50 whitespace-nowrap">
                    <div class="w-4 h-4 flex items-center justify-center mr-2">
                        <i class="ri-download-line"></i>
                    </div>
                    <span>Export</span>
                </button> *@
                <a asp-controller="Tender" asp-action="Create" class="flex items-center px-4 py-2 bg-primary text-white rounded-button hover:bg-primary/90 whitespace-nowrap">
                    <div class="w-4 h-4 flex items-center justify-center mr-2">
                        <i class="ri-add-line"></i>
                    </div>
                    <span>Add Tender</span>
                </a>
            </div>
        </div>

        <!-- Stats Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6 mb-6">
            <div class="bg-white rounded shadow p-5">
                <div class="flex justify-between items-center">
                    <div>
                        <p class="text-gray-500 text-sm">Active Tenders</p>
                        <h3 class="text-2xl font-bold text-gray-800 mt-1">@(Model.Statistics?.ActiveTenders ?? 0)</h3>
                    </div>
                    <div class="w-12 h-12 flex items-center justify-center rounded-full bg-blue-100 text-primary">
                        <i class="ri-file-list-3-line text-xl"></i>
                    </div>
                </div>
             @*    <div class="flex items-center mt-4">
                    <div class="w-4 h-4 flex items-center justify-center text-green-500">
                        <i class="ri-arrow-up-line"></i>
                    </div>
                    <span class="text-green-500 text-sm ml-1">12.5%</span>
                    <span class="text-gray-500 text-sm ml-2">from last month</span>
                </div> *@
            </div>
            
            <div class="bg-white rounded shadow p-5">
                <div class="flex justify-between items-center">
                    <div>
                        <p class="text-gray-500 text-sm">EMD Collected</p>
                        <h3 class="text-2xl font-bold text-gray-800 mt-1">₹ @(((Model.Statistics?.TotalEMDSDAmount ?? 0) / 1000000).ToString("F1"))M</h3>
                        <p class="text-xs text-gray-400 mt-1">Raw: ₹@(Model.Statistics?.TotalEMDSDAmount.ToString("N0") ?? "0")</p>
                    </div>
                    <div class="w-12 h-12 flex items-center justify-center rounded-full bg-green-100 text-green-600">
                        <i class="ri-money-dollar-circle-line text-xl"></i>
                    </div>
                </div>
              @*   <div class="flex items-center mt-4">
                    <div class="w-4 h-4 flex items-center justify-center text-green-500">
                        <i class="ri-arrow-up-line"></i>
                    </div>
                    <span class="text-green-500 text-sm ml-1">8.2%</span>
                    <span class="text-gray-500 text-sm ml-2">from last month</span>
                </div> *@
            </div>
            
            <div class="bg-white rounded shadow p-5">
                <div class="flex justify-between items-center">
                    <div>
                        <p class="text-gray-500 text-sm">SD Collected</p>
                        <h3 class="text-2xl font-bold text-gray-800 mt-1">₹ @(((Model.Statistics?.TotalSDAmount ?? 0) / 1000000).ToString("F1"))M</h3>
                        <p class="text-xs text-gray-400 mt-1">Raw: ₹@(Model.Statistics?.TotalSDAmount.ToString("N0") ?? "0")</p>
                    </div>
                    <div class="w-12 h-12 flex items-center justify-center rounded-full bg-indigo-100 text-indigo-600">
                        <i class="ri-secure-payment-line text-xl"></i>
                    </div>
                </div>
               @*  <div class="flex items-center mt-4">
                    <div class="w-4 h-4 flex items-center justify-center text-green-500">
                        <i class="ri-arrow-up-line"></i>
                    </div>
                    <span class="text-green-500 text-sm ml-1">6.7%</span>
                    <span class="text-gray-500 text-sm ml-2">from last month</span>
                </div> *@
            </div>
            
            <div class="bg-white rounded shadow p-5">
                <div class="flex justify-between items-center">
                    <div>
                        <p class="text-gray-500 text-sm">Pending Refunds</p>
                        <h3 class="text-2xl font-bold text-gray-800 mt-1">@(Model.Statistics?.PendingRefunds ?? 0)</h3>
                        <p class="text-xs text-gray-400 mt-1">EMDSDDeposits | Status: Pending</p>
                    
                      @*   <p class="text-xs text-gray-400 mt-1">Status: Pending (1)</p> *@
                    </div>
                    <div class="w-12 h-12 flex items-center justify-center rounded-full bg-yellow-100 text-yellow-600">
                        <i class="ri-refund-2-line text-xl"></i>
                    </div>
                </div>
              @*   <div class="flex items-center mt-4">
                    <div class="w-4 h-4 flex items-center justify-center text-red-500">
                        <i class="ri-arrow-up-line"></i>
                    </div>
                    <span class="text-red-500 text-sm ml-1">3.1%</span>
                    <span class="text-gray-500 text-sm ml-2">from last month</span>
                </div> *@
            </div>
            
            <div class="bg-white rounded shadow p-5">
                <div class="flex justify-between items-center">
                    <div>
                        <p class="text-gray-500 text-sm">Processed Refunds</p>
                        <h3 class="text-2xl font-bold text-gray-800 mt-1">@(Model.Statistics?.ProcessedRefunds ?? 0)</h3>
                        <p class="text-xs text-gray-400 mt-1">EMDSDDeposits | Status: Refunded</p>
                     
        @*                 <p class="text-xs text-gray-400 mt-1">Status: Completed (4)</p> *@
                    </div>
                    <div class="w-12 h-12 flex items-center justify-center rounded-full bg-teal-100 text-teal-600">
                        <i class="ri-bank-card-line text-xl"></i>
                    </div>
                </div>
              @*   <div class="flex items-center mt-4">
                    <div class="w-4 h-4 flex items-center justify-center text-green-500">
                        <i class="ri-arrow-up-line"></i>
                    </div>
                    <span class="text-green-500 text-sm ml-1">22.1%</span>
                    <span class="text-gray-500 text-sm ml-2">from last month</span>
                </div> *@
            </div>
        </div>

        <!-- Main Content Grid -->
        <div class="space-y-6">
            <!-- Tender Overview -->
            <div class="bg-white rounded shadow">
                <div class="flex items-center justify-between p-5 border-b">
                    <h3 class="text-lg font-semibold text-gray-800">Tender Overview</h3>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead>
                            <tr class="bg-gray-50">
                                <th class="px-5 py-3 text-left text-sm font-semibold text-gray-500 tracking-wider">Tender ID</th>
                                <th class="px-5 py-3 text-left text-sm font-semibold text-gray-500 tracking-wider">Tender Title</th>
                                <th class="px-5 py-3 text-left text-sm font-semibold text-gray-500 tracking-wider">Publish Date</th>
                                <th class="px-5 py-3 text-left text-sm font-semibold text-gray-500 tracking-wider">EMD/SD Amount</th>
                                <th class="px-5 py-3 text-left text-sm font-semibold text-gray-500 tracking-wider">No. of Bidder</th>
                                <th class="px-5 py-3 text-left text-sm font-semibold text-gray-500 tracking-wider">Last date of EMD</th>
                                <th class="px-5 py-3 text-left text-sm font-semibold text-gray-500 tracking-wider">Status</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200">
                            @if (Model.RecentTenders.Any())
                            {
                                @foreach (var tender in Model.RecentTenders.Take(5))
                                {
                                    <tr>
                                        <td class="px-5 py-4 text-sm text-gray-800">@tender.TenderId</td>
                                        <td class="px-5 py-4 text-sm text-gray-800">@tender.TenderTitle</td>
                                        <td class="px-5 py-4 text-sm text-gray-800">@tender.PublishDate.ToString("yyyy-MM-dd")</td>
                                        <td class="px-5 py-4 text-sm text-gray-800">@tender.EmdAmount.ToString("N2")</td>
                                        <td class="px-5 py-4 text-sm text-gray-800">@(Model.RecentBids?.Count(b => b.TenderId == tender.Id) ?? 0)</td>
                                        <td class="px-5 py-4 text-sm text-gray-800">@tender.TenderClosingDate?.ToString("yyyy-MM-dd")</td>
                                        <td class="px-5 py-4">
                                            <span class="px-2 py-1 text-xs rounded-full @(tender.Status == TenderStatus.Published ? "bg-green-100 text-green-800" : tender.Status == TenderStatus.Closed ? "bg-red-100 text-red-800" : "bg-yellow-100 text-yellow-800")">
                                                @tender.StatusDisplayName
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="px-5 py-12 text-center">
                                        <div class="text-gray-500">
                                            <i class="ri-inbox-line text-4xl mb-4"></i>
                                            <p class="text-lg font-medium">No tenders available</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Charts Section -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="bg-white rounded shadow p-5">
                    <h3 class="text-lg font-semibold text-gray-800 mb-4">EMD Collection Trends</h3>
                    <div id="emdChart" class="w-full h-64"></div>
                </div>
                <div class="bg-white rounded shadow p-5">
                    <h3 class="text-lg font-semibold text-gray-800 mb-4">Tender Status Distribution</h3>
                    <div id="tenderChart" class="w-full h-64"></div>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // EMD Collection Trends Chart
            const emdChart = echarts.init(document.getElementById('emdChart'));
            
            // Load EMD trends data
            fetch('/Dashboard/GetMonthlyTrends?year=@Model.SelectedYear')
                .then(response => response.json())
                .then(data => {
                    if (data.error) {
                        console.error('Error loading EMD trends:', data.error);
                        return;
                    }
                    
                    const emdOption = {
                        animation: false,
                        tooltip: {
                            trigger: 'axis',
                            backgroundColor: 'rgba(255, 255, 255, 0.8)',
                            borderColor: '#e2e8f0',
                            textStyle: {
                                color: '#1f2937'
                            }
                        },
                        grid: {
                            top: 10,
                            right: 10,
                            bottom: 30,
                            left: 50
                        },
                        xAxis: {
                            type: 'category',
                            data: data.months || ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul'],
                            axisLine: {
                                lineStyle: {
                                    color: '#e2e8f0'
                                }
                            },
                            axisLabel: {
                                color: '#1f2937'
                            }
                        },
                        yAxis: {
                            type: 'value',
                            axisLine: {
                                show: false
                            },
                            axisLabel: {
                                color: '#1f2937'
                            },
                            splitLine: {
                                lineStyle: {
                                    color: '#e2e8f0'
                                }
                            }
                        },
                        series: [{
                            name: 'EMD Collections',
                            data: data.totalEMDSDAmounts ? data.totalEMDSDAmounts.map(amount => (amount / 1000000).toFixed(1)) : [0.8, 1.2, 1.7, 2.3, 2.8, 3.5, 4.2],
                            type: 'line',
                            smooth: true,
                            symbol: 'none',
                            lineStyle: {
                                width: 3,
                                color: 'rgba(87, 181, 231, 1)'
                            },
                            areaStyle: {
                                color: {
                                    type: 'linear',
                                    x: 0,
                                    y: 0,
                                    x2: 0,
                                    y2: 1,
                                    colorStops: [{
                                        offset: 0,
                                        color: 'rgba(87, 181, 231, 0.2)'
                                    }, {
                                        offset: 1,
                                        color: 'rgba(87, 181, 231, 0.05)'
                                    }]
                                }
                            }
                        }]
                    };
                    emdChart.setOption(emdOption);
                })
                .catch(error => {
                    console.error('Error loading EMD trends:', error);
                    // Fallback to static data
                    const emdOption = {
                        animation: false,
                        tooltip: {
                            trigger: 'axis',
                            backgroundColor: 'rgba(255, 255, 255, 0.8)',
                            borderColor: '#e2e8f0',
                            textStyle: {
                                color: '#1f2937'
                            }
                        },
                        grid: {
                            top: 10,
                            right: 10,
                            bottom: 30,
                            left: 50
                        },
                        xAxis: {
                            type: 'category',
                            data: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul'],
                            axisLine: {
                                lineStyle: {
                                    color: '#e2e8f0'
                                }
                            },
                            axisLabel: {
                                color: '#1f2937'
                            }
                        },
                        yAxis: {
                            type: 'value',
                            axisLine: {
                                show: false
                            },
                            axisLabel: {
                                color: '#1f2937'
                            },
                            splitLine: {
                                lineStyle: {
                                    color: '#e2e8f0'
                                }
                            }
                        },
                        series: [{
                            name: 'EMD Collections',
                            data: [0.8, 1.2, 1.7, 2.3, 2.8, 3.5, 4.2],
                            type: 'line',
                            smooth: true,
                            symbol: 'none',
                            lineStyle: {
                                width: 3,
                                color: 'rgba(87, 181, 231, 1)'
                            },
                            areaStyle: {
                                color: {
                                    type: 'linear',
                                    x: 0,
                                    y: 0,
                                    x2: 0,
                                    y2: 1,
                                    colorStops: [{
                                        offset: 0,
                                        color: 'rgba(87, 181, 231, 0.2)'
                                    }, {
                                        offset: 1,
                                        color: 'rgba(87, 181, 231, 0.05)'
                                    }]
                                }
                            }
                        }]
                    };
                    emdChart.setOption(emdOption);
                });

            // Tender Status Distribution Chart
            const tenderChart = echarts.init(document.getElementById('tenderChart'));
            const tenderOption = {
                animation: false,
                tooltip: {
                    trigger: 'item',
                    backgroundColor: 'rgba(255, 255, 255, 0.8)',
                    borderColor: '#e2e8f0',
                    textStyle: {
                        color: '#1f2937'
                    }
                },
                legend: {
                    bottom: '0',
                    left: 'center',
                    textStyle: {
                        color: '#1f2937'
                    }
                },
                series: [{
                    name: 'Tender Status',
                    type: 'pie',
                    radius: ['40%', '70%'],
                    center: ['50%', '45%'],
                    avoidLabelOverlap: false,
                    itemStyle: {
                        borderRadius: 8,
                        borderColor: '#fff',
                        borderWidth: 2
                    },
                    label: {
                        show: false
                    },
                    emphasis: {
                        label: {
                            show: true,
                            fontSize: '12',
                            fontWeight: 'bold'
                        }
                    },
                    labelLine: {
                        show: false
                    },
                    data: [
                        { value: @(Model.Statistics?.ActiveTenders ?? 0), name: 'Active', itemStyle: { color: 'rgba(87, 181, 231, 1)' } },
                        { value: @((Model.Statistics?.TotalTenders ?? 0) - (Model.Statistics?.ActiveTenders ?? 0)), name: 'Other', itemStyle: { color: 'rgba(251, 191, 114, 1)' } }
                    ]
                }]
            };
            tenderChart.setOption(tenderOption);

            // Handle window resize
            window.addEventListener('resize', function() {
                emdChart.resize();
                tenderChart.resize();
            });
        });
    </script>
}