@model BiddingSystem.ViewModels.BidderPaymentDashboardViewModel
@{
    ViewData["Title"] = "Payment Dashboard";
    Layout = "~/Views/Shared/_PaymentLayout.cshtml";
}

<div class="min-h-screen bg-gray-50 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Header -->
        <div class="bg-white rounded-lg shadow-sm p-6 mb-6">
            <div class="flex justify-between items-start">
                <div>
                    <h1 class="text-2xl font-bold text-gray-900">Payment & Refund Dashboard</h1>
                    <p class="text-gray-600 mt-1">Welcome, @Model.BidderName</p>
                    <div class="flex gap-4 mt-2 text-sm text-gray-500">
                        <span><i class="ri-mail-line"></i> @Model.BidderEmail</span>
                        <span><i class="ri-phone-line"></i> @Model.BidderPhone</span>
                        <span><i class="ri-building-line"></i> @Model.CompanyName</span>
                    </div>
                </div>
                <button onclick="window.print()" class="px-4 py-2 text-gray-600 hover:text-gray-900">
                    <i class="ri-printer-line mr-2"></i> Print
                </button>
            </div>
        </div>

        <!-- Payment Summary Cards -->
        <div class="grid grid-cols-1 md:grid-cols-5 gap-4 mb-6">
            <div class="bg-white rounded-lg shadow-sm p-4">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-gray-600">Total Bids</p>
                        <p class="text-2xl font-bold text-gray-900">@Model.TotalBids</p>
                    </div>
                    <div class="bg-blue-100 p-3 rounded-lg">
                        <i class="ri-auction-line text-blue-600 text-xl"></i>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-lg shadow-sm p-4">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-gray-600">Total Amount Due</p>
                        <p class="text-2xl font-bold text-gray-900">₹@Model.TotalAmountDue.ToString("N0")</p>
                    </div>
                    <div class="bg-purple-100 p-3 rounded-lg">
                        <i class="ri-wallet-line text-purple-600 text-xl"></i>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-lg shadow-sm p-4">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-gray-600">Amount Paid</p>
                        <p class="text-2xl font-bold text-green-600">₹@Model.TotalAmountPaid.ToString("N0")</p>
                    </div>
                    <div class="bg-green-100 p-3 rounded-lg">
                        <i class="ri-check-double-line text-green-600 text-xl"></i>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-lg shadow-sm p-4">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-gray-600">Amount Pending</p>
                        <p class="text-2xl font-bold text-orange-600">₹@Model.TotalAmountPending.ToString("N0")</p>
                    </div>
                    <div class="bg-orange-100 p-3 rounded-lg">
                        <i class="ri-time-line text-orange-600 text-xl"></i>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-lg shadow-sm p-4">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-gray-600">Total Refunded</p>
                        <p class="text-2xl font-bold text-indigo-600">₹@Model.TotalRefunded.ToString("N0")</p>
                    </div>
                    <div class="bg-indigo-100 p-3 rounded-lg">
                        <i class="ri-refund-2-line text-indigo-600 text-xl"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tender Bids with Payment Details -->
        @foreach (var tender in Model.TenderBids)
        {
            <div class="bg-white rounded-lg shadow-sm mb-6">
                <!-- Tender Header -->
                <div class="p-6 border-b border-gray-200">
                    <div class="flex justify-between items-start">
                        <div>
                            <h2 class="text-lg font-semibold text-gray-900">@tender.TenderTitle</h2>
                            <div class="flex gap-4 mt-2 text-sm text-gray-600">
                                <span>Tender Ref: <strong>@tender.TenderRefNo</strong></span>
                                <span>Bid ID: <strong>@tender.BidId</strong></span>
                                <span>Submitted: <strong>@tender.SubmittedDate.ToString("dd MMM yyyy")</strong></span>
                            </div>
                            <!-- Bid Status -->
                            <div class="mt-2">
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
                                    @(tender.BidStatus == "Awarded" ? "bg-purple-100 text-purple-800" :
                                      tender.BidStatus == "Rejected" ? "bg-red-100 text-red-800" :
                                      tender.BidStatus == "Under Review" ? "bg-yellow-100 text-yellow-800" :
                                      "bg-gray-100 text-gray-800")">
                                    Bid Status: @tender.BidStatus
                                </span>
                            </div>
                        </div>
                        <div class="text-right">
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium @(tender.IsFullyPaid ? "bg-green-100 text-green-800" : "bg-yellow-100 text-yellow-800")">
                                @(tender.IsFullyPaid ? "Fully Paid" : "Payment Pending")
                            </span>
                            <p class="text-sm text-gray-600 mt-2">
                                Paid: ₹@tender.TotalPaid.ToString("N2") / ₹@tender.TotalAmount.ToString("N2")
                            </p>
                            @if (tender.TotalRefunded > 0)
                            {
                                <p class="text-sm text-indigo-600 mt-1">
                                    Refunded: ₹@tender.TotalRefunded.ToString("N2")
                                </p>
                            }
                        </div>
                    </div>
                </div>

                <!-- Payment Components Table -->
                <div class="p-6">
                    <h3 class="text-md font-medium text-gray-900 mb-4">Payment & Refund Details</h3>
                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-gray-200">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Component</th>
                                    <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Amount</th>
                                    <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">Payment Status</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Payment Details</th>
                                    <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">Refund Status</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Refund Details</th>
                                    <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="bg-white divide-y divide-gray-200">
                                @foreach (var component in tender.PaymentComponents)
                                {
                                    <tr class="hover:bg-gray-50 @(component.HasRefund ? "bg-indigo-50" : "")">
                                        <td class="px-4 py-4 whitespace-nowrap">
                                            <div class="text-sm font-medium text-gray-900">@component.PaymentTypeLabel</div>
                                        </td>
                                        <td class="px-4 py-4 whitespace-nowrap text-right">
                                            <div class="text-sm font-semibold text-gray-900">₹@component.Amount.ToString("N2")</div>
                                        </td>
                                        <!-- Payment Status -->
                                        <td class="px-4 py-4 whitespace-nowrap text-center">
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @component.StatusBadgeClass">
                                                @component.StatusText
                                            </span>
                                            @if (component.IsExpired)
                                            {
                                                <p class="text-xs text-red-600 mt-1">Expired on @component.ExpiryDate?.ToString("dd MMM yyyy")</p>
                                            }
                                        </td>
                                        <!-- Payment Details -->
                                        <td class="px-4 py-4">
                                            @if (component.IsPaid)
                                            {
                                                <div class="text-sm">
                                                    <p class="text-gray-900 font-medium">TXN: @component.TransactionId</p>
                                                    <p class="text-gray-500">@component.PaymentDate?.ToString("dd MMM yyyy HH:mm")</p>
                                                    <p class="text-gray-500">Via: @component.PaymentMethod</p>
                                                </div>
                                            }
                                            else if (component.FailedAttempts > 0)
                                            {
                                                <div class="text-sm text-gray-500">
                                                    <p>Failed attempts: @component.FailedAttempts</p>
                                                    <p>Last attempt: @component.LastAttemptDate?.ToString("dd MMM HH:mm")</p>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-sm text-gray-500">Not attempted</span>
                                            }
                                        </td>
                                        <!-- Refund Status -->
                                        <td class="px-4 py-4 whitespace-nowrap text-center">
                                            @if (component.HasRefund)
                                            {
                                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
                                                    @(component.RefundStatus == "Completed" ? "bg-green-100 text-green-800" :
                                                      component.RefundStatus == "Processing" ? "bg-blue-100 text-blue-800" :
                                                      component.RefundStatus == "Initiated" ? "bg-yellow-100 text-yellow-800" :
                                                      component.RefundStatus == "Failed" ? "bg-red-100 text-red-800" :
                                                      "bg-gray-100 text-gray-800")">
                                                    @component.RefundStatus
                                                </span>
                                            }
                                            else if (component.IsPaid && tender.BidStatus == "Rejected")
                                            {
                                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-800">
                                                    Eligible
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-sm text-gray-400">N/A</span>
                                            }
                                        </td>
                                        <!-- Refund Details -->
                                        <td class="px-4 py-4">
                                            @if (component.HasRefund)
                                            {
                                                <div class="text-sm">
                                                    <p class="text-indigo-700 font-medium">Amount: ₹@component.RefundAmount.ToString("N2")</p>
                                                    @if (!string.IsNullOrEmpty(component.RefundTransactionId))
                                                    {
                                                        <p class="text-gray-600">Refund ID: @component.RefundTransactionId</p>
                                                    }
                                                    @if (component.RefundDate.HasValue)
                                                    {
                                                        <p class="text-gray-500">Date: @component.RefundDate?.ToString("dd MMM yyyy")</p>
                                                    }
                                                    @if (!string.IsNullOrEmpty(component.RefundReason))
                                                    {
                                                        <p class="text-gray-500 text-xs mt-1">Reason: @component.RefundReason</p>
                                                    }
                                                </div>
                                            }
                                            else if (component.IsPaid && tender.BidStatus == "Rejected")
                                            {
                                                <span class="text-sm text-orange-600">Refund will be initiated</span>
                                            }
                                            else
                                            {
                                                <span class="text-sm text-gray-400">-</span>
                                            }
                                        </td>
                                        <!-- Actions -->
                                        <td class="px-4 py-4 whitespace-nowrap text-center">
                                            @if (component.IsPaid)
                                            {
                                                <div class="flex flex-col gap-2">
                                                    <a href="@Url.Action("PaymentReceipt", "BidderPayment", new { transactionId = component.TransactionId })"
                                                       target="_blank"
                                                       class="inline-flex items-center justify-center px-3 py-1 border border-gray-300 text-xs font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
                                                        <i class="ri-download-line mr-1"></i> Receipt
                                                    </a>
                                                    @if (component.HasRefund && component.RefundStatus == "Completed")
                                                    {
                                                        <button onclick="viewRefundReceipt('@component.RefundTransactionId')"
                                                                class="inline-flex items-center justify-center px-3 py-1 border border-indigo-300 text-xs font-medium rounded-md text-indigo-700 bg-white hover:bg-indigo-50">
                                                            <i class="ri-refund-line mr-1"></i> Refund Receipt
                                                        </button>
                                                    }
                                                </div>
                                            }
                                            else if (component.CanPay)
                                            {
                                                <div class="flex flex-col gap-2">
                                                    <a href="@component.PaymentLinkUrl"
                                                       class="inline-flex items-center justify-center px-3 py-1 border border-transparent text-xs font-medium rounded-md text-white bg-green-600 hover:bg-green-700">
                                                        <i class="ri-secure-payment-line mr-1"></i> Pay Now
                                                    </a>
                                                    @if (component.PaymentHistory.Any())
                                                    {
                                                        <button onclick="showPaymentHistory('@component.PaymentLinkId')"
                                                                class="text-xs text-blue-600 hover:text-blue-800">
                                                            View History
                                                        </button>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-sm text-gray-400">N/A</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="bg-gray-50">
                                    <th class="px-4 py-3 text-left text-sm font-medium text-gray-900">Total</th>
                                    <th class="px-4 py-3 text-right text-sm font-bold text-gray-900">₹@tender.TotalAmount.ToString("N2")</th>
                                    <th colspan="2" class="px-4 py-3 text-left text-sm">
                                        <span class="text-green-600 font-medium">Paid: ₹@tender.TotalPaid.ToString("N2")</span>
                                        @if (tender.TotalPending > 0)
                                        {
                                            <span class="text-orange-600 font-medium ml-4">Pending: ₹@tender.TotalPending.ToString("N2")</span>
                                        }
                                    </th>
                                    <th colspan="2" class="px-4 py-3 text-left text-sm">
                                        @if (tender.TotalRefunded > 0)
                                        {
                                            <span class="text-indigo-600 font-medium">Refunded: ₹@tender.TotalRefunded.ToString("N2")</span>
                                        }
                                    </th>
                                    <th></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <!-- Status Messages -->
                    @if (!tender.IsFullyPaid)
                    {
                        <div class="mt-6 p-4 bg-yellow-50 rounded-lg border border-yellow-200">
                            <div class="flex items-start">
                                <i class="ri-information-line text-yellow-400 text-lg mt-0.5"></i>
                                <div class="ml-3 flex-1">
                                    <h4 class="text-sm font-medium text-yellow-800">Payment Required</h4>
                                    <p class="text-sm text-yellow-700 mt-1">
                                        Complete all pending payments to finalize your tender bid submission.
                                        Payment links expire 30 days after generation.
                                    </p>
                                    <div class="mt-3 flex gap-2">
                                        @foreach (var unpaidComponent in tender.PaymentComponents.Where(c => c.CanPay))
                                        {
                                            <a href="@unpaidComponent.PaymentLinkUrl"
                                               class="inline-flex items-center px-3 py-1 border border-transparent text-xs font-medium rounded-md text-white bg-yellow-600 hover:bg-yellow-700">
                                                Pay @unpaidComponent.PaymentTypeLabel
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else if (tender.BidStatus == "Rejected" && tender.TotalRefunded < tender.TotalPaid)
                    {
                        <div class="mt-6 p-4 bg-indigo-50 rounded-lg border border-indigo-200">
                            <div class="flex items-start">
                                <i class="ri-refund-2-line text-indigo-400 text-lg mt-0.5"></i>
                                <div class="ml-3 flex-1">
                                    <h4 class="text-sm font-medium text-indigo-800">Refund in Process</h4>
                                    <p class="text-sm text-indigo-700 mt-1">
                                        Your bid has been rejected. Refunds for paid components are being processed.
                                        @if (tender.TotalRefunded > 0)
                                        {
                                            <span>₹@tender.TotalRefunded.ToString("N2") has been refunded so far.</span>
                                        }
                                    </p>
                                    <div class="mt-3">
                                        <button onclick="refreshRefundStatus(@tender.BidId)"
                                                class="inline-flex items-center px-4 py-2 border border-indigo-300 text-sm font-medium rounded-md text-indigo-700 bg-white hover:bg-indigo-50">
                                            <i class="ri-refresh-line mr-2"></i> Refresh Refund Status
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else if (tender.TotalRefunded > 0)
                    {
                        <div class="mt-6 p-4 bg-green-50 rounded-lg border border-green-200">
                            <div class="flex items-start">
                                <i class="ri-checkbox-circle-line text-green-400 text-lg mt-0.5"></i>
                                <div class="ml-3">
                                    <h4 class="text-sm font-medium text-green-800">Refund Complete</h4>
                                    <p class="text-sm text-green-700 mt-1">
                                        All refunds have been processed successfully. Total refunded: ₹@tender.TotalRefunded.ToString("N2")
                                    </p>
                                </div>
                            </div>
                        </div>
                    }
                    else if (tender.IsFullyPaid)
                    {
                        <div class="mt-6 p-4 bg-green-50 rounded-lg border border-green-200">
                            <div class="flex items-start">
                                <i class="ri-checkbox-circle-line text-green-400 text-lg mt-0.5"></i>
                                <div class="ml-3">
                                    <h4 class="text-sm font-medium text-green-800">Payment Complete</h4>
                                    <p class="text-sm text-green-700 mt-1">
                                        All payment components have been successfully paid for this tender bid.
                                    </p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Help Section -->
        <div class="bg-white rounded-lg shadow-sm p-6">
            <h3 class="text-lg font-medium text-gray-900 mb-4">Need Help?</h3>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="flex items-start">
                    <i class="ri-customer-service-line text-blue-600 text-xl mr-3"></i>
                    <div>
                        <p class="text-sm font-medium text-gray-900">Customer Support</p>
                        <p class="text-sm text-gray-600">support@fssai.gov.in</p>
                        <p class="text-sm text-gray-600">1800-123-4567</p>
                    </div>
                </div>
                <div class="flex items-start">
                    <i class="ri-time-line text-blue-600 text-xl mr-3"></i>
                    <div>
                        <p class="text-sm font-medium text-gray-900">Working Hours</p>
                        <p class="text-sm text-gray-600">Monday - Friday</p>
                        <p class="text-sm text-gray-600">9:00 AM - 6:00 PM</p>
                    </div>
                </div>
                <div class="flex items-start">
                    <i class="ri-file-text-line text-blue-600 text-xl mr-3"></i>
                    <div>
                        <p class="text-sm font-medium text-gray-900">Documentation</p>
                        <a href="#" class="text-sm text-blue-600 hover:text-blue-800">Payment Guide</a><br>
                        <a href="#" class="text-sm text-blue-600 hover:text-blue-800">Refund Policy</a><br>
                        <a href="#" class="text-sm text-blue-600 hover:text-blue-800">FAQs</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Payment History Modal -->
<div id="paymentHistoryModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-lg max-w-2xl w-full max-h-[80vh] overflow-auto">
        <div class="p-6">
            <h3 class="text-lg font-medium text-gray-900 mb-4">Payment History</h3>
            <div id="paymentHistoryContent"></div>
            <button onclick="closePaymentHistory()" class="mt-4 px-4 py-2 bg-gray-100 text-gray-700 rounded-md hover:bg-gray-200">
                Close
            </button>
        </div>
    </div>
</div>

<!-- Refund Details Modal -->
<div id="refundDetailsModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-lg max-w-2xl w-full max-h-[80vh] overflow-auto">
        <div class="p-6">
            <h3 class="text-lg font-medium text-gray-900 mb-4">Refund Details</h3>
            <div id="refundDetailsContent"></div>
            <button onclick="closeRefundDetails()" class="mt-4 px-4 py-2 bg-gray-100 text-gray-700 rounded-md hover:bg-gray-200">
                Close
            </button>
        </div>
    </div>
</div>

<script>
    function showPaymentHistory(linkId) {
        // This would make an AJAX call to get payment history
        document.getElementById('paymentHistoryModal').classList.remove('hidden');
        // Load payment history via AJAX
        fetch(`/BidderPayment/GetPaymentHistory?linkId=${linkId}`)
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    displayPaymentHistory(data.history);
                }
            });
    }

    function closePaymentHistory() {
        document.getElementById('paymentHistoryModal').classList.add('hidden');
    }

    function displayPaymentHistory(history) {
        let html = '<div class="space-y-4">';
        history.forEach(item => {
            html += `
                    <div class="border-l-4 ${item.status === 'Success' ? 'border-green-500' : 'border-red-500'} pl-4">
                        <div class="flex justify-between">
                            <div>
                                <p class="font-medium">${item.status}</p>
                                <p class="text-sm text-gray-600">${item.transactionDate}</p>
                                <p class="text-sm text-gray-600">Amount: ₹${item.amount}</p>
                            </div>
                            <div class="text-right">
                                <p class="text-sm">${item.paymentMethod || 'N/A'}</p>
                                ${item.errorDescription ? `<p class="text-xs text-red-600">${item.errorDescription}</p>` : ''}
                            </div>
                        </div>
                    </div>
                `;
        });
        html += '</div>';
        document.getElementById('paymentHistoryContent').innerHTML = html;
    }

    async function refreshRefundStatus(bidId) {
        try {
            const response = await fetch(`/BidderPayment/RefundStatusDetailed?bidId=${bidId}`);
            const data = await response.json();

            if (data.success) {
                // Show detailed refund status
                showRefundDetails(data);
            } else {
                alert(data.message);
            }
        } catch (error) {
            alert('Error checking refund status');
        }
    }

    function showRefundDetails(data) {
        let html = `
                <div class="space-y-4">
                    <div class="bg-gray-50 p-4 rounded-lg">
                        <h4 class="font-medium mb-2">Overall Refund Status</h4>
                        <div class="grid grid-cols-2 gap-4 text-sm">
                            <div>
                                <span class="text-gray-600">Total Paid:</span>
                                <span class="font-medium ml-2">₹${data.totalPaid}</span>
                            </div>
                            <div>
                                <span class="text-gray-600">Total Refunded:</span>
                                <span class="font-medium text-indigo-600 ml-2">₹${data.totalRefunded}</span>
                            </div>
                        </div>
                    </div>

                    <h4 class="font-medium">Component-wise Refund Status</h4>
            `;

        data.refundComponents.forEach(component => {
            html += `
                    <div class="border rounded-lg p-4">
                        <div class="flex justify-between items-start">
                            <div>
                                <p class="font-medium">${component.paymentType}</p>
                                <p class="text-sm text-gray-600">Amount: ₹${component.amount}</p>
                            </div>
                            <span class="px-2 py-1 text-xs rounded-full ${getRefundStatusClass(component.status)}">
                                ${component.status}
                            </span>
                        </div>
                        ${component.refundId ? `
                            <div class="mt-2 text-sm text-gray-600">
                                <p>Refund ID: ${component.refundId}</p>
                                <p>Date: ${component.refundDate}</p>
                            </div>
                        ` : ''}
                    </div>
                `;
        });

        html += '</div>';
        document.getElementById('refundDetailsContent').innerHTML = html;
        document.getElementById('refundDetailsModal').classList.remove('hidden');
    }

    function closeRefundDetails() {
        document.getElementById('refundDetailsModal').classList.add('hidden');
    }

    function getRefundStatusClass(status) {
        switch (status) {
            case 'Completed': return 'bg-green-100 text-green-800';
            case 'Processing': return 'bg-blue-100 text-blue-800';
            case 'Initiated': return 'bg-yellow-100 text-yellow-800';
            case 'Failed': return 'bg-red-100 text-red-800';
            default: return 'bg-gray-100 text-gray-800';
        }
    }

    function viewRefundReceipt(refundId) {
        window.open(`/BidderPayment/RefundReceipt?refundId=${refundId}`, '_blank');
    }

    // Auto-refresh refund status for rejected bids
    document.addEventListener('DOMContentLoaded', function () {
        const rejectedBids = document.querySelectorAll('[data-bid-status="Rejected"]');
        if (rejectedBids.length > 0) {
            // Auto-refresh every 30 seconds for rejected bids
            setInterval(() => {
                rejectedBids.forEach(bid => {
                    const bidId = bid.dataset.bidId;
                    if (bidId) {
                        checkRefundStatusSilently(bidId);
                    }
                });
            }, 30000);
        }
    });

    async function checkRefundStatusSilently(bidId) {
        try {
            const response = await fetch(`/BidderPayment/RefundStatus?bidId=${bidId}`);
            const data = await response.json();

            if (data.success && data.hasUpdate) {
                // Refresh the page if there's an update
                location.reload();
            }
        } catch (error) {
            console.error('Error checking refund status:', error);
        }
    }
</script>