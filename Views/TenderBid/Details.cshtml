@model BiddingSystem.ViewModels.TenderBidViewModel
@{
    ViewData["Title"] = "Tender Bid Details";
}

<div class="bg-white rounded shadow">
    <div class="px-6 py-4 border-b border-gray-200">
        <div class="flex items-center justify-between">
            <h2 class="text-lg font-medium text-gray-900">Tender Bid Details</h2>
            <div class="flex items-center space-x-3">
                <a asp-action="Index" class="text-gray-500 hover:text-gray-700">
                    <i class="ri-arrow-left-line mr-1"></i>Back to List
                </a>
                @if (User.IsInRole("Admin") || User.IsInRole("Maker"))
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="inline-flex items-center px-3 py-2 border border-transparent text-sm leading-4 font-medium rounded-md text-white bg-primary hover:bg-primary/90">
                        <i class="ri-edit-line mr-1"></i>Edit
                    </a>
                }
            </div>
        </div>
    </div>

    <div class="p-6">
        <!-- Refund Alert Banner - Show if refund exists -->
        @if (Model.HasRefund && Model.RefundInfo != null)
        {
            <div class="mb-6">
                @if (Model.RefundInfo.IsProcessedSuccessfully)
                {
                    <div class="bg-green-50 border border-green-200 rounded-lg p-4">
                        <div class="flex">
                            <div class="flex-shrink-0">
                                <svg class="h-5 w-5 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                                </svg>
                            </div>
                            <div class="ml-3">
                                <h3 class="text-sm font-medium text-green-800">Refund Processed Successfully</h3>
                                <p class="mt-1 text-sm text-green-700">Amount of ₹@Model.RefundInfo.RefundAmount.ToString("N2") has been refunded via Razorpay.</p>
                                @if (!string.IsNullOrEmpty(Model.RefundInfo.RazorpayRefundId))
                                {
                                    <p class="mt-1 text-xs text-green-600">Refund ID: @Model.RefundInfo.RazorpayRefundId</p>
                                }
                            </div>
                        </div>
                    </div>
                }
                else if (Model.RefundInfo.RefundStatus == "Pending")
                {
                    <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4">
                        <div class="flex">
                            <div class="flex-shrink-0">
                                <svg class="h-5 w-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                                </svg>
                            </div>
                            <div class="ml-3">
                                <h3 class="text-sm font-medium text-yellow-800">Refund Pending Approval</h3>
                                <p class="mt-1 text-sm text-yellow-700">A refund of ₹@Model.RefundInfo.RefundAmount.ToString("N2") is pending approval.</p>
                            </div>
                        </div>
                    </div>
                }
                else if (Model.RefundInfo.RefundStatus == "Failed")
                {
                    <div class="bg-red-50 border border-red-200 rounded-lg p-4">
                        <div class="flex">
                            <div class="flex-shrink-0">
                                <svg class="h-5 w-5 text-red-400" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                                </svg>
                            </div>
                            <div class="ml-3">
                                <h3 class="text-sm font-medium text-red-800">Refund Failed</h3>
                                <p class="mt-1 text-sm text-red-700">The refund processing failed.</p>
                                @if (!string.IsNullOrEmpty(Model.RefundInfo.RefundErrorMessage))
                                {
                                    <p class="mt-1 text-xs text-red-600">Error: @Model.RefundInfo.RefundErrorMessage</p>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Main Information -->
            <div class="lg:col-span-2 space-y-6">
                <!-- Bidder Information -->
                <div class="bg-gray-50 rounded-lg p-4">
                    <h3 class="text-lg font-medium text-gray-900 mb-4 flex items-center">
                        <i class="ri-user-line mr-2"></i>Bidder Information
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-500">Bidder Name</label>
                            <p class="mt-1 text-sm text-gray-900">@Model.BidderName</p>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-500">Email</label>
                            <p class="mt-1 text-sm text-gray-900">
                                <a href="mailto:@Model.BidderEmail" class="text-primary hover:text-primary/80">@Model.BidderEmail</a>
                            </p>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-500">Phone</label>
                            <p class="mt-1 text-sm text-gray-900">
                                <a href="tel:@Model.BidderPhone" class="text-primary hover:text-primary/80">@Model.BidderPhone</a>
                            </p>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-500">Company</label>
                            <p class="mt-1 text-sm text-gray-900">@Model.CompanyName</p>
                        </div>
                        <div class="md:col-span-2">
                            <label class="block text-sm font-medium text-gray-500">Company Address</label>
                            <p class="mt-1 text-sm text-gray-900">@Model.CompanyAddress</p>
                        </div>
                    </div>
                </div>

                <!-- Financial Information -->
                <div class="bg-gray-50 rounded-lg p-4">
                    <h3 class="text-lg font-medium text-gray-900 mb-4 flex items-center">
                        <i class="ri-money-dollar-circle-line mr-2"></i>Financial Information
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-500">Bid Amount</label>
                            <p class="mt-1 text-lg font-semibold text-gray-900">₹@Model.BidAmount.ToString("N2")</p>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-500">EMD Amount</label>
                            <p class="mt-1 text-lg font-semibold text-gray-900">₹@Model.EmdAmount.ToString("N2")</p>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-500">Processing Fee</label>
                            <p class="mt-1 text-lg font-semibold text-gray-900">₹@Model.ProcessingFee.ToString("N2")</p>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-500">Total Amount</label>
                            <p class="mt-1 text-xl font-bold text-primary">₹@Model.TotalAmount.ToString("N2")</p>
                        </div>
                    </div>
                </div>

                <!-- Refund Information - Show if refund exists -->
                @if (Model.HasRefund && Model.RefundInfo != null)
                {
                    <div class="bg-purple-50 rounded-lg p-4 border border-purple-200">
                        <h3 class="text-lg font-medium text-gray-900 mb-4 flex items-center">
                            <i class="ri-refund-line mr-2"></i>Refund Information
                        </h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-medium text-gray-500">Refund Amount</label>
                                <p class="mt-1 text-lg font-semibold text-purple-900">₹@Model.RefundInfo.RefundAmount.ToString("N2")</p>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-500">Refund Status</label>
                                <p class="mt-1">
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium @Model.RefundInfo.RefundStatusBadgeClass">
                                        @Model.RefundInfo.RefundStatus
                                    </span>
                                </p>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.RefundInfo.RazorpayRefundId))
                            {
                                <div class="md:col-span-2">
                                    <label class="block text-sm font-medium text-gray-500">Razorpay Refund ID</label>
                                    <p class="mt-1 text-sm font-mono bg-white p-2 rounded border border-purple-200">@Model.RefundInfo.RazorpayRefundId</p>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(Model.RefundInfo.ReasonForRefund))
                            {
                                <div class="md:col-span-2">
                                    <label class="block text-sm font-medium text-gray-500">Reason for Refund</label>
                                    <p class="mt-1 text-sm text-gray-900">@Model.RefundInfo.ReasonForRefund</p>
                                </div>
                            }
                            @if (Model.RefundInfo.InitiatedAt.HasValue)
                            {
                                <div>
                                    <label class="block text-sm font-medium text-gray-500">Initiated At</label>
                                    <p class="mt-1 text-sm text-gray-900">@Model.RefundInfo.InitiatedAt.Value.ToString("dd MMM yyyy HH:mm")</p>
                                    @if (!string.IsNullOrEmpty(Model.RefundInfo.InitiatedByName))
                                    {
                                        <p class="text-xs text-gray-500">by @Model.RefundInfo.InitiatedByName</p>
                                    }
                                </div>
                            }
                            @if (Model.RefundInfo.ApprovedAt.HasValue)
                            {
                                <div>
                                    <label class="block text-sm font-medium text-gray-500">Processed At</label>
                                    <p class="mt-1 text-sm text-gray-900">@Model.RefundInfo.ApprovedAt.Value.ToString("dd MMM yyyy HH:mm")</p>
                                    @if (!string.IsNullOrEmpty(Model.RefundInfo.ApprovedByName))
                                    {
                                        <p class="text-xs text-gray-500">by @Model.RefundInfo.ApprovedByName</p>
                                    }
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(Model.RefundInfo.CheckerRemarks))
                            {
                                <div class="md:col-span-2">
                                    <label class="block text-sm font-medium text-gray-500">Checker Remarks</label>
                                    <p class="mt-1 text-sm text-gray-900 bg-white p-2 rounded border border-purple-200">@Model.RefundInfo.CheckerRemarks</p>
                                </div>
                            }
                        </div>

                        <!-- Link to refund details -->
                        <div class="mt-4 pt-4 border-t border-purple-200">
                            <a href="/Refund/Details/@Model.RefundInfo.RefundPaymentId"
                               class="inline-flex items-center text-purple-700 hover:text-purple-900 text-sm font-medium">
                                <i class="ri-external-link-line mr-1"></i>
                                View Full Refund Details
                            </a>
                        </div>
                    </div>
                }

                <!-- Documents section remains the same -->
                @if (Model.Documents.Any())
                {
                    <div class="bg-gray-50 rounded-lg p-4">
                        <h3 class="text-lg font-medium text-gray-900 mb-4 flex items-center">
                            <i class="ri-file-list-line mr-2"></i>Bid Documents
                        </h3>
                        <!-- Document list code remains the same -->
                    </div>
                }
            </div>

            <!-- Sidebar -->
            <div class="space-y-6">
                <!-- Status Cards -->
                <div class="bg-white border border-gray-200 rounded-lg p-4">
                    <h3 class="text-lg font-medium text-gray-900 mb-4">Status</h3>
                    <div class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-500 mb-2">Bid Status</label>
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium @Model.StatusBadgeClass">
                                @Model.Status
                            </span>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-500 mb-2">Payment Status</label>
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium @Model.PaymentStatusBadgeClass">
                                @Model.PaymentStatus
                            </span>
                            @if (Model.PaymentStatus == "Refunded" && Model.RefundInfo?.IsProcessedSuccessfully == true)
                            {
                                <p class="text-xs text-gray-500 mt-1">via Razorpay</p>
                            }
                        </div>
                    </div>
                </div>

                <!-- Payment Information -->
                <div class="bg-white border border-gray-200 rounded-lg p-4">
                    <h3 class="text-lg font-medium text-gray-900 mb-4">Payment Information</h3>
                    <div class="space-y-3">
                        @if (!string.IsNullOrEmpty(Model.PaymentReference))
                        {
                            <div>
                                <label class="block text-sm font-medium text-gray-500">Payment Reference</label>
                                <p class="mt-1 text-sm text-gray-900 font-mono">@Model.PaymentReference</p>
                            </div>
                        }
                        @if (Model.PaymentDate.HasValue)
                        {
                            <div>
                                <label class="block text-sm font-medium text-gray-500">Payment Date</label>
                                <p class="mt-1 text-sm text-gray-900">@Model.PaymentDate.Value.ToString("dd MMM yyyy HH:mm")</p>
                            </div>
                        }
                        @if (Model.HasRefund && Model.RefundInfo?.IsProcessedSuccessfully == true)
                        {
                            <div class="pt-3 border-t">
                                <label class="block text-sm font-medium text-purple-700">Refund Processed</label>
                                <p class="mt-1 text-sm text-purple-600">₹@Model.RefundInfo.RefundAmount.ToString("N2")</p>
                                @if (Model.RefundInfo.ApprovedAt.HasValue)
                                {
                                    <p class="text-xs text-purple-500">on @Model.RefundInfo.ApprovedAt.Value.ToString("dd MMM yyyy")</p>
                                }
                            </div>
                        }
                    </div>
                </div>

                <!-- Rest of the sidebar sections remain the same -->
            </div>
        </div>
    </div>
</div>