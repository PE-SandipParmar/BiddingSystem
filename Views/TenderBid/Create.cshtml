@model BiddingSystem.ViewModels.TenderBidCreateViewModel
@{
    ViewData["Title"] = "Create Tender Bid";
}

<div class="bg-white rounded shadow">
    <div class="px-6 py-4 border-b border-gray-200">
        <div class="flex items-center justify-between">
            <h2 class="text-lg font-medium text-gray-900">Create New Tender Bid</h2>
            <a asp-action="Index" class="text-gray-500 hover:text-gray-700">
                <i class="ri-arrow-left-line mr-1"></i>Back to List
            </a>
        </div>
    </div>

    <form asp-action="Create" method="post" class="p-6">
        <div asp-validation-summary="ModelOnly" class="text-red-600 mb-4"></div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Tender Selection -->
            <div class="md:col-span-2">
                <label asp-for="TenderId" class="block text-sm font-medium text-gray-700 mb-2">Tender <span class="text-red-500">*</span></label>
                <select asp-for="TenderId" asp-items="@(new SelectList(Model.AvailableTenders, "Id", "TenderTitle"))" 
                        class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-primary focus:border-primary">
                    <option value="">-- Select Tender --</option>
                </select>
                <span asp-validation-for="TenderId" class="text-red-600 text-sm"></span>
            </div>

            <!-- Bidder Information -->
            <div class="md:col-span-2">
                <h3 class="text-md font-medium text-gray-900 mb-4">Bidder Information</h3>
            </div>

            <div>
                <label asp-for="BidderName" class="block text-sm font-medium text-gray-700 mb-2"> Bidder Name<span class="text-red-500">*</span></label>
                <input asp-for="BidderName" pattern="[A-Za-z\s]+" class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-primary focus:border-primary" />
                <span asp-validation-for="BidderName" class="text-red-600 text-sm"></span>
            </div>

            <div>
                <label asp-for="BidderEmail" class="block text-sm font-medium text-gray-700 mb-2">Bidder Email <span class="text-red-500">*</span></label>
                <input asp-for="BidderEmail" type="email" class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-primary focus:border-primary" />
                <span asp-validation-for="BidderEmail" class="text-red-600 text-sm"></span>
            </div>

            <div>
                <label asp-for="BidderPhone" class="block text-sm font-medium text-gray-700 mb-2">Bidder Phone <span class="text-red-500">*</span></label>
                <input asp-for="BidderPhone" type="tel" pattern="[0-9]{10}" maxlength="10" minlength="10" class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-primary focus:border-primary" />
                <span asp-validation-for="BidderPhone" class="text-red-600 text-sm"></span>
            </div>

            <div>
                <label asp-for="CompanyName" class="block text-sm font-medium text-gray-700 mb-2"> Company Name<span class="text-red-500">*</span></label>
                <input asp-for="CompanyName" pattern="[A-Za-z\s]+" class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-primary focus:border-primary" />
                <span asp-validation-for="CompanyName" class="text-red-600 text-sm"></span>
            </div>

            <div class="md:col-span-2">
                <label asp-for="CompanyAddress" class="block text-sm font-medium text-gray-700 mb-2"> Company Address<span class="text-red-500">*</span></label>
                <textarea asp-for="CompanyAddress" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-primary focus:border-primary"></textarea>
                <span asp-validation-for="CompanyAddress" class="text-red-600 text-sm"></span>
            </div>

            <!-- Financial Information -->
            <div class="md:col-span-2">
                <h3 class="text-md font-medium text-gray-900 mb-4">Financial Information</h3>
            </div>

            <div>
                <label asp-for="BidAmount" class="block text-sm font-medium text-gray-700 mb-2"> Bid Amount<span class="text-red-500">*</span></label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <span class="text-gray-500 sm:text-sm">₹</span>
                    </div>
                    <input asp-for="BidAmount" type="number" step="0.01" min="0" 
                           class="w-full pl-8 pr-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-primary focus:border-primary" />
                </div>
                <span asp-validation-for="BidAmount" class="text-red-600 text-sm"></span>
            </div>

            <div>
                <label asp-for="EmdAmount" class="block text-sm font-medium text-gray-700 mb-2"> Emd Amount<span class="text-red-500">*</span></label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <span class="text-gray-500 sm:text-sm">₹</span>
                    </div>
                    <input asp-for="EmdAmount" type="number" step="0.01" min="0" 
                           class="w-full pl-8 pr-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-primary focus:border-primary" />
                </div>
                <span asp-validation-for="EmdAmount" class="text-red-600 text-sm"></span>
            </div>

            <div>
                <label asp-for="ProcessingFee" class="block text-sm font-medium text-gray-700 mb-2"> Processing Fee<span class="text-red-500">*</span></label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <span class="text-gray-500 sm:text-sm">₹</span>
                    </div>
                    <input asp-for="ProcessingFee" type="number" step="0.01" min="0" 
                           class="w-full pl-8 pr-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-primary focus:border-primary" />
                </div>
                <span asp-validation-for="ProcessingFee" class="text-red-600 text-sm"></span>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Total Amount</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <span class="text-gray-500 sm:text-sm">₹</span>
                    </div>
                    <input type="text" id="totalAmount" readonly 
                           class="w-full pl-8 pr-3 py-2 border border-gray-300 rounded-md shadow-sm bg-gray-50 text-gray-500" />
                </div>
                <p class="text-sm text-gray-500 mt-1">Calculated automatically</p>
            </div>

            <!-- Remarks -->
            <div class="md:col-span-2">
                <label asp-for="Remarks" class="block text-sm font-medium text-gray-700 mb-2"></label>
                <textarea asp-for="Remarks" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-primary focus:border-primary" 
                          placeholder="Any additional remarks or notes..."></textarea>
                <span asp-validation-for="Remarks" class="text-red-600 text-sm"></span>
            </div>
        </div>

        <div class="flex items-center justify-end space-x-3 mt-6 pt-6 border-t border-gray-200">
            <a asp-action="Index" class="px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary">
                Cancel
            </a>
            <button type="submit" class="px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-primary hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary">
                <i class="ri-save-line mr-2"></i>Create Bid
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // Auto-calculate total amount
        function calculateTotal() {
            const bidAmount = parseFloat(document.getElementById('BidAmount').value) || 0;
            const emdAmount = parseFloat(document.getElementById('EmdAmount').value) || 0;
            const processingFee = parseFloat(document.getElementById('ProcessingFee').value) || 0;
            const total = bidAmount + emdAmount + processingFee;
            document.getElementById('totalAmount').value = total.toFixed(2);
        }

        // Validation functions
        function validateAlphabetsOnly(input) {
            // Remove any non-alphabet characters (except spaces)
            input.value = input.value.replace(/[^A-Za-z\s]/g, '');
        }

        function validatePhoneNumber(input) {
            // Remove any non-numeric characters and limit to 10 digits
            input.value = input.value.replace(/[^0-9]/g, '').substring(0, 10);
        }

        function showError(fieldId, message) {
            const field = document.getElementById(fieldId);
            const existingError = field.parentNode.querySelector('.validation-error');

            // Remove existing error if any
            if (existingError) {
                existingError.remove();
            }

            // Add new error message
            const errorSpan = document.createElement('span');
            errorSpan.className = 'text-red-600 text-sm validation-error';
            errorSpan.textContent = message;
            field.parentNode.appendChild(errorSpan);

            // Add error styling to field
            field.classList.add('border-red-500');
        }

        function clearError(fieldId) {
            const field = document.getElementById(fieldId);
            const existingError = field.parentNode.querySelector('.validation-error');

            if (existingError) {
                existingError.remove();
            }

            // Remove error styling
            field.classList.remove('border-red-500');
        }

        function validateBidderName() {
            const field = document.getElementById('BidderName');
            const value = field.value.trim();

            if (value === '') {
                showError('BidderName', 'Bidder name is required.');
                return false;
            } else if (!/^[A-Za-z\s]+$/.test(value)) {
                showError('BidderName', 'Bidder name should contain only alphabets and spaces.');
                return false;
            } else {
                clearError('BidderName');
                return true;
            }
        }

        function validateBidderPhone() {
            const field = document.getElementById('BidderPhone');
            const value = field.value.trim();

            if (value === '') {
                showError('BidderPhone', 'Phone number is required.');
                return false;
            } else if (!/^\d{10}$/.test(value)) {
                showError('BidderPhone', 'Phone number must be exactly 10 digits.');
                return false;
            } else {
                clearError('BidderPhone');
                return true;
            }
        }

        function validateCompanyName() {
            const field = document.getElementById('CompanyName');
            const value = field.value.trim();

            if (value === '') {
                showError('CompanyName', 'Company name is required.');
                return false;
            } else if (!/^[A-Za-z\s]+$/.test(value)) {
                showError('CompanyName', 'Company name should contain only alphabets and spaces.');
                return false;
            } else {
                clearError('CompanyName');
                return true;
            }
        }

        // Form submission validation
        function validateForm() {
            let isValid = true;

            isValid = validateBidderName() && isValid;
            isValid = validateBidderPhone() && isValid;
            isValid = validateCompanyName() && isValid;

            return isValid;
        }

        // Add event listeners when DOM is loaded
        document.addEventListener('DOMContentLoaded', function () {
            // Auto-calculation event listeners
            document.getElementById('BidAmount').addEventListener('input', calculateTotal);
            document.getElementById('EmdAmount').addEventListener('input', calculateTotal);
            document.getElementById('ProcessingFee').addEventListener('input', calculateTotal);

            // Real-time validation event listeners
            document.getElementById('BidderName').addEventListener('input', function () {
                validateAlphabetsOnly(this);
            });

            document.getElementById('BidderName').addEventListener('blur', validateBidderName);

            document.getElementById('BidderPhone').addEventListener('input', function () {
                validatePhoneNumber(this);
            });

            document.getElementById('BidderPhone').addEventListener('blur', validateBidderPhone);

            document.getElementById('CompanyName').addEventListener('input', function () {
                validateAlphabetsOnly(this);
            });

            document.getElementById('CompanyName').addEventListener('blur', validateCompanyName);

            // Form submission validation
            document.querySelector('form').addEventListener('submit', function (e) {
                if (!validateForm()) {
                    e.preventDefault(); // Prevent form submission
                    alert('Please fix the validation errors before submitting.');
                }
            });

            // Calculate total on page load
            calculateTotal();
        });
    </script>
}

