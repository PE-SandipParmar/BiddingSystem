@model BiddingSystem.ViewModels.TenderBidListViewModel
@{
    ViewData["Title"] = "Tender Bid Management";
}

<!-- Action Bar -->
<div class="bg-white rounded shadow mb-6">
    <div class="p-4">
        <form asp-action="Index" method="get" class="flex flex-row items-center gap-4">
            <h2 class="text-lg font-semibold text-gray-800 whitespace-nowrap">All Tender Bids</h2>
            
            <div class="flex-1 flex items-center gap-4">
                <input type="text" name="searchTerm" value="@Model.SearchTerm" placeholder="Search by bidder, company, or tender..." 
                       class="px-4 py-2 border border-gray-300 rounded bg-white text-gray-500 text-base outline-none flex-1 max-w-md">
                
                <select name="status" class="px-4 py-2 border border-gray-300 rounded bg-white text-gray-500 text-base outline-none" style="min-width: 120px;">
                    <option value="">All Status</option>
                    @foreach (var status in Model.StatusOptions)
                    {
                        @if (Model.Status == status)
                        {
                            <option value="@status" selected>@status</option>
                        }
                        else
                        {
                            <option value="@status">@status</option>
                        }
                    }
                </select>
                
                <select name="paymentStatus" class="px-4 py-2 border border-gray-300 rounded bg-white text-gray-500 text-base outline-none" style="min-width: 120px;">
                    <option value="">All Payment Status</option>
                    @foreach (var paymentStatus in Model.PaymentStatusOptions)
                    {
                        @if (Model.PaymentStatus == paymentStatus)
                        {
                            <option value="@paymentStatus" selected>@paymentStatus</option>
                        }
                        else
                        {
                            <option value="@paymentStatus">@paymentStatus</option>
                        }
                    }
                </select>
                
                <select name="pageSize" class="px-4 py-2 border border-gray-300 rounded bg-white text-gray-500 text-base outline-none" style="min-width: 80px;">
                    @if (Model.PageSize == 25)
                    {
                        <option value="25" selected>25</option>
                    }
                    else
                    {
                        <option value="25">25</option>
                    }
                    @if (Model.PageSize == 50)
                    {
                        <option value="50" selected>50</option>
                    }
                    else
                    {
                        <option value="50">50</option>
                    }
                    @if (Model.PageSize == 100)
                    {
                        <option value="100" selected>100</option>
                    }
                    else
                    {
                        <option value="100">100</option>
                    }
                </select>
                
                <button type="submit" class="px-4 py-2 bg-primary text-white rounded hover:bg-primary/90 transition-colors">
                    <i class="ri-search-line mr-2"></i>Search
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Success/Error Messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
        <div class="flex">
            <div class="flex-shrink-0">
                <i class="ri-check-line text-green-400"></i>
            </div>
            <div class="ml-3">
                <p class="text-sm">@TempData["SuccessMessage"]</p>
            </div>
        </div>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
        <div class="flex">
            <div class="flex-shrink-0">
                <i class="ri-error-warning-line text-red-400"></i>
            </div>
            <div class="ml-3">
                <p class="text-sm">@TempData["ErrorMessage"]</p>
            </div>
        </div>
    </div>
}

<!-- Data Table -->
<div class="bg-white rounded shadow overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-200">
        <div class="flex items-center justify-between">
            <h3 class="text-lg font-medium text-gray-900">Tender Bids</h3>
            <div class="flex items-center space-x-3">
                <span class="text-sm text-gray-500">Total: @Model.TotalCount bids</span>
                @if (User.IsInRole("Admin") || User.IsInRole("Maker"))
                {
                    <a asp-action="Create" class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-primary hover:bg-primary/90">
                        <i class="ri-add-line mr-2"></i>
                        New Bid
                    </a>
                }
            </div>
        </div>
    </div>

    @if (Model.Bids.Any())
    {
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Bidder</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Company</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tender</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Bid Amount</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Total Amount</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Payment</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Submitted</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    @foreach (var bid in Model.Bids)
                    {
                        <tr class="hover:bg-gray-50">
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm font-medium text-gray-900">@bid.BidderName</div>
                                <div class="text-sm text-gray-500">@bid.BidderEmail</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm text-gray-900">@bid.CompanyName</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm text-gray-900">@bid.TenderName</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm font-medium text-gray-900">₹@bid.BidAmount.ToString("N2")</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm font-medium text-gray-900">₹@bid.TotalAmount.ToString("N2")</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                @{
                                    var statusClass = bid.Status switch
                                    {
                                        "Submitted" => "bg-blue-100 text-blue-800",
                                        "Under Review" => "bg-yellow-100 text-yellow-800",
                                        "Accepted" => "bg-green-100 text-green-800",
                                        "Rejected" => "bg-red-100 text-red-800",
                                        "Withdrawn" => "bg-gray-100 text-gray-800",
                                        _ => "bg-gray-100 text-gray-800"
                                    };
                                }
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @statusClass">
                                    @bid.Status
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                @{
                                    var paymentStatusClass = bid.PaymentStatus switch
                                    {
                                        "Pending" => "bg-yellow-100 text-yellow-800",
                                        "Paid" => "bg-green-100 text-green-800",
                                        "Failed" => "bg-red-100 text-red-800",
                                        "Refunded" => "bg-gray-100 text-gray-800",
                                        _ => "bg-gray-100 text-gray-800"
                                    };
                                }
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @paymentStatusClass">
                                    @bid.PaymentStatus
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                @bid.SubmittedAt.ToString("dd MMM yyyy")
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                <div class="flex items-center space-x-2">
                                    <a asp-action="Details" asp-route-id="@bid.Id" class="text-primary hover:text-primary/80">
                                        <i class="ri-eye-line"></i>
                                    </a>
                                    @if (User.IsInRole("Admin") || User.IsInRole("Maker"))
                                    {
                                        @if (bid.TenderStatus == "Published")
                                        {
                                            <a asp-action="Edit" asp-route-id="@bid.Id" class="text-blue-600 hover:text-blue-800" title="Edit Bid">
                                                <i class="ri-edit-line"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@bid.Id" class="text-red-600 hover:text-red-800" title="Delete Bid">
                                                <i class="ri-delete-bin-line"></i>
                                            </a>
                                        }
                                        else
                                        {
                                          @*   <span class="text-gray-400 cursor-not-allowed" title="Bid can only be edited when tender status is Published">
                                                <i class="ri-edit-line"></i>
                                            </span> *@
                                        }
                                      
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <div class="bg-white px-4 py-3 flex items-center justify-between border-t border-gray-200 sm:px-6">
                <div class="flex-1 flex justify-between sm:hidden">
                    @if (Model.CurrentPage > 1)
                    {
                        <a href="?page=@(Model.CurrentPage - 1)&pageSize=@Model.PageSize&searchTerm=@Model.SearchTerm&status=@Model.Status&paymentStatus=@Model.PaymentStatus" 
                           class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
                            Previous
                        </a>
                    }
                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <a href="?page=@(Model.CurrentPage + 1)&pageSize=@Model.PageSize&searchTerm=@Model.SearchTerm&status=@Model.Status&paymentStatus=@Model.PaymentStatus" 
                           class="ml-3 relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
                            Next
                        </a>
                    }
                </div>
                <div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between">
                    <div>
                        <p class="text-sm text-gray-700">
                            Showing
                            <span class="font-medium">@((Model.CurrentPage - 1) * Model.PageSize + 1)</span>
                            to
                            <span class="font-medium">@Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount)</span>
                            of
                            <span class="font-medium">@Model.TotalCount</span>
                            results
                        </p>
                    </div>
                    <div>
                        <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination">
                            @if (Model.CurrentPage > 1)
                            {
                                <a href="?page=@(Model.CurrentPage - 1)&pageSize=@Model.PageSize&searchTerm=@Model.SearchTerm&status=@Model.Status&paymentStatus=@Model.PaymentStatus" 
                                   class="relative inline-flex items-center px-2 py-2 rounded-l-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50">
                                    <i class="ri-arrow-left-s-line"></i>
                                </a>
                            }
                            
                            @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                            {
                                @if (i == Model.CurrentPage)
                                {
                                    <span class="relative inline-flex items-center px-4 py-2 border border-gray-300 bg-primary text-sm font-medium text-white">
                                        @i
                                    </span>
                                }
                                else
                                {
                                    <a href="?page=@i&pageSize=@Model.PageSize&searchTerm=@Model.SearchTerm&status=@Model.Status&paymentStatus=@Model.PaymentStatus" 
                                       class="relative inline-flex items-center px-4 py-2 border border-gray-300 bg-white text-sm font-medium text-gray-700 hover:bg-gray-50">
                                        @i
                                    </a>
                                }
                            }
                            
                            @if (Model.CurrentPage < Model.TotalPages)
                            {
                                <a href="?page=@(Model.CurrentPage + 1)&pageSize=@Model.PageSize&searchTerm=@Model.SearchTerm&status=@Model.Status&paymentStatus=@Model.PaymentStatus" 
                                   class="relative inline-flex items-center px-2 py-2 rounded-r-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50">
                                    <i class="ri-arrow-right-s-line"></i>
                                </a>
                            }
                        </nav>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="text-center py-12">
            <i class="ri-auction-line text-6xl text-gray-300 mb-4"></i>
            <h3 class="text-lg font-medium text-gray-900 mb-2">No tender bids found</h3>
            <p class="text-gray-500 mb-6">Get started by creating a new tender bid.</p>
            @if (User.IsInRole("Admin") || User.IsInRole("Maker"))
            {
                <a asp-action="Create" class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-primary hover:bg-primary/90">
                    <i class="ri-add-line mr-2"></i>
                    Create New Bid
                </a>
            }
        </div>
    }
</div>
