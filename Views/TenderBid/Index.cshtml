@model BiddingSystem.ViewModels.TenderBidListViewModel
@{
    ViewData["Title"] = "Tender Bid Management";
}

<!-- Header Section -->
<div class="mb-6">
    <div class="flex justify-between items-center">
        <div>
            <h1 class="text-2xl font-bold text-gray-800">
                @if (Model.SelectedTenderId.HasValue && !string.IsNullOrEmpty(Model.SelectedTenderName))
                {
                    <span>Bids for: @Model.SelectedTenderName</span>
                }
                else
                {
                    <span>All Tender Bids</span>
                }
            </h1>
            <p class="text-gray-600 mt-1">Manage and track all tender bids</p>
        </div>
    </div>
</div>

<!-- Filter Section -->
<div class="bg-white rounded-lg shadow-sm border border-gray-200 mb-6">
    <div class="p-6">
        <form asp-action="Index" method="get">
            <!-- First Row: Main Filters -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-4">
                <!-- Tender Dropdown -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Select Tender</label>
                    <select name="tenderId" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary bg-white">
                        <option value="">All Tenders</option>
                        @foreach (var tender in Model.AvailableTenders)
                        {
                            @if (Model.SelectedTenderId == tender.Id)
                            {
                                <option value="@tender.Id" selected>@tender.TenderTitle</option>
                            }
                            else
                            {
                                <option value="@tender.Id">@tender.TenderTitle</option>
                            }
                        }
                    </select>
                </div>

                <!-- Search Input -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Search</label>
                    <input type="text" name="searchTerm" value="@Model.SearchTerm"
                           placeholder="Search by bidder, company..."
                           class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary">
                </div>

                <!-- Status Filter -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Bid Status</label>
                    <select name="status" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary bg-white">
                        <option value="">All Status</option>
                        @foreach (var status in Model.StatusOptions)
                        {
                            @if (Model.Status == status)
                            {
                                <option value="@status" selected>@status</option>
                            }
                            else
                            {
                                <option value="@status">@status</option>
                            }
                        }
                    </select>
                </div>

                <!-- Payment Status Filter -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Payment Status</label>
                    <select name="paymentStatus" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary bg-white">
                        <option value="">All Payment Status</option>
                        @foreach (var paymentStatus in Model.PaymentStatusOptions)
                        {
                            @if (Model.PaymentStatus == paymentStatus)
                            {
                                <option value="@paymentStatus" selected>@paymentStatus</option>
                            }
                            else
                            {
                                <option value="@paymentStatus">@paymentStatus</option>
                            }
                        }
                    </select>
                </div>
            </div>

            <!-- Second Row: Page Size and Actions -->
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                <div class="flex items-center gap-2">
                    <label class="text-sm font-medium text-gray-700">Show</label>
                    <select name="pageSize" class="px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary bg-white">
                        @if (Model.PageSize == 25)
                        {
                            <option value="25" selected>25</option>
                        }
                        else
                        {
                            <option value="25">25</option>
                        }
                        @if (Model.PageSize == 50)
                        {
                            <option value="50" selected>50</option>
                        }
                        else
                        {
                            <option value="50">50</option>
                        }
                        @if (Model.PageSize == 100)
                        {
                            <option value="100" selected>100</option>
                        }
                        else
                        {
                            <option value="100">100</option>
                        }
                    </select>
                    <span class="text-sm text-gray-700">entries</span>
                </div>

                <div class="flex gap-2">
                    <button type="submit" class="px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary/90 transition-colors flex items-center">
                        <i class="ri-search-line mr-2"></i>
                        Search
                    </button>

                    @if (Model.SelectedTenderId.HasValue || !string.IsNullOrEmpty(Model.SearchTerm) || !string.IsNullOrEmpty(Model.Status) || !string.IsNullOrEmpty(Model.PaymentStatus))
                    {
                        <a href="@Url.Action("Index", "TenderBid")" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition-colors flex items-center">
                            <i class="ri-close-line mr-2"></i>
                            Clear Filter
                        </a>
                    }
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Success/Error Messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded-lg mb-4">
        <div class="flex">
            <div class="flex-shrink-0">
                <i class="ri-check-circle-fill text-green-500"></i>
            </div>
            <div class="ml-3">
                <p class="text-sm font-medium">@TempData["SuccessMessage"]</p>
            </div>
        </div>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-lg mb-4">
        <div class="flex">
            <div class="flex-shrink-0">
                <i class="ri-error-warning-fill text-red-500"></i>
            </div>
            <div class="ml-3">
                <p class="text-sm font-medium">@TempData["ErrorMessage"]</p>
            </div>
        </div>
    </div>
}

<!-- Data Table -->
<div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
        <div class="flex items-center justify-between">
            <h3 class="text-lg font-semibold text-gray-900">Tender Bids</h3>
            <div class="flex items-center gap-4">
                <span class="text-sm text-gray-600">Total: <span class="font-semibold">@Model.TotalCount</span> bids</span>
                @if (User.IsInRole("Admin") || User.IsInRole("Maker"))
                {
                    <a asp-action="Create" class="inline-flex items-center px-4 py-2 bg-primary text-white text-sm font-medium rounded-lg hover:bg-primary/90 transition-colors">
                        <i class="ri-add-line mr-2"></i>
                        New Bid
                    </a>
                }
            </div>
        </div>
    </div>

    @if (Model.Bids.Any())
    {
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Bidder</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Company</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tender</th>
                        <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Bid Amount</th>
                        <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Total Amount</th>
                        <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                        <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Payment</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Submitted</th>
                        <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    @foreach (var bid in Model.Bids)
                    {
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div>
                                    <div class="text-sm font-medium text-gray-900">@bid.BidderName</div>
                                    <div class="text-sm text-gray-500">@bid.BidderEmail</div>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm text-gray-900">@bid.CompanyName</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm text-gray-900">@bid.TenderName</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-right">
                                <div class="text-sm font-semibold text-gray-900">₹@bid.BidAmount.ToString("N0")</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-right">
                                <div class="text-sm font-semibold text-gray-900">₹@bid.TotalAmount.ToString("N0")</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-center">
                                @{
                                    var statusClass = bid.Status switch
                                    {
                                        "Submitted" => "bg-blue-100 text-blue-800",
                                        "Under Review" => "bg-yellow-100 text-yellow-800",
                                        "Accepted" => "bg-green-100 text-green-800",
                                        "Rejected" => "bg-red-100 text-red-800",
                                        "Withdrawn" => "bg-gray-100 text-gray-800",
                                        _ => "bg-gray-100 text-gray-800"
                                    };
                                }
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @statusClass">
                                    @bid.Status
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-center">
                                @{
                                    var paymentStatusClass = bid.PaymentStatus switch
                                    {
                                        "Pending" => "bg-yellow-100 text-yellow-800",
                                        "Paid" => "bg-green-100 text-green-800",
                                        "Failed" => "bg-red-100 text-red-800",
                                        "Refunded" => "bg-purple-100 text-purple-800",
                                        _ => "bg-gray-100 text-gray-800"
                                    };
                                }
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @paymentStatusClass">
                                    @bid.PaymentStatus
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                @bid.SubmittedAt.ToString("dd MMM yyyy")
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-center">
                                <div class="flex items-center justify-center gap-1">
                                    <a asp-action="Details" asp-route-id="@bid.Id"
                                       class="p-1 text-primary hover:text-primary/80 transition-colors"
                                       title="View Details">
                                        <i class="ri-eye-line text-lg"></i>
                                    </a>
                                    @if (User.IsInRole("Admin") || User.IsInRole("Maker"))
                                    {
                                        @if (bid.TenderStatus == "Published")
                                        {
                                            <a asp-action="Edit" asp-route-id="@bid.Id"
                                               class="p-1 text-blue-600 hover:text-blue-800 transition-colors"
                                               title="Edit Bid">
                                                <i class="ri-edit-line text-lg"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@bid.Id"
                                               class="p-1 text-red-600 hover:text-red-800 transition-colors"
                                               title="Delete Bid">
                                                <i class="ri-delete-bin-line text-lg"></i>
                                            </a>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <div class="bg-gray-50 px-4 py-3 flex items-center justify-between border-t border-gray-200 sm:px-6">
                <div class="flex-1 flex justify-between sm:hidden">
                    @if (Model.CurrentPage > 1)
                    {
                        <a href="?tenderId=@Model.SelectedTenderId&page=@(Model.CurrentPage - 1)&pageSize=@Model.PageSize&searchTerm=@Model.SearchTerm&status=@Model.Status&paymentStatus=@Model.PaymentStatus"
                           class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
                            Previous
                        </a>
                    }
                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <a href="?tenderId=@Model.SelectedTenderId&page=@(Model.CurrentPage + 1)&pageSize=@Model.PageSize&searchTerm=@Model.SearchTerm&status=@Model.Status&paymentStatus=@Model.PaymentStatus"
                           class="ml-3 relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
                            Next
                        </a>
                    }
                </div>
                <div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between">
                    <div>
                        <p class="text-sm text-gray-700">
                            Showing
                            <span class="font-medium">@((Model.CurrentPage - 1) * Model.PageSize + 1)</span>
                            to
                            <span class="font-medium">@Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount)</span>
                            of
                            <span class="font-medium">@Model.TotalCount</span>
                            results
                        </p>
                    </div>
                    <div>
                        <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination">
                            @if (Model.CurrentPage > 1)
                            {
                                <a href="?tenderId=@Model.SelectedTenderId&page=@(Model.CurrentPage - 1)&pageSize=@Model.PageSize&searchTerm=@Model.SearchTerm&status=@Model.Status&paymentStatus=@Model.PaymentStatus"
                                   class="relative inline-flex items-center px-2 py-2 rounded-l-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50">
                                    <i class="ri-arrow-left-s-line"></i>
                                </a>
                            }

                            @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                            {
                                @if (i == Model.CurrentPage)
                                {
                                    <span class="relative inline-flex items-center px-4 py-2 border border-primary bg-primary text-sm font-medium text-white z-10">
                                        @i
                                    </span>
                                }
                                else
                                {
                                    <a href="?tenderId=@Model.SelectedTenderId&page=@i&pageSize=@Model.PageSize&searchTerm=@Model.SearchTerm&status=@Model.Status&paymentStatus=@Model.PaymentStatus"
                                       class="relative inline-flex items-center px-4 py-2 border border-gray-300 bg-white text-sm font-medium text-gray-700 hover:bg-gray-50">
                                        @i
                                    </a>
                                }
                            }

                            @if (Model.CurrentPage < Model.TotalPages)
                            {
                                <a href="?tenderId=@Model.SelectedTenderId&page=@(Model.CurrentPage + 1)&pageSize=@Model.PageSize&searchTerm=@Model.SearchTerm&status=@Model.Status&paymentStatus=@Model.PaymentStatus"
                                   class="relative inline-flex items-center px-2 py-2 rounded-r-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50">
                                    <i class="ri-arrow-right-s-line"></i>
                                </a>
                            }
                        </nav>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="text-center py-16">
            <i class="ri-auction-line text-6xl text-gray-300 mb-4"></i>
            <h3 class="text-lg font-medium text-gray-900 mb-2">No tender bids found</h3>
            <p class="text-gray-500 mb-6">
                @if (Model.SelectedTenderId.HasValue)
                {
                    <span>No bids have been submitted for this tender yet.</span>
                }
                else if (!string.IsNullOrEmpty(Model.SearchTerm) || !string.IsNullOrEmpty(Model.Status) || !string.IsNullOrEmpty(Model.PaymentStatus))
                {
                    <span>No bids match your search criteria. Try adjusting your filters.</span>
                }
                else
                {
                    <span>Get started by creating your first tender bid.</span>
                }
            </p>
            @if (User.IsInRole("Admin") || User.IsInRole("Maker"))
            {
                <a asp-action="Create" class="inline-flex items-center px-4 py-2 bg-primary text-white font-medium rounded-lg hover:bg-primary/90 transition-colors">
                    <i class="ri-add-line mr-2"></i>
                    Create New Bid
                </a>
            }
        </div>
    }
</div>