@model BiddingSystem.ViewModels.TenderBidViewModel
@{
    ViewData["Title"] = "Delete Tender Bid";
}

<div class="bg-white rounded shadow">
    <div class="px-6 py-4 border-b border-gray-200">
        <div class="flex items-center justify-between">
            <h2 class="text-lg font-medium text-gray-900">Delete Tender Bid</h2>
            <a asp-action="Index" class="text-gray-500 hover:text-gray-700">
                <i class="ri-arrow-left-line mr-1"></i>Back to List
            </a>
        </div>
    </div>

    <div class="p-6">
        <!-- Warning Message -->
        <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6">
            <div class="flex">
                <div class="flex-shrink-0">
                    <i class="ri-error-warning-line text-red-400 text-xl"></i>
                </div>
                <div class="ml-3">
                    <h3 class="text-sm font-medium text-red-800">Are you sure you want to delete this tender bid?</h3>
                    <div class="mt-2 text-sm text-red-700">
                        <p>This action cannot be undone. The bid will be permanently removed from the system.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bid Information -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Bidder Information -->
            <div class="bg-gray-50 rounded-lg p-4">
                <h3 class="text-lg font-medium text-gray-900 mb-4 flex items-center">
                    <i class="ri-user-line mr-2"></i>Bidder Information
                </h3>
                <div class="space-y-3">
                    <div>
                        <label class="block text-sm font-medium text-gray-500">Bidder Name</label>
                        <p class="mt-1 text-sm text-gray-900">@Model.BidderName</p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-500">Email</label>
                        <p class="mt-1 text-sm text-gray-900">@Model.BidderEmail</p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-500">Phone</label>
                        <p class="mt-1 text-sm text-gray-900">@Model.BidderPhone</p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-500">Company</label>
                        <p class="mt-1 text-sm text-gray-900">@Model.CompanyName</p>
                    </div>
                </div>
            </div>

            <!-- Tender & Financial Information -->
            <div class="space-y-4">
                <!-- Tender Information -->
                <div class="bg-gray-50 rounded-lg p-4">
                    <h3 class="text-lg font-medium text-gray-900 mb-4 flex items-center">
                        <i class="ri-file-list-line mr-2"></i>Tender Information
                    </h3>
                    <div class="space-y-3">
                        <div>
                            <label class="block text-sm font-medium text-gray-500">Tender Title</label>
                            <p class="mt-1 text-sm text-gray-900">@Model.TenderName</p>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-500">Tender ID</label>
                            <p class="mt-1 text-sm text-gray-900">@Model.TenderId</p>
                        </div>
                    </div>
                </div>

                <!-- Financial Information -->
                <div class="bg-gray-50 rounded-lg p-4">
                    <h3 class="text-lg font-medium text-gray-900 mb-4 flex items-center">
                        <i class="ri-money-dollar-circle-line mr-2"></i>Financial Information
                    </h3>
                    <div class="space-y-3">
                        <div>
                            <label class="block text-sm font-medium text-gray-500">Bid Amount</label>
                            <p class="mt-1 text-sm font-semibold text-gray-900">₹@Model.BidAmount.ToString("N2")</p>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-500">EMD Amount</label>
                            <p class="mt-1 text-sm font-semibold text-gray-900">₹@Model.EmdAmount.ToString("N2")</p>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-500">Processing Fee</label>
                            <p class="mt-1 text-sm font-semibold text-gray-900">₹@Model.ProcessingFee.ToString("N2")</p>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-500">Total Amount</label>
                            <p class="mt-1 text-lg font-bold text-primary">₹@Model.TotalAmount.ToString("N2")</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Status Information -->
        <div class="mt-6 bg-gray-50 rounded-lg p-4">
            <h3 class="text-lg font-medium text-gray-900 mb-4 flex items-center">
                <i class="ri-information-line mr-2"></i>Status Information
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-500">Bid Status</label>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium @Model.StatusBadgeClass">
                        @Model.Status
                    </span>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-500">Payment Status</label>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium @Model.PaymentStatusBadgeClass">
                        @Model.PaymentStatus
                    </span>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-500">Submitted At</label>
                    <p class="mt-1 text-sm text-gray-900">@Model.SubmittedAt.ToString("dd MMM yyyy HH:mm")</p>
                </div>
            </div>
        </div>

        <!-- Payment Information -->
        @if (!string.IsNullOrEmpty(Model.PaymentReference) || Model.PaymentDate.HasValue)
        {
            <div class="mt-6 bg-yellow-50 border border-yellow-200 rounded-lg p-4">
                <h3 class="text-lg font-medium text-yellow-800 mb-4 flex items-center">
                    <i class="ri-alert-line mr-2"></i>Payment Information
                </h3>
                <div class="space-y-2">
                    @if (!string.IsNullOrEmpty(Model.PaymentReference))
                    {
                        <p class="text-sm text-yellow-700">
                            <strong>Payment Reference:</strong> @Model.PaymentReference
                        </p>
                    }
                    @if (Model.PaymentDate.HasValue)
                    {
                        <p class="text-sm text-yellow-700">
                            <strong>Payment Date:</strong> @Model.PaymentDate.Value.ToString("dd MMM yyyy HH:mm")
                        </p>
                    }
                    @if (Model.PaymentStatus == "Paid")
                    {
                        <p class="text-sm text-yellow-700 font-medium">
                            ⚠️ This bid has been paid. Deleting it may require refund processing.
                        </p>
                    }
                </div>
            </div>
        }

        <!-- Remarks -->
        @if (!string.IsNullOrEmpty(Model.Remarks))
        {
            <div class="mt-6 bg-gray-50 rounded-lg p-4">
                <h3 class="text-lg font-medium text-gray-900 mb-4 flex items-center">
                    <i class="ri-message-3-line mr-2"></i>Remarks
                </h3>
                <p class="text-sm text-gray-900">@Model.Remarks</p>
            </div>
        }

        <!-- Action Buttons -->
        <div class="flex items-center justify-end space-x-3 mt-8 pt-6 border-t border-gray-200">
            <a asp-action="Index" class="px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary">
                Cancel
            </a>
            <form asp-action="Delete" method="post" class="inline">
                <input asp-for="Id" type="hidden" />
                <button type="submit" class="px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500">
                    <i class="ri-delete-bin-line mr-2"></i>Delete Bid
                </button>
            </form>
        </div>
    </div>
</div>
