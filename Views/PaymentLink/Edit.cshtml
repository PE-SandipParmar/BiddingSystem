@model BiddingSystem.ViewModels.PaymentLinkViewModel
@{
    ViewData["Title"] = "Edit Payment Link";
}

<div class="flex justify-between items-center mb-6">
    <div>
        <h1 class="text-2xl font-bold text-gray-800">Edit Payment Link</h1>
        <p class="text-gray-600 mt-1">Update payment link information</p>
    </div>
    <a asp-action="Details" asp-route-id="@Model.Id" class="bg-gray-500 text-white px-4 py-2 rounded-lg hover:bg-gray-600 transition-colors flex items-center">
        <i class="ri-arrow-left-line mr-2"></i>
        Back to Details
    </a>
</div>

<form asp-action="Edit" method="post" class="space-y-8">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="LinkId" />
    <input type="hidden" asp-for="Status" />
    
    <div class="bg-white rounded-lg shadow p-8">
        <div class="flex items-center mb-8">
            <div class="w-12 h-12 flex items-center justify-center rounded-full bg-blue-100 text-primary mr-5">
                <i class="ri-edit-line text-xl"></i>
            </div>
            <div>
                <h2 class="text-xl font-semibold text-gray-800">Payment Link Details</h2>
                <p class="text-sm text-gray-500 mt-1">Update the payment link information</p>
            </div>
        </div>
        
        <div asp-validation-summary="ModelOnly" class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-6" role="alert"></div>
        
        <!-- Read-only Information -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Link ID</label>
                <p class="text-sm text-gray-900 font-mono bg-gray-50 px-3 py-2 rounded">@Model.LinkId</p>
            </div>
            
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Tender</label>
                <p class="text-sm text-gray-900 bg-gray-50 px-3 py-2 rounded">@Model.TenderTitle</p>
            </div>
        </div>
        
        <!-- Editable Fields -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div>
                <label asp-for="Amount" class="block text-sm font-medium text-gray-700 mb-2">
                    Amount <span class="text-red-500">*</span>
                </label>
                <div class="relative">
                    <span class="absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-500">₹</span>
                    <input asp-for="Amount" type="number" step="0.01" min="0.01" 
                           placeholder="0.00" 
                           class="w-full pl-8 pr-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-base">
                </div>
                <span asp-validation-for="Amount" class="text-red-500 text-sm"></span>
            </div>
            
            <div>
                <label asp-for="PaymentType" class="block text-sm font-medium text-gray-700 mb-2">
                    Payment Type <span class="text-red-500">*</span>
                </label>
                <select asp-for="PaymentType" asp-items="@ViewBag.PaymentTypeOptions" 
                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-base">
                    <option value="">Select payment type</option>
                </select>
                <span asp-validation-for="PaymentType" class="text-red-500 text-sm"></span>
            </div>
            
            <div>
                <label asp-for="ExpiryDate" class="block text-sm font-medium text-gray-700 mb-2">
                    Expiry Date <span class="text-red-500">*</span>
                </label>
                <input asp-for="ExpiryDate" type="date" 
                       class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-base">
                <span asp-validation-for="ExpiryDate" class="text-red-500 text-sm"></span>
            </div>
            
            <div class="md:col-span-2">
                <label asp-for="Notes" class="block text-sm font-medium text-gray-700 mb-2">
                    Notes
                </label>
                <textarea asp-for="Notes" rows="3" 
                          placeholder="Enter any additional notes (optional)" 
                          class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-base"></textarea>
                <span asp-validation-for="Notes" class="text-red-500 text-sm"></span>
            </div>
        </div>
        
        <div class="flex justify-end gap-4 mt-8">
            <a asp-action="Details" asp-route-id="@Model.Id" class="px-6 py-3 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors">
                Cancel
            </a>
            <button type="submit" class="px-6 py-3 bg-primary text-white rounded-lg hover:bg-primary/90 transition-colors">
                <i class="ri-save-line mr-2"></i>Update Payment Link
            </button>
        </div>
    </div>
</form>

<!-- Information Footer -->
<div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mt-6">
    <div class="flex items-start">
        <div class="w-5 h-5 flex items-center justify-center rounded-full bg-blue-100 text-blue-600 mr-3 mt-0.5">
            <i class="ri-information-line text-sm"></i>
        </div>
        <div>
            <h4 class="text-sm font-medium text-blue-800 mb-1">Important Information</h4>
            <ul class="text-sm text-blue-700 space-y-1">
                <li>• All fields marked with <span class="text-red-500">*</span> are required</li>
                <li>• Link ID and Tender cannot be changed after creation</li>
                <li>• Expiry date must be in the future</li>
                <li>• Changes will be reflected immediately for active links</li>
                <li>• Only active, non-expired links can be edited</li>
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Set minimum date for expiry date
        document.addEventListener('DOMContentLoaded', function() {
            const expiryDateInput = document.getElementById('ExpiryDate');
            const today = new Date();
            const tomorrow = new Date(today);
            tomorrow.setDate(tomorrow.getDate() + 1);
            expiryDateInput.min = tomorrow.toISOString().split('T')[0];
        });
        
        // Form validation
        document.querySelector('form').addEventListener('submit', function(e) {
            const expiryDate = new Date(document.getElementById('ExpiryDate').value);
            const today = new Date();
            
            if (expiryDate <= today) {
                e.preventDefault();
                alert('Expiry date must be in the future.');
                return false;
            }
        });
    </script>
}
