@model BiddingSystem.ViewModels.PaymentLinkDetailsViewModel
@{
    ViewData["Title"] = "Payment Link Details";
}

<div class="flex justify-between items-center mb-6">
    <div>
        <h1 class="text-2xl font-bold text-gray-800">Payment Link Details</h1>
        <p class="text-gray-600 mt-1">View and manage payment link information</p>
    </div>
    <a asp-action="Index" class="bg-gray-500 text-white px-4 py-2 rounded-lg hover:bg-gray-600 transition-colors flex items-center">
        <i class="ri-arrow-left-line mr-2"></i>
        Back to List
    </a>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Main Details -->
    <div class="lg:col-span-2 space-y-6">
        <!-- Basic Information -->
        <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center mb-6">
                <div class="w-12 h-12 flex items-center justify-center rounded-full bg-blue-100 text-primary mr-4">
                    <i class="ri-link-m text-xl"></i>
                </div>
                <div>
                    <h2 class="text-xl font-semibold text-gray-800">Basic Information</h2>
                    <p class="text-sm text-gray-500">Payment link details and status</p>
                </div>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Link ID</label>
                    <p class="text-sm text-gray-900 font-mono bg-gray-50 px-3 py-2 rounded">@Model.LinkId</p>
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Status</label>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium @Model.StatusBadgeClass">
                        @Model.StatusDisplayName
                    </span>
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Amount</label>
                    <p class="text-lg font-semibold text-gray-900">@Model.AmountDisplay</p>
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Payment Type</label>
                    <p class="text-sm text-gray-900">@Model.PaymentType.GetDisplayName()</p>
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Created Date</label>
                    <p class="text-sm text-gray-900">@Model.CreatedDate.ToString("dd MMM yyyy HH:mm")</p>
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Expiry Date</label>
                    <p class="text-sm text-gray-900 @(Model.IsExpired ? "text-red-600" : "")">@Model.ExpiryDate.ToString("dd MMM yyyy HH:mm")</p>
                </div>
            </div>
        </div>

        <!-- Tender Information -->
        <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center mb-6">
                <div class="w-12 h-12 flex items-center justify-center rounded-full bg-green-100 text-green-600 mr-4">
                    <i class="ri-file-list-line text-xl"></i>
                </div>
                <div>
                    <h2 class="text-xl font-semibold text-gray-800">Tender Information</h2>
                    <p class="text-sm text-gray-500">Associated tender details</p>
                </div>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Tender ID</label>
                    <p class="text-sm text-gray-900 font-mono bg-gray-50 px-3 py-2 rounded">@Model.TenderId</p>
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Tender Title</label>
                    <p class="text-sm text-gray-900">@Model.TenderTitle</p>
                </div>
            </div>
        </div>

        <!-- Payment URL -->
        <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center mb-6">
                <div class="w-12 h-12 flex items-center justify-center rounded-full bg-purple-100 text-purple-600 mr-4">
                    <i class="ri-links-line text-xl"></i>
                </div>
                <div>
                    <h2 class="text-xl font-semibold text-gray-800">Payment URL</h2>
                    <p class="text-sm text-gray-500">Share this link with bidders for payment</p>
                </div>
            </div>
            
            <div class="flex items-center space-x-2">
                <input type="text" value="@Model.PaymentUrl" readonly 
                       class="flex-1 px-3 py-2 border border-gray-300 rounded-lg bg-gray-50 text-sm font-mono">
                <button onclick="copyPaymentUrl()" class="px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary/90 transition-colors">
                    <i class="ri-copy-line mr-2"></i>Copy
                </button>
            </div>
        </div>

        <!-- Notes -->
        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <div class="bg-white rounded-lg shadow p-6">
                <div class="flex items-center mb-6">
                    <div class="w-12 h-12 flex items-center justify-center rounded-full bg-yellow-100 text-yellow-600 mr-4">
                        <i class="ri-sticky-note-line text-xl"></i>
                    </div>
                    <div>
                        <h2 class="text-xl font-semibold text-gray-800">Notes</h2>
                        <p class="text-sm text-gray-500">Additional information</p>
                    </div>
                </div>
                
                <p class="text-sm text-gray-900 bg-gray-50 px-4 py-3 rounded-lg">@Model.Notes</p>
            </div>
        }
    </div>

    <!-- Sidebar -->
    <div class="space-y-6">
        <!-- Actions -->
        <div class="bg-white rounded-lg shadow p-6">
            <h3 class="text-lg font-semibold text-gray-800 mb-4">Actions</h3>
            <div class="space-y-3">
                <button onclick="copyPaymentUrl()" class="w-full flex items-center justify-center px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary/90 transition-colors">
                    <i class="ri-copy-line mr-2"></i>Copy Payment URL
                </button>
                
                @if (Model.Status == PaymentLinkStatus.Active && !Model.IsExpired)
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="w-full flex items-center justify-center px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition-colors">
                        <i class="ri-edit-line mr-2"></i>Edit Link
                    </a>
                    
                    <button onclick="cancelPaymentLink()" class="w-full flex items-center justify-center px-4 py-2 bg-red-500 text-white rounded-lg hover:bg-red-600 transition-colors">
                        <i class="ri-close-line mr-2"></i>Cancel Link
                    </button>
                }
                
                @if (User.IsInRole("Admin"))
                {
                    <button onclick="deletePaymentLink()" class="w-full flex items-center justify-center px-4 py-2 bg-gray-500 text-white rounded-lg hover:bg-gray-600 transition-colors">
                        <i class="ri-delete-bin-line mr-2"></i>Delete Link
                    </button>
                }
            </div>
        </div>

        <!-- Status Information -->
        <div class="bg-white rounded-lg shadow p-6">
            <h3 class="text-lg font-semibold text-gray-800 mb-4">Status Information</h3>
            <div class="space-y-4">
                <div class="flex items-center justify-between">
                    <span class="text-sm text-gray-600">Current Status</span>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @Model.StatusBadgeClass">
                        @Model.StatusDisplayName
                    </span>
                </div>
                
                <div class="flex items-center justify-between">
                    <span class="text-sm text-gray-600">Is Usable</span>
                    <span class="text-sm font-medium @(Model.IsUsable ? "text-green-600" : "text-red-600")">
                        @(Model.IsUsable ? "Yes" : "No")
                    </span>
                </div>
                
                <div class="flex items-center justify-between">
                    <span class="text-sm text-gray-600">Is Expired</span>
                    <span class="text-sm font-medium @(Model.IsExpired ? "text-red-600" : "text-green-600")">
                        @(Model.IsExpired ? "Yes" : "No")
                    </span>
                </div>
                
                @if (Model.UsedDate.HasValue)
                {
                    <div class="flex items-center justify-between">
                        <span class="text-sm text-gray-600">Used Date</span>
                        <span class="text-sm text-gray-900">@Model.UsedDate.Value.ToString("dd MMM yyyy HH:mm")</span>
                    </div>
                }
                
                @if (!string.IsNullOrEmpty(Model.TransactionId))
                {
                    <div class="flex items-center justify-between">
                        <span class="text-sm text-gray-600">Transaction ID</span>
                        <span class="text-sm text-gray-900 font-mono">@Model.TransactionId</span>
                    </div>
                }
            </div>
        </div>

        <!-- Quick Stats -->
        <div class="bg-white rounded-lg shadow p-6">
            <h3 class="text-lg font-semibold text-gray-800 mb-4">Quick Stats</h3>
            <div class="space-y-4">
                <div class="flex items-center justify-between">
                    <span class="text-sm text-gray-600">Days Until Expiry</span>
                    <span class="text-sm font-medium @(Model.IsExpired ? "text-red-600" : "text-gray-900")">
                        @(Model.IsExpired ? "Expired" : ((Model.ExpiryDate - DateTime.UtcNow).Days + " days"))
                    </span>
                </div>
                
                <div class="flex items-center justify-between">
                    <span class="text-sm text-gray-600">Created By</span>
                    <span class="text-sm text-gray-900">@Model.CreatedByUserName</span>
                </div>
                
                @if (!string.IsNullOrEmpty(Model.UsedByUserName))
                {
                    <div class="flex items-center justify-between">
                        <span class="text-sm text-gray-600">Used By</span>
                        <span class="text-sm text-gray-900">@Model.UsedByUserName</span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Copy Success Tooltip -->
<div id="copyTooltip" class="fixed z-50 bg-gray-800 text-white px-3 py-2 rounded-lg text-sm opacity-0 transition-opacity duration-300">
    Payment URL copied to clipboard!
</div>

<!-- Cancel Link Modal -->
<div id="cancelModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden">
    <div class="flex items-center justify-center min-h-screen p-4">
        <div class="bg-white rounded-lg shadow-xl max-w-md w-full">
            <div class="p-6">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-lg font-semibold text-gray-800">Cancel Payment Link</h3>
                    <button onclick="closeCancelModal()" class="text-gray-400 hover:text-gray-600">
                        <i class="ri-close-line text-xl"></i>
                    </button>
                </div>
                <form id="cancelForm">
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 mb-2">Cancellation Reason</label>
                        <textarea id="cancelReason" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary" rows="3" placeholder="Enter reason for cancellation"></textarea>
                    </div>
                    <div class="flex items-center justify-end space-x-3">
                        <button type="button" onclick="closeCancelModal()" class="px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors">
                            Cancel
                        </button>
                        <button type="submit" class="px-4 py-2 bg-red-500 text-white rounded-lg hover:bg-red-600 transition-colors">
                            Cancel Link
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Copy payment URL functionality
        async function copyPaymentUrl() {
            const url = '@Model.PaymentUrl';
            try {
                await navigator.clipboard.writeText(url);
                showCopyTooltip();
            } catch (err) {
                console.error('Failed to copy URL:', err);
                // Fallback for older browsers
                const textArea = document.createElement('textarea');
                textArea.value = url;
                document.body.appendChild(textArea);
                textArea.select();
                document.execCommand('copy');
                document.body.removeChild(textArea);
                showCopyTooltip();
            }
        }

        function showCopyTooltip() {
            const tooltip = document.getElementById('copyTooltip');
            tooltip.style.opacity = '1';
            setTimeout(() => {
                tooltip.style.opacity = '0';
            }, 2000);
        }

        // Cancel payment link functionality
        function cancelPaymentLink() {
            document.getElementById('cancelModal').classList.remove('hidden');
        }

        function closeCancelModal() {
            document.getElementById('cancelModal').classList.add('hidden');
            document.getElementById('cancelForm').reset();
        }

        document.getElementById('cancelForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const reason = document.getElementById('cancelReason').value;
            
            try {
                const response = await fetch('@Url.Action("Cancel", new { id = Model.Id })', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: `reason=${encodeURIComponent(reason)}`
                });
                
                if (response.ok) {
                    location.reload();
                } else {
                    alert('Failed to cancel payment link');
                }
            } catch (error) {
                console.error('Error:', error);
                alert('An error occurred while cancelling the payment link');
            }
        });

        // Delete payment link functionality
        function deletePaymentLink() {
            if (confirm('Are you sure you want to delete this payment link? This action cannot be undone.')) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '@Url.Action("Delete", new { id = Model.Id })';
                
                const token = document.createElement('input');
                token.type = 'hidden';
                token.name = '__RequestVerificationToken';
                token.value = document.querySelector('input[name="__RequestVerificationToken"]').value;
                
                form.appendChild(token);
                document.body.appendChild(form);
                form.submit();
            }
        }
    </script>
}
