@model BiddingSystem.ViewModels.PaymentLinkViewModel
@{
    ViewData["Title"] = "Generate Payment Link";
}

<div class="flex justify-between items-center mb-6">
    <div>
        <h1 class="text-2xl font-bold text-gray-800">Generate Payment Link</h1>
        <p class="text-gray-600 mt-1">Create a new payment link for tender submissions</p>
    </div>
    <a asp-action="Index" class="bg-gray-500 text-white px-4 py-2 rounded-lg hover:bg-gray-600 transition-colors flex items-center">
        <i class="ri-arrow-left-line mr-2"></i>
        Back to List
    </a>
</div>

<form asp-action="Create" method="post" class="space-y-8">
    <div class="bg-white rounded-lg shadow p-8">
        <div class="flex items-center mb-8">
            <div class="w-12 h-12 flex items-center justify-center rounded-full bg-blue-100 text-primary mr-5">
                <i class="ri-link-m text-xl"></i>
            </div>
            <div>
                <h2 class="text-xl font-semibold text-gray-800">Payment Link Details</h2>
                <p class="text-sm text-gray-500 mt-1">Enter the details for the payment link</p>
            </div>
        </div>
        
        <div asp-validation-summary="ModelOnly" class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-6" role="alert"></div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div>
                <label asp-for="TenderId" class="block text-sm font-medium text-gray-700 mb-2">
                    Tender <span class="text-red-500">*</span>
                </label>
                <select asp-for="TenderId" asp-items="@ViewBag.TenderOptions" 
                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-base"
                        id="tenderSelect">
                    <option value="">Select a tender</option>
                </select>
                <span asp-validation-for="TenderId" class="text-red-500 text-sm"></span>
            </div>
            
            <div>
                <label asp-for="TenderBidId" class="block text-sm font-medium text-gray-700 mb-2">
                    Tender Bid <span class="text-red-500">*</span>
                </label>
                <select asp-for="TenderBidId" asp-items="@ViewBag.TenderBidOptions"
                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-base"
                        id="tenderBidSelect" disabled required>
                    <option value="">Select a tender bid</option>
                </select>
                <span asp-validation-for="TenderBidId" class="text-red-500 text-sm"></span>
                <p class="text-xs text-gray-500 mt-1">Required: Select a bid to generate payment link</p>

            </div>
            
            <div>
                <label asp-for="PaymentType" class="block text-sm font-medium text-gray-700 mb-2">
                    Payment Type <span class="text-red-500">*</span>
                </label>
                <select asp-for="PaymentType" asp-items="@ViewBag.PaymentTypeOptions" 
                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-base">
                    <option value="">Select payment type</option>
                </select>
                <span asp-validation-for="PaymentType" class="text-red-500 text-sm"></span>
            </div>
            
            <div>
                <label asp-for="Amount" class="block text-sm font-medium text-gray-700 mb-2">
                    Amount <span class="text-red-500">*</span>
                </label>
                <div class="relative">
                    <span class="absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-500">₹</span>
                    <input asp-for="Amount" type="number" step="0.01" min="0.01" 
                           placeholder="0.00" 
                           class="w-full pl-8 pr-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-base"
                           id="Amount">
                </div>
                <span asp-validation-for="Amount" class="text-red-500 text-sm"></span>
            </div>
            
            <div>
                <label asp-for="ExpiryDate" class="block text-sm font-medium text-gray-700 mb-2">
                    Expiry Date <span class="text-red-500">*</span>
                </label>
                <input asp-for="ExpiryDate" type="date" 
                       class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-base">
                <span asp-validation-for="ExpiryDate" class="text-red-500 text-sm"></span>
            </div>
            
            <div class="md:col-span-2">
                <label asp-for="Notes" class="block text-sm font-medium text-gray-700 mb-2">
                    Notes
                </label>
                <textarea asp-for="Notes" rows="3" 
                          placeholder="Enter any additional notes (optional)" 
                          class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-base"></textarea>
                <span asp-validation-for="Notes" class="text-red-500 text-sm"></span>
            </div>
        </div>
        
        <div class="flex justify-end gap-4 mt-8">
            <a asp-action="Index" class="px-6 py-3 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors">
                Cancel
            </a>
            <button type="submit" class="px-6 py-3 bg-primary text-white rounded-lg hover:bg-primary/90 transition-colors">
                <i class="ri-link-m mr-2"></i>Generate Payment Link
            </button>
        </div>
    </div>
</form>

<!-- Information Footer -->
<div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mt-6">
    <div class="flex items-start">
        <div class="w-5 h-5 flex items-center justify-center rounded-full bg-blue-100 text-blue-600 mr-3 mt-0.5">
            <i class="ri-information-line text-sm"></i>
        </div>
        <div>
            <h4 class="text-sm font-medium text-blue-800 mb-1">Important Information</h4>
            <ul class="text-sm text-blue-700 space-y-1">
                <li>• All fields marked with <span class="text-red-500">*</span> are required</li>
                <li>• Payment links are generated with secure tokens for security</li>
                <li>• Expiry date must be in the future</li>
                <li>• Once generated, the link can be shared with bidders</li>
                <li>• Links automatically expire after the specified date</li>
                <li>• You can edit or cancel active links before they expire</li>
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <script>
        // Set minimum date for expiry date
        document.addEventListener('DOMContentLoaded', function () {
            const expiryDateInput = document.getElementById('ExpiryDate');
            const today = new Date();
            const tomorrow = new Date(today);
            tomorrow.setDate(tomorrow.getDate() + 1);
            expiryDateInput.min = tomorrow.toISOString().split('T')[0];

            // Set default expiry date to 30 days from now
            const defaultExpiry = new Date(today);
            defaultExpiry.setDate(defaultExpiry.getDate() + 30);
            expiryDateInput.value = defaultExpiry.toISOString().split('T')[0];
        });

        // Store tender bids for amount auto-fill
        let tenderBids = [];

        // Handle tender selection change
        document.getElementById('tenderSelect').addEventListener('change', function () {
            const tenderId = this.value;
            const tenderBidSelect = document.getElementById('tenderBidSelect');
            const amountInput = document.getElementById('Amount');

            if (tenderId) {
                // Enable the tender bid dropdown
                tenderBidSelect.disabled = false;
                tenderBidSelect.innerHTML = '<option value="">Loading bids...</option>';

                // Fetch tender bids
                fetch(`/PaymentLink/GetTenderBids?tenderId=${tenderId}`)
                    .then(response => response.json())
                    .then(data => {
                        tenderBids = data; // Store bids for amount auto-fill
                        tenderBidSelect.innerHTML = '<option value="">Select a bid (optional)</option>';
                        data.forEach(bid => {
                            const option = document.createElement('option');
                            option.value = bid.id;
                            option.textContent = `${bid.bidderName} - ${bid.companyName}`;
                            tenderBidSelect.appendChild(option);
                        });
                    })
                    .catch(error => {
                        console.error('Error loading tender bids:', error);
                        tenderBidSelect.innerHTML = '<option value="">Error loading bids</option>';
                        tenderBids = [];
                    });
            } else {
                // Disable and reset the tender bid dropdown
                tenderBidSelect.disabled = true;
                tenderBidSelect.innerHTML = '<option value="">Select a tender first</option>';
                tenderBids = [];
                // Clear amount when tender is deselected
                amountInput.value = '';
            }
        });

        // Handle tender bid selection change
        document.getElementById('tenderBidSelect').addEventListener('change', function () {
            updateAmountBasedOnSelections();
        });

        // Handle payment type change
        document.getElementById('PaymentType').addEventListener('change', function () {
            console.log('Payment type changed to:', this.value);
            updateAmountBasedOnSelections();
        });

        // Main function to update amount based on both tender bid and payment type
        function updateAmountBasedOnSelections() {
            const tenderBidId = document.getElementById('tenderBidSelect').value;
            const paymentType = document.getElementById('PaymentType').value;
            const amountInput = document.getElementById('Amount');

            console.log('updateAmountBasedOnSelections - BidId:', tenderBidId, 'PaymentType:', paymentType);

            // If no bid is selected, clear the amount
            if (!tenderBidId || tenderBids.length === 0) {
                console.log('No bid selected, clearing amount');
                amountInput.value = '';
                return;
            }

            // Find the selected bid
            const selectedBid = tenderBids.find(bid => bid.id == tenderBidId);
            if (!selectedBid || selectedBid.bidAmount <= 0) {
                console.log('No valid bid found or bid amount is 0');
                amountInput.value = '';
                return;
            }

            // Calculate amount based on payment type
            let calculatedAmount = selectedBid.bidAmount;

            // Apply payment type-specific calculations
            switch (paymentType.toLowerCase()) {
                case 'earnest_money_deposit':
                case '1':
                    calculatedAmount = selectedBid.emdAmount
                    break;
                case '2':
                    calculatedAmount = selectedBid.bidAmount
                    break;
                case '3':
                    calculatedAmount = selectedBid.processingFee;
                    break;
                default:
                    calculatedAmount = '0';
                    break;
            }

            console.log('Calculated amount:', calculatedAmount, 'for payment type:', paymentType);

            // Set the calculated amount (rounded to 2 decimal places)
            amountInput.value = calculatedAmount.toFixed(2);

            // Trigger change event to validate
            amountInput.dispatchEvent(new Event('change'));
        }

        // Legacy function - keeping for backward compatibility but redirecting to new function
        function updateAmountFromSelectedBid() {
            updateAmountBasedOnSelections();
        }

        // Legacy function - keeping for backward compatibility but redirecting to new function
        function autoFillAmountFromBid() {
            updateAmountBasedOnSelections();
        }

        // Form validation
        document.querySelector('form').addEventListener('submit', function (e) {
            const expiryDate = new Date(document.getElementById('ExpiryDate').value);
            const today = new Date();

            if (expiryDate <= today) {
                e.preventDefault();
                alert('Expiry date must be in the future.');
                return false;
            }
        });
    </script>
